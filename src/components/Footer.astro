---
const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-darker border-t border-brand-gray/80 text-slate-300 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      
      <!-- Col 1: About & Logo -->
      <div class="space-y-4">
        <img 
          src="/assets/endurance-aventure-logo-blanc.png" 
          alt="Endurance Aventure" 
          class="h-10 w-auto object-contain mb-4"
        />
        <p class="text-sm text-slate-400 leading-relaxed">
          Pionnier de l'aventure sportive et de la production audiovisuelle extrême au Québec depuis plus de 20 ans. Créateur d'expéditions inoubliables.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a href="https://www.facebook.com/enduranceaventure" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-brand-gray/80 flex items-center justify-center text-slate-300 hover:text-white hover:bg-brand-red transition-all">
            <span class="sr-only">Facebook</span>
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.youtube.com/@enduranceaventure" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-brand-gray/80 flex items-center justify-center text-slate-300 hover:text-white hover:bg-brand-red transition-all">
            <span class="sr-only">YouTube</span>
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Événements -->
      <div>
        <h4 class="text-sm font-heading font-bold uppercase tracking-wider text-white mb-4 border-l-2 border-brand-red pl-3">
          Événements Sportifs
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/evenements/gbc500" class="hover:text-brand-red transition-colors">GBC 500 (Gravel Bikepacking)</a></li>
          <li><a href="/evenements/trail-des-neiges" class="hover:text-brand-red transition-colors">Trail des Neiges Mont-Orford</a></li>
          <li><a href="/evenements/raids" class="hover:text-brand-red transition-colors">Raid International Gaspésie</a></li>
          <li><a href="/evenements/raids" class="hover:text-brand-red transition-colors">Raid Témiscamingue</a></li>
          <li><a href="/evenements" class="text-brand-cyan hover:text-white transition-colors pt-1 block">Tous les événements →</a></li>
        </ul>
      </div>

      <!-- Col 3: Services B2B -->
      <div>
        <h4 class="text-sm font-heading font-bold uppercase tracking-wider text-white mb-4 border-l-2 border-brand-cyan pl-3">
          Services Corporatifs
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/services/organisation-evenements" class="hover:text-brand-cyan transition-colors">Organisation Clé en Main</a></li>
          <li><a href="/services/production-tele" class="hover:text-brand-cyan transition-colors">Production Télé & Drones</a></li>
          <li><a href="/services" class="hover:text-brand-cyan transition-colors">Chronométrage & Suivi GPS</a></li>
          <li><a href="/entreprise" class="hover:text-brand-cyan transition-colors">L'Équipe & Expérience</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact rapide -->
      <div>
        <h4 class="text-sm font-heading font-bold uppercase tracking-wider text-white mb-4 border-l-2 border-brand-red pl-3">
          Contact & Siège
        </h4>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-red flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span>Magog, Cantons-de-l'Est, Québec, Canada</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href="mailto:info@enduranceaventure.com" class="hover:text-white transition-colors">info@enduranceaventure.com</a>
          </li>
        </ul>
        <div class="mt-5">
          <a href="/contact" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider px-4 py-2 rounded bg-brand-gray text-white hover:bg-brand-red transition-all">
            Formulaire de Contact →
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-brand-gray/60 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <div>
        © {currentYear} Endurance Aventure Inc. Tous droits réservés.
      </div>
      <div class="flex items-center gap-6">
        <span>Site nouvelle génération ultra-sécurisé</span>
        <span>•</span>
        <span>Québec, Canada</span>
      </div>
    </div>
  </div>
</footer>
