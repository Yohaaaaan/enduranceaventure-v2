---
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-slate-950/95 backdrop-blur-md border-b border-slate-800 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-4">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group flex-shrink-0">
        <img 
          src="/assets/endurance-aventure-logo-blanc.png" 
          alt="Endurance Aventure Logo" 
          class="h-10 sm:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
        />
      </a>

      <!-- Desktop Navigation Links (Visible on lg: 1024px+ where full width is guaranteed) -->
      <nav class="hidden lg:flex items-center gap-5 xl:gap-7 flex-shrink-0">
        <a 
          href="/" 
          class={`text-sm font-semibold tracking-wide uppercase transition-colors duration-200 ${currentPath === '/' ? 'text-brand-red' : 'text-slate-200 hover:text-brand-cyan-light'}`}
        >
          Accueil
        </a>

        <!-- Dropdown Événements -->
        <div class="relative group py-2">
          <a 
            href="/evenements/" 
            class={`inline-flex items-center gap-1 text-sm font-semibold tracking-wide uppercase transition-colors duration-200 ${currentPath.startsWith('/evenements') ? 'text-brand-red' : 'text-slate-200 hover:text-brand-cyan-light'}`}
          >
            Événements
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <div class="absolute left-0 mt-2 w-72 rounded-md bg-slate-900 border border-slate-700 shadow-2xl opacity-0 invisible pointer-events-none group-hover:opacity-100 group-hover:visible group-hover:pointer-events-auto transition-all duration-150 transform origin-top-left py-2 z-50">
            <a href="/evenements/gbc500/" class="block px-4 py-2.5 text-sm text-slate-200 hover:bg-brand-red hover:text-white transition-colors group/item">
              <div class="font-bold text-slate-100 flex items-center justify-between">
                <span>GBC 500</span>
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover/item:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </div>
              <div class="text-xs text-slate-400 group-hover/item:text-slate-100">Gravel Bikepacking Challenge</div>
            </a>
            <a href="/evenements/championnat-monde-junior-arws/" class="block px-4 py-2.5 text-sm text-slate-200 hover:bg-brand-red hover:text-white transition-colors group/item">
              <div class="font-bold text-slate-100 flex items-center justify-between">
                <span>Mondiaux Juniors ARWS 2027</span>
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover/item:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </div>
              <div class="text-xs text-slate-400 group-hover/item:text-slate-100">Témiscamingue • Championnat Mondial</div>
            </a>
            <a href="https://raidtemiscamingue.ca/jeunesse/" target="_blank" rel="noopener noreferrer" class="block px-4 py-2.5 text-sm text-slate-200 hover:bg-brand-red hover:text-white transition-colors group/item">
              <div class="font-bold text-slate-100 flex items-center justify-between">
                <span>Raid Jeunesse Desjardins</span>
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover/item:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </div>
              <div class="text-xs text-slate-400 group-hover/item:text-slate-100">Raid Aventure Jeunesse (Site Officiel)</div>
            </a>
            <a href="https://caxtri.com" target="_blank" rel="noopener noreferrer" class="block px-4 py-2.5 text-sm text-slate-200 hover:bg-brand-red hover:text-white transition-colors group/item">
              <div class="font-bold text-slate-100 flex items-center justify-between">
                <span>Canada Man / Woman XTRI</span>
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover/item:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </div>
              <div class="text-xs text-slate-400 group-hover/item:text-slate-100">Triathlon Extrême Lac-Mégantic (Site Officiel)</div>
            </a>
            <div class="border-t border-slate-800 my-1"></div>
            <a href="/evenements/" class="block px-4 py-2 text-xs font-semibold text-brand-cyan hover:text-white uppercase tracking-wider flex items-center justify-between">
              <span>Voir tous les événements</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>
        </div>

        <!-- Dropdown Services Pro -->
        <div class="relative group py-2">
          <a 
            href="/services/organisation-evenements/" 
            class={`inline-flex items-center gap-1 text-sm font-semibold tracking-wide uppercase transition-colors duration-200 ${currentPath.startsWith('/services') ? 'text-brand-red' : 'text-slate-200 hover:text-brand-cyan-light'}`}
          >
            Services Pro
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <div class="absolute left-0 mt-2 w-80 rounded-md bg-slate-900 border border-slate-700 shadow-2xl opacity-0 invisible pointer-events-none group-hover:opacity-100 group-hover:visible group-hover:pointer-events-auto transition-all duration-150 transform origin-top-left py-2 z-50">
            <a href="/services/organisation-evenements/" class="block px-4 py-2.5 text-sm text-slate-200 hover:bg-brand-red hover:text-white transition-colors">
              <div class="font-bold text-slate-100">Organisation Clé en Main</div>
              <div class="text-xs text-slate-400">Défis corporatifs, courses, logistique tout-terrain</div>
            </a>
            <a href="/services/municipalites-tourisme/" class="block px-4 py-2.5 text-sm text-slate-200 hover:bg-brand-red hover:text-white transition-colors">
              <div class="font-bold text-slate-100">Municipalités & Régions</div>
              <div class="text-xs text-slate-400">Rayonnement touristique & grands événements</div>
            </a>
            <a href="/services/entreprises-teambuilding/" class="block px-4 py-2.5 text-sm text-slate-200 hover:bg-brand-red hover:text-white transition-colors">
              <div class="font-bold text-slate-100">Entreprises & Teambuilding</div>
              <div class="text-xs text-slate-400">Défis nature sur mesure & cohésion d'équipe</div>
            </a>
            <a href="/services/production-tele/" class="block px-4 py-2.5 text-sm text-slate-200 hover:bg-brand-cyan hover:text-white transition-colors">
              <div class="font-bold text-slate-100">Production Télé & Vidéo</div>
              <div class="text-xs text-slate-400">Captation extrême, drones 4K, émissions TV</div>
            </a>
          </div>
        </div>

        <a 
          href="/entreprise/" 
          class={`text-sm font-semibold tracking-wide uppercase transition-colors duration-200 ${currentPath.startsWith('/entreprise') ? 'text-brand-red' : 'text-slate-200 hover:text-brand-cyan-light'}`}
        >
          L'Entreprise
        </a>

        <!-- BOUTON ACTUALITÉS DIRECT & CLAYANT -->
        <a 
          href="/nouvelles/" 
          id="nav-link-nouvelles"
          class={`text-sm font-semibold tracking-wide uppercase transition-colors duration-200 relative z-10 cursor-pointer ${currentPath.startsWith('/nouvelles') ? 'text-brand-red font-bold' : 'text-slate-200 hover:text-brand-cyan-light'}`}
        >
          Actualités
        </a>
      </nav>

      <!-- CTA Button Desktop (Visible on lg+) -->
      <div class="hidden lg:flex items-center gap-4 flex-shrink-0">
        <a 
          href="/contact/" 
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-md bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-sm tracking-wider uppercase transition-all duration-200 shadow-sm"
        >
          Contact / Devis
        </a>
      </div>

      <!-- Mobile / Tablet Hamburger button (Visible on screens < 1024px) -->
      <div class="flex lg:hidden items-center gap-3">
        <a 
          href="/contact/" 
          class="inline-flex sm:hidden px-3 py-1.5 rounded-sm bg-brand-red text-white font-heading font-bold text-xs uppercase"
        >
          Contact
        </a>
        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="text-slate-200 hover:text-white p-2 rounded-md border border-slate-800 bg-slate-900 focus:outline-none"
          aria-label="Ouvrir le menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile & Tablet Drawer (Full width, clear touch targets) -->
  <div id="mobile-menu" class="hidden lg:hidden bg-slate-950 border-b border-slate-800 px-6 pt-4 pb-8 space-y-4 shadow-2xl">
    <a href="/" class="block py-2 text-base font-semibold text-slate-100 hover:text-brand-red border-b border-slate-900">Accueil</a>
    
    <div>
      <a href="/evenements/" class="block py-2 text-base font-semibold text-slate-100 hover:text-brand-red">Événements Sportifs</a>
      <div class="pl-4 py-1 space-y-2.5 border-l-2 border-slate-800 ml-1">
        <a href="/evenements/gbc500/" class="block text-sm text-slate-300 hover:text-brand-red flex items-center justify-between">
          <span>GBC 500 (Gravel Bike)</span>
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a href="/evenements/championnat-monde-junior-arws/" class="block text-sm text-slate-300 hover:text-brand-red flex items-center justify-between">
          <span>Mondiaux Juniors ARWS 2027</span>
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a href="https://raidtemiscamingue.ca/jeunesse/" target="_blank" rel="noopener noreferrer" class="block text-sm text-slate-300 hover:text-brand-red flex items-center justify-between">
          <span>Raid Jeunesse Desjardins</span>
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
        <a href="https://caxtri.com" target="_blank" rel="noopener noreferrer" class="block text-sm text-slate-300 hover:text-brand-red flex items-center justify-between">
          <span>Canada Man / Woman XTRI</span>
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>
    </div>

    <div>
      <a href="/services/organisation-evenements/" class="block py-2 text-base font-semibold text-slate-100 hover:text-brand-cyan">Services Pro & B2B</a>
      <div class="pl-4 py-1 space-y-2.5 border-l-2 border-slate-800 ml-1">
        <a href="/services/organisation-evenements/" class="block text-sm text-slate-300 hover:text-brand-red">Organisation Clé en Main</a>
        <a href="/services/municipalites-tourisme/" class="block text-sm text-slate-300 hover:text-brand-red">Municipalités & Régions</a>
        <a href="/services/entreprises-teambuilding/" class="block text-sm text-slate-300 hover:text-brand-red">Entreprises & Teambuilding</a>
        <a href="/services/production-tele/" class="block text-sm text-slate-300 hover:text-brand-cyan">Production Télé & Drones 4K</a>
      </div>
    </div>

    <a href="/entreprise/" class="block py-2 text-base font-semibold text-slate-100 hover:text-brand-red border-b border-slate-900">L'Entreprise & L'Équipe</a>
    
    <!-- Mobile Actualités Link -->
    <a href="/nouvelles/" class="block py-2 text-base font-semibold text-brand-red hover:underline border-b border-slate-900">
      Actualités & Récits
    </a>

    <div class="pt-2">
      <a href="/contact/" class="block text-center w-full py-3.5 rounded-md bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold uppercase tracking-wider text-sm shadow-sm">
        Nous Contacter / Devis
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('hidden');
    });
  }
</script>
