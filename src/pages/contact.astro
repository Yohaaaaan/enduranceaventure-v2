---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contactez-Nous & Soumissions | Endurance Aventure" 
  description="Contactez l'équipe d'Endurance Aventure pour toute demande d'information sur nos événements sportifs ou pour une soumission de services corporatifs."
>
  
  <!-- Banner Sombre -->
  <div class="bg-slate-950 py-16 sm:py-20 border-b border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Formulaire Sécurisé</span>
      <h1 class="text-4xl sm:text-6xl font-heading font-black uppercase tracking-tight text-white mb-4">
        Contactez-Nous
      </h1>
      <p class="max-w-2xl text-base sm:text-lg text-slate-300 font-light leading-relaxed">
        Une question sur un événement ? Une demande de devis pour une organisation sportive ou un tournage ? Notre équipe vous répond sous 24 à 48 heures.
      </p>
    </div>
  </div>

  <!-- Contenu Principal sur Fond Clair -->
  <div class="bg-slate-50 py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        <!-- Contact Info Sidebar -->
        <div class="space-y-8">
          <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6">
            <h3 class="text-xl font-heading font-bold text-slate-900 border-l-2 border-brand-red pl-3">
              Coordonnées Directes
            </h3>
            
            <div class="space-y-4 text-sm text-slate-700">
              <div>
                <div class="text-xs text-slate-500 uppercase font-bold mb-1">Siège social</div>
                <div class="text-slate-900 font-medium">Magog, Cantons-de-l'Est</div>
                <div class="text-slate-500">Québec, Canada</div>
              </div>

              <div>
                <div class="text-xs text-slate-500 uppercase font-bold mb-1">Courriel direct</div>
                <a href="mailto:info@enduranceaventure.com" class="text-brand-cyan hover:underline font-semibold">
                  info@enduranceaventure.com
                </a>
              </div>

              <div>
                <div class="text-xs text-slate-500 uppercase font-bold mb-1">Direction générale</div>
                <div class="font-semibold text-slate-900">Daniel Poirier</div>
                <div class="text-xs text-slate-500">Fondateur & Directeur d'épreuves</div>
              </div>
            </div>
          </div>

          <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-4">
            <h3 class="text-lg font-heading font-bold text-slate-900 border-l-2 border-brand-cyan pl-3">
              Confidentialité
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Vos informations sont strictement confidentielles. Aucun spam, aucun traceur publicitaire intrusif. Ce site utilise un socle statique sécurisé.
            </p>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <div class="bg-white p-8 sm:p-10 rounded-3xl border border-slate-200 shadow-sm relative">
            
            <!-- Success Alert (Hidden by default) -->
            <div id="form-success" class="hidden mb-6 p-4 rounded-xl bg-green-50 border border-green-300 text-green-800 text-sm flex items-start gap-3">
              <svg class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <div>
                <div class="font-bold text-green-900">Merci pour votre message !</div>
                <div>Votre demande a été enregistrée avec succès. Daniel Poirier et l'équipe d'Endurance Aventure reviendront vers vous rapidement.</div>
              </div>
            </div>

            <form id="contact-form" class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                    Nom complet *
                  </label>
                  <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    required 
                    placeholder="Ex: Jean Tremblay"
                    class="w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-brand-red transition-colors text-sm"
                  />
                </div>

                <div>
                  <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                    Adresse courriel *
                  </label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required 
                    placeholder="jean@exemple.com"
                    class="w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-brand-red transition-colors text-sm"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                    Téléphone (optionnel)
                  </label>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    placeholder="(450) 000-0000"
                    class="w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-brand-red transition-colors text-sm"
                  />
                </div>

                <div>
                  <label for="subject" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                    Sujet de votre demande *
                  </label>
                  <select 
                    id="subject" 
                    name="subject" 
                    required
                    class="w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 focus:outline-none focus:border-brand-red transition-colors text-sm"
                  >
                    <option value="">Sélectionnez un motif</option>
                    <option value="gbc500">GBC 500 (Gravel Bikepacking)</option>
                    <option value="trail-des-neiges">Trail des Neiges Mont-Orford</option>
                    <option value="raids">Raids Aventure (Gaspésie / Témiscamingue)</option>
                    <option value="services-b2b">Organisation d'événement corporatif</option>
                    <option value="production-tv">Production télévisuelle & Drones</option>
                    <option value="autre">Autre demande générale</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                  Votre message *
                </label>
                <textarea 
                  id="message" 
                  name="message" 
                  rows="5" 
                  required 
                  placeholder="Décrivez votre projet, vos questions ou le nombre de participants..."
                  class="w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-brand-red transition-colors text-sm"
                ></textarea>
              </div>

              <div class="flex items-center justify-between pt-2">
                <span class="text-xs text-slate-500">* Champs obligatoires</span>
                <button 
                  type="submit" 
                  id="submit-btn"
                  class="px-8 py-3.5 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-sm uppercase tracking-wider transition-all shadow-md shadow-brand-red/20"
                >
                  Envoyer ma Demande
                </button>
              </div>
            </form>

          </div>
        </div>

      </div>
    </div>
  </div>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const successAlert = document.getElementById('form-success');
    const submitBtn = document.getElementById('submit-btn');

    form?.addEventListener('submit', function(e) {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.innerText = 'Envoi en cours...';

      setTimeout(() => {
        form.reset();
        successAlert.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.innerText = 'Envoyer ma Demande';
        successAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 700);
    });
  </script>

</Layout>
