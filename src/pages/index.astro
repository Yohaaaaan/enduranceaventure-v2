---
import Layout from '../layouts/Layout.astro';
import events from '../data/events.json';
import services from '../data/services.json';
import news from '../data/news.json';

const featuredEvents = events.filter(e => e.featured);
const latestNews = news.slice(0, 3);
---

<Layout title="Endurance Aventure | Créateur d'Événements Sportifs & Production Extrême">
  
  <!-- HERO SECTION -->
  <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden bg-brand-darker">
    <!-- Background Image with dynamic overlays -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/assets/2023-08-05_GBC500_mc_1498-scaled.jpg" 
        alt="Gravel Bikepacking Challenge Endurance Aventure" 
        class="w-full h-full object-cover object-center opacity-45 scale-105 transform motion-safe:animate-pulse duration-[10000ms]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-brand-dark/70 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-brand-dark/90 via-transparent to-brand-dark/90"></div>
    </div>

    <!-- Hero Content -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-20">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-red/20 border border-brand-red/40 text-brand-red text-xs sm:text-sm font-bold uppercase tracking-widest mb-6 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-brand-red animate-ping"></span>
        Plus de 20 ans d'expéditions et d'épreuves mythiques
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-heading font-black uppercase tracking-tight text-white leading-none mb-6">
        Dépassez vos limites.<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-red via-red-400 to-brand-cyan">
          Vivez l'Aventure.
        </span>
      </h1>

      <p class="max-w-2xl mx-auto text-lg sm:text-xl text-slate-300 font-light leading-relaxed mb-10">
        Pionnier des défis d'endurance au Québec : du prestigieux <strong class="text-white font-semibold">GBC 500</strong> au <strong class="text-white font-semibold">Trail des Neiges</strong>, nous concevons des aventures immersives et produisons des captations audiovisuelles extrêmes.
      </p>

      <!-- Dual Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
        <a 
          href="#evenements" 
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-base uppercase tracking-wider transition-all duration-300 shadow-xl shadow-brand-red/30 hover:shadow-brand-red/50 hover:-translate-y-1 flex items-center justify-center gap-2"
        >
          Découvrir les Événements
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>

        <a 
          href="/services" 
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-brand-gray/90 hover:bg-brand-gray text-white border border-slate-600/50 hover:border-brand-cyan text-base font-bold uppercase tracking-wider transition-all duration-300 hover:-translate-y-1 flex items-center justify-center gap-2 backdrop-blur-md"
        >
          Services Corporatifs & Vidéo
        </a>
      </div>

      <!-- Stats ribbon -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-16 mt-16 border-t border-slate-750/60 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="text-3xl sm:text-4xl font-heading font-black text-white">20+</div>
          <div class="text-xs uppercase tracking-wider text-slate-400 mt-1">Années d'expertise</div>
        </div>
        <div class="text-center">
          <div class="text-3xl sm:text-4xl font-heading font-black text-brand-red">500 km</div>
          <div class="text-xs uppercase tracking-wider text-slate-400 mt-1">Défi Gravel Mythique</div>
        </div>
        <div class="text-center">
          <div class="text-3xl sm:text-4xl font-heading font-black text-brand-cyan">100%</div>
          <div class="text-xs uppercase tracking-wider text-slate-400 mt-1">Nature & Sauvage</div>
        </div>
        <div class="text-center">
          <div class="text-3xl sm:text-4xl font-heading font-black text-white">4K / Drones</div>
          <div class="text-xs uppercase tracking-wider text-slate-400 mt-1">Production Télé</div>
        </div>
      </div>

    </div>
  </section>


  <!-- SECTION ÉVÉNEMENTS PHARES -->
  <section id="evenements" class="py-24 bg-brand-dark border-t border-brand-gray/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <span class="text-brand-red text-sm font-bold uppercase tracking-widest block mb-2">Grand Public & Athlètes</span>
          <h2 class="text-3xl sm:text-5xl font-heading font-black uppercase tracking-tight text-white">
            Nos Événements Sportifs
          </h2>
        </div>
        <a href="/evenements" class="text-brand-cyan hover:text-brand-cyan-light font-bold text-sm uppercase tracking-wider flex items-center gap-1.5 transition-colors">
          Voir tout le calendrier →
        </a>
      </div>

      <!-- Events Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {featuredEvents.map((evt) => (
          <div class="group rounded-2xl bg-brand-darker border border-brand-gray/80 overflow-hidden flex flex-col transition-all duration-300 hover:border-brand-red/60 hover:shadow-2xl hover:shadow-brand-red/10 hover:-translate-y-1.5">
            <!-- Image Frame -->
            <div class="relative h-64 overflow-hidden">
              <img 
                src={evt.image} 
                alt={evt.title} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-darker via-transparent to-transparent"></div>
              
              <!-- Badge Status -->
              <span class="absolute top-4 left-4 px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-brand-red text-white shadow-md">
                {evt.category}
              </span>
              
              <!-- Badge Date -->
              <span class="absolute bottom-4 left-4 px-3 py-1 rounded-md text-xs font-semibold bg-brand-dark/90 text-slate-200 backdrop-blur-sm border border-slate-700">
                📍 {evt.location}
              </span>
            </div>

            <!-- Content -->
            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <h3 class="text-2xl font-heading font-bold text-white mb-2 group-hover:text-brand-red transition-colors">
                  {evt.title}
                </h3>
                <p class="text-sm text-slate-400 mb-6 line-clamp-3 leading-relaxed">
                  {evt.description}
                </p>

                <!-- Key details list -->
                <ul class="space-y-2 mb-6 text-xs text-slate-300">
                  {evt.highlights.slice(0, 3).map(h => (
                    <li class="flex items-center gap-2">
                      <svg class="w-4 h-4 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Button -->
              <div class="pt-4 border-t border-brand-gray/60 flex items-center justify-between">
                <span class="text-xs text-slate-400 font-semibold">{evt.dates}</span>
                <a 
                  href={`/evenements/${evt.slug === 'raid-gaspesie' ? 'raids' : evt.slug}`} 
                  class="px-4 py-2 rounded-lg bg-brand-gray hover:bg-brand-red text-white text-xs font-heading font-bold uppercase tracking-wider transition-colors"
                >
                  Détails & Inscription
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- SECTION SERVICES CORPORATIFS (B2B) -->
  <section class="py-24 bg-brand-darker relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="max-w-3xl mb-16">
        <span class="text-brand-cyan text-sm font-bold uppercase tracking-widest block mb-2">Expertise B2B & Collectivités</span>
        <h2 class="text-3xl sm:text-5xl font-heading font-black uppercase tracking-tight text-white mb-4">
          Services Événementiels & Production Audiovisuelle
        </h2>
        <p class="text-base sm:text-lg text-slate-400 leading-relaxed">
          Nous mettons notre savoir-faire logistique tout-terrain et nos équipes de tournage au service de vos défis d'entreprise, courses officielles et projets télévisés.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {services.map((srv) => (
          <div class="rounded-2xl bg-brand-dark border border-brand-gray p-8 flex flex-col justify-between transition-all duration-300 hover:border-brand-cyan/60 hover:-translate-y-1">
            <div>
              <div class="w-14 h-14 rounded-xl bg-brand-cyan/10 border border-brand-cyan/30 flex items-center justify-center text-brand-cyan mb-6">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
              </div>

              <h3 class="text-xl font-heading font-bold text-white mb-3">
                {srv.title}
              </h3>
              <p class="text-sm text-slate-400 mb-6 leading-relaxed">
                {srv.description}
              </p>

              <ul class="space-y-2 mb-8 text-xs text-slate-300">
                {srv.features.map((f) => (
                  <li class="flex items-start gap-2">
                    <span class="text-brand-cyan font-bold">•</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a 
              href={`/services/${srv.slug}`} 
              class="w-full py-2.5 rounded-lg border border-brand-cyan text-brand-cyan hover:bg-brand-cyan hover:text-white text-center text-xs font-bold uppercase tracking-wider transition-all"
            >
              En savoir plus →
            </a>
          </div>
        ))}
      </div>

      <!-- Banner CTA Corporate -->
      <div class="mt-16 rounded-2xl bg-gradient-to-r from-brand-gray to-brand-dark border border-slate-700 p-8 sm:p-12 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <h4 class="text-2xl font-heading font-bold text-white mb-2">Un projet d'événement ou un tournage extrême ?</h4>
          <p class="text-sm text-slate-400">Échangez directement avec Daniel Poirier et l'équipe technique pour une étude personnalisée.</p>
        </div>
        <a 
          href="/contact" 
          class="px-8 py-4 rounded-xl bg-brand-cyan hover:bg-brand-cyan-light text-white font-heading font-bold text-sm uppercase tracking-wider transition-all flex-shrink-0 shadow-lg shadow-brand-cyan/20"
        >
          Demander une Soumission
        </a>
      </div>

    </div>
  </section>


  <!-- SECTION DERNIÈRES NOUVELLES -->
  <section class="py-24 bg-brand-dark border-t border-brand-gray/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex items-center justify-between mb-16">
        <div>
          <span class="text-brand-red text-sm font-bold uppercase tracking-widest block mb-2">Blog & Mises à jour</span>
          <h2 class="text-3xl sm:text-4xl font-heading font-black uppercase tracking-tight text-white">
            Actualités & Récits
          </h2>
        </div>
        <a href="/nouvelles" class="text-sm font-bold text-slate-400 hover:text-white uppercase tracking-wider">
          Tous les articles ({news.length}) →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {latestNews.map((n) => (
          <article class="rounded-2xl bg-brand-darker border border-brand-gray/70 overflow-hidden flex flex-col group hover:border-slate-600 transition-colors">
            <div class="relative h-48 overflow-hidden bg-brand-gray">
              <img 
                src={n.image} 
                alt={n.title} 
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                onerror="this.src='/assets/EnduranceAventure.jpg'"
              />
              <span class="absolute top-3 right-3 px-2.5 py-1 rounded bg-black/70 text-[11px] font-semibold text-slate-300 backdrop-blur-sm">
                📅 {n.date}
              </span>
            </div>
            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-heading font-bold text-white mb-2 group-hover:text-brand-red transition-colors line-clamp-2">
                  <a href={`/nouvelles/${n.slug}`}>{n.title}</a>
                </h3>
                <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed mb-4">
                  {n.excerpt}
                </p>
              </div>
              <a href={`/nouvelles/${n.slug}`} class="text-xs font-bold text-brand-red hover:underline uppercase tracking-wider">
                Lire l'article complet →
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

</Layout>
