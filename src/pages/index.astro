---
import Layout from '../layouts/Layout.astro';
import events from '../data/events.json';
import services from '../data/services.json';
import news from '../data/news.json';

const featuredEvents = events.filter(e => e.featured);
const latestNews = news.slice(0, 3);

const serviceVisuals: Record<string, {
  tag: string;
  badgeClass: string;
  iconBg: string;
  borderHover: string;
  btnBorderHover: string;
  bulletColor: string;
  iconSvg: string;
}> = {
  'organisation-evenements': {
    tag: 'Logistique & Sécurité',
    badgeClass: 'bg-red-50 text-brand-red border-red-200/80',
    iconBg: 'bg-red-50 border-red-200 text-brand-red',
    borderHover: 'hover:border-brand-red/50 hover:shadow-red-500/10',
    btnBorderHover: 'hover:border-brand-red hover:bg-brand-red hover:text-white',
    bulletColor: 'text-brand-red',
    iconSvg: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/><circle cx="12" cy="11.5" r="2.2" class="fill-brand-red/20" stroke="currentColor" stroke-width="1.5"/></svg>`
  },
  'production-tele': {
    tag: 'Captation Extrême & 4K',
    badgeClass: 'bg-cyan-50 text-brand-cyan border-cyan-200/80',
    iconBg: 'bg-cyan-50 border-cyan-200 text-brand-cyan',
    borderHover: 'hover:border-brand-cyan/50 hover:shadow-cyan-500/10',
    btnBorderHover: 'hover:border-brand-cyan hover:bg-brand-cyan hover:text-white',
    bulletColor: 'text-brand-cyan',
    iconSvg: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/><circle cx="9" cy="13" r="2.2" class="fill-brand-cyan/20" stroke="currentColor" stroke-width="1.5"/><path stroke-linecap="round" stroke-width="1.8" d="M5 4h7"/></svg>`
  }
};

const sponsors = [
  { name: 'Argon 18', logo: '/assets/logo-argon-18-2.webp' },
  { name: 'XACT Nutrition', logo: '/assets/xactnutrition_Logo_L-blk.webp' },
  { name: 'Näak Nutrition', logo: '/assets/logoNAAK.webp' },
  { name: 'Leki', logo: '/assets/LEKI-Logo.webp' },
  { name: 'Karpos', logo: '/assets/LOGOKARPOS.webp' },
  { name: 'Vaude', logo: '/assets/VAUDE.webp' },
  { name: 'Blizzard', logo: '/assets/Blizzard.webp' },
  { name: 'Sépaq Mont-Orford', logo: '/assets/orford_logo-original_fond_transparent.webp' },
  { name: 'Coast Headlamps', logo: '/assets/logocoast.webp' },
  { name: 'Skimo East', logo: '/assets/Skimoeast.webp' },
  { name: 'Clinique Santé Performance', logo: '/assets/Clinique-sante-performance.webp' },
  { name: 'ARWS Mondial Juniors', logo: '/assets/Logo-Mondiaux-Bilingue-.webp' }
];
---

<Layout title="Endurance Aventure | Événements Plein Air & Production Audiovisuelle Extrême">
  
  <!-- HERO SECTION CINÉMATIQUE SOMBRE (Visuel d'action authentique) -->
  <section class="relative min-h-[88vh] sm:min-h-screen flex flex-col justify-center overflow-hidden bg-slate-950">
    <!-- Image de fond authentique en plein écran avec assombrissement naturel -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/assets/2023-08-05_GBC500_mc_1498-scaled.webp" 
        alt="GBC 500 Gravel Bike Endurance Aventure" 
        class="w-full h-full object-cover object-center opacity-85 brightness-80 contrast-105"
        onerror="this.src='/assets/2023-08-05_GBC500_mc_1498-scaled.jpg'"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-black/25 to-black/35"></div>
    </div>

    <!-- Contenu Principal du Hero -->
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16 flex-grow flex flex-col justify-center text-left">
      
      <!-- Kicker d'autorité -->
      <div class="flex items-center gap-3 text-xs sm:text-sm font-heading font-bold uppercase tracking-widest text-slate-300 mb-4">
        <span class="px-2.5 py-1 bg-brand-red text-white rounded font-bold">Depuis 1998</span>
        <span>Organisation d'Événements Plein Air & Production Télévisuelle</span>
      </div>

      <!-- Titre d'impact sans dégradé arc-en-ciel artificiel -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-heading font-black uppercase tracking-tight text-white leading-tight max-w-4xl mb-6">
        L'aventure sportive <br class="hidden sm:inline" />
        <span class="text-brand-red">grandeur nature.</span>
      </h1>

      <!-- Descriptif ancré dans la réalité québécoise -->
      <p class="max-w-2xl text-base sm:text-xl text-slate-200 font-normal leading-relaxed mb-8">
        Endurance Aventure conçoit et organise des épreuves d'endurance uniques à travers les territoires les plus sauvages du Québec, et réalise des tournages extrêmes pour la télévision et le web.
      </p>

      <!-- Actions directes -->
      <div class="flex flex-wrap items-center gap-4">
        <a 
          href="#evenements" 
          class="px-8 py-4 rounded-lg bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-sm uppercase tracking-wider transition-colors shadow-lg"
        >
          Calendrier des Épreuves 2026/2027
        </a>
        <a 
          href="/services" 
          class="px-8 py-4 rounded-lg bg-slate-900/80 hover:bg-slate-900 text-slate-100 border border-slate-700 hover:border-slate-500 font-heading font-bold text-sm uppercase tracking-wider transition-colors backdrop-blur-sm"
        >
          Services Corporatifs & Tournages
        </a>
      </div>

    </div>
  </section>

  <!-- BANDEAU PARTENAIRES & SPONSORS (Carrousel Infini de Logos avec Formes Dynamiques Athlétiques) -->
  <section class="py-8 bg-slate-900 border-t border-b border-slate-800 overflow-hidden relative">
    <!-- Formes Géométriques Athlétiques Style Ironman (Slashes & Profils d'Élévation) -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
      <!-- Chevrons / Slashes de vitesse en filigrane répété -->
      <svg class="absolute inset-0 w-full h-full opacity-[0.04] text-white" viewBox="0 0 1440 120" preserveAspectRatio="none">
        <pattern id="sponsor-slashes" width="80" height="120" patternUnits="userSpaceOnUse" patternTransform="rotate(25)">
          <line x1="0" y1="0" x2="0" y2="120" stroke="currentColor" stroke-width="1.5" />
          <line x1="25" y1="0" x2="25" y2="120" stroke="currentColor" stroke-width="4" opacity="0.6" />
          <line x1="50" y1="0" x2="50" y2="120" stroke="currentColor" stroke-width="1.5" stroke-dasharray="6 4" />
        </pattern>
        <rect width="100%" height="100%" fill="url(#sponsor-slashes)" />
      </svg>
      <!-- Lignes de crêtes topographiques subtiles rouge et cyan -->
      <svg class="absolute -bottom-1 left-0 right-0 w-full h-10 opacity-20 text-brand-red pointer-events-none" viewBox="0 0 1440 40" fill="none" preserveAspectRatio="none">
        <path d="M0 35 C 320 10, 680 38, 1020 18 C 1240 5, 1380 28, 1440 22" stroke="currentColor" stroke-width="1.5" />
      </svg>
      <svg class="absolute -top-1 left-0 right-0 w-full h-10 opacity-15 text-brand-cyan pointer-events-none" viewBox="0 0 1440 40" fill="none" preserveAspectRatio="none">
        <path d="M0 10 C 280 32, 620 8, 960 25 C 1180 35, 1360 12, 1440 15" stroke="currentColor" stroke-width="1.5" stroke-dasharray="8 6" />
      </svg>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-5 text-center">
      <span class="text-[11px] font-heading font-bold uppercase tracking-widest text-brand-red block mb-1">Partenaires & Équipementiers Officiels</span>
      <p class="text-xs text-slate-400">Ils équipent et soutiennent les athlètes et les épreuves d'Endurance Aventure sur le terrain</p>
    </div>
    
    <!-- Carrousel continu infini (Logos Uniquement) -->
    <div class="relative z-10 w-full overflow-hidden [mask-image:linear-gradient(to_right,transparent,white_10%,white_90%,transparent)]">
      <div class="flex items-center gap-6 w-max animate-infinite-scroll">
        {[...sponsors, ...sponsors].map((s) => (
          <div class="h-16 w-36 sm:w-44 px-4 py-2 rounded-2xl bg-white shadow-sm border border-slate-200/90 flex items-center justify-center flex-shrink-0">
            <img 
              src={s.logo} 
              alt={s.name} 
              class="max-h-10 max-w-[120px] sm:max-w-[140px] w-auto h-auto object-contain filter grayscale hover:grayscale-0 transition-all opacity-85 hover:opacity-100" 
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION ÉVÉNEMENTS PHARES (Fond clair avec relief topographique de terrain) -->
  <section id="evenements" class="py-24 bg-slate-100/70 border-t border-slate-200 relative overflow-hidden">
    <!-- Formes de Relief Topographique Style Carte IGN / Outdoor (Courbes de niveau & Dénivelé) -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
      <svg class="absolute -top-10 left-1/2 -translate-x-1/2 w-[160%] sm:w-full h-[120%] opacity-[0.035] text-slate-900" viewBox="0 0 1440 900" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M-100 120 C 200 40, 450 260, 750 140 C 1050 20, 1300 180, 1600 90" stroke="currentColor" stroke-width="2" />
        <path d="M-100 200 C 220 110, 480 320, 780 210 C 1080 100, 1320 250, 1600 170" stroke="currentColor" stroke-width="1.5" />
        <path d="M-100 280 C 240 180, 510 390, 810 280 C 1110 170, 1340 320, 1600 250" stroke="currentColor" stroke-width="2" stroke-dasharray="12 6" />
        <path d="M-100 360 C 260 250, 540 460, 840 350 C 1140 240, 1360 390, 1600 330" stroke="currentColor" stroke-width="1.5" />
        <path d="M-100 440 C 280 320, 570 530, 870 420 C 1170 310, 1380 460, 1600 410" stroke="currentColor" stroke-width="2" />
        <path d="M-100 520 C 300 390, 600 600, 900 490 C 1200 380, 1400 530, 1600 490" stroke="currentColor" stroke-width="1.5" stroke-dasharray="8 6" />
        <path d="M-100 600 C 320 460, 630 670, 930 560 C 1230 450, 1420 600, 1600 570" stroke="currentColor" stroke-width="2" />
        <path d="M-100 680 C 340 530, 660 740, 960 630 C 1260 520, 1440 670, 1600 650" stroke="currentColor" stroke-width="1.5" />
        <path d="M-100 760 C 360 600, 690 810, 990 700 C 1290 590, 1460 740, 1600 730" stroke="currentColor" stroke-width="2" />
        <!-- Points de repères d'altitude style carte IGN -->
        <text x="320" y="275" font-size="11" font-family="sans-serif" font-weight="bold" fill="currentColor" opacity="0.6">850m</text>
        <text x="820" y="345" font-size="11" font-family="sans-serif" font-weight="bold" fill="currentColor" opacity="0.6">1200m (Mont-Orford)</text>
        <text x="1220" y="195" font-size="11" font-family="sans-serif" font-weight="bold" fill="currentColor" opacity="0.6">620m</text>
      </svg>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Grand Public & Athlètes</span>
          <h2 class="text-3xl sm:text-5xl font-heading font-black uppercase tracking-tight text-slate-900">
            Nos Événements Sportifs
          </h2>
        </div>
        <a href="/evenements" class="text-brand-red hover:text-red-700 font-bold text-sm uppercase tracking-wider flex items-center gap-1.5 transition-colors">
          Voir tout le calendrier →
        </a>
      </div>

      <!-- Events Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {featuredEvents.map((evt) => (
          <div class="group rounded-2xl bg-white border border-slate-200/90 shadow-sm overflow-hidden flex flex-col transition-all duration-300 hover:border-slate-300 hover:shadow-xl hover:-translate-y-1">
            <!-- Image Frame -->
            <div class="relative h-64 overflow-hidden bg-slate-200">
              <img 
                src={evt.image} 
                alt={evt.title} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
              
              <!-- Badge Status -->
              <span class="absolute top-4 left-4 px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-brand-red text-white shadow-md">
                {evt.category}
              </span>

              <!-- Badge Logos Officiels sur capsule blanche -->
              {evt.logo && (
                <div class="absolute top-4 right-4 p-1.5 sm:p-2 rounded-xl bg-white shadow-lg border border-slate-200/90 flex items-center gap-2 z-10">
                  <img 
                    src={evt.logo} 
                    alt={`Logo ${evt.title}`} 
                    class="h-7 sm:h-9 w-auto object-contain max-w-[100px]" 
                  />
                  {evt.secondaryLogo && (
                    <>
                      <div class="h-6 w-px bg-slate-200"></div>
                      <img 
                        src={evt.secondaryLogo} 
                        alt={`Partenaire / Logo secondaire ${evt.title}`} 
                        class="h-6 sm:h-7 w-auto object-contain max-w-[70px]" 
                      />
                    </>
                  )}
                </div>
              )}
              
              <!-- Badge Location -->
              <span class="absolute bottom-4 left-4 px-3 py-1 rounded-md text-xs font-semibold bg-slate-950/80 text-white backdrop-blur-sm">
                📍 {evt.location}
              </span>
            </div>

            <!-- Content -->
            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <h3 class="text-2xl font-heading font-bold text-slate-900 mb-2 group-hover:text-brand-red transition-colors">
                  {evt.title}
                </h3>
                <p class="text-sm text-slate-600 mb-6 line-clamp-3 leading-relaxed">
                  {evt.description}
                </p>

                <!-- Key details list -->
                <ul class="space-y-2 mb-6 text-xs text-slate-700">
                  {evt.highlights.slice(0, 3).map(h => (
                    <li class="flex items-center gap-2">
                      <svg class="w-4 h-4 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Button -->
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs text-slate-500 font-semibold">{evt.dates}</span>
                <a 
                  href={`/evenements/${evt.slug === 'raid-gaspesie' ? 'raids' : evt.slug}/`} 
                  class="px-4 py-2.5 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white text-xs font-heading font-bold uppercase tracking-wider transition-all shadow-md shadow-brand-red/20"
                >
                  Détails & Inscription
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- SECTION SERVICES CORPORATIFS & B2B (Modèle Hybride : Fond blanc avec cartes structurées) -->
  <section class="py-24 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-16">
        <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest block mb-2">Expertise B2B & Municipalités</span>
        <h2 class="text-3xl sm:text-5xl font-heading font-black uppercase tracking-tight text-slate-900 mb-4">
          Services Événementiels & Production Audiovisuelle
        </h2>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          Nous mettons nos 25 années d'ingénierie tout-terrain et nos équipes de tournage au service de vos défis corporatifs, courses officielles et projets télévisés.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl">
        {services.map((srv) => {
          const meta = serviceVisuals[srv.id] || {
            tag: 'Expertise Pro',
            badgeClass: 'bg-slate-100 text-slate-700 border-slate-200',
            iconBg: 'bg-slate-100 border-slate-200 text-slate-700',
            borderHover: 'hover:border-slate-400',
            btnBorderHover: 'hover:border-slate-800 hover:bg-slate-800 hover:text-white',
            bulletColor: 'text-brand-cyan',
            iconSvg: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
          };

          return (
            <div class={`rounded-2xl bg-slate-50/90 border border-slate-200 p-8 flex flex-col justify-between transition-all duration-300 ${meta.borderHover} hover:shadow-xl hover:-translate-y-1`}>
              <div>
                <div class="flex items-center justify-between mb-6">
                  <div class={`w-12 h-12 rounded-xl border flex items-center justify-center font-bold shadow-sm ${meta.iconBg}`} set:html={meta.iconSvg}>
                  </div>
                  <span class={`text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md border ${meta.badgeClass}`}>
                    {meta.tag}
                  </span>
                </div>

                <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">
                  {srv.title}
                </h3>
                <p class="text-sm text-slate-600 mb-6 leading-relaxed">
                  {srv.description}
                </p>

                <ul class="space-y-2.5 mb-8 text-xs text-slate-700">
                  {srv.features.map((f) => (
                    <li class="flex items-start gap-2.5">
                      <span class={`font-bold mt-0.5 ${meta.bulletColor}`}>•</span>
                      <span class="leading-relaxed">{f}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <a 
                href={`/services/${srv.slug}/`} 
                class={`w-full py-3 rounded-xl border border-slate-300 text-slate-800 text-center text-xs font-bold uppercase tracking-wider transition-all shadow-sm ${meta.btnBorderHover}`}
              >
                Consulter les détails →
              </a>
            </div>
          );
        })}
      </div>

      <!-- BANDEAU CONSULTATION & DIRECTION DE PROJET (Design sobre, épuré et authentique) -->
      <div class="mt-16 rounded-2xl bg-slate-900 border border-slate-800 p-8 sm:p-12 text-white shadow-xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Colonne Titre & Pitch -->
          <div class="lg:col-span-7">
            <span class="text-xs font-heading font-bold uppercase tracking-widest text-slate-400 block mb-2">
              Ingénierie & Direction de Projet
            </span>
            <h3 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-black uppercase tracking-tight text-white mb-4 leading-tight">
              Un projet d'événement ou un tournage extrême ?
            </h3>
            <p class="text-base text-slate-300 leading-relaxed mb-6">
              Échangez directement avec <strong class="text-white font-semibold">Bastien Michau</strong> et <strong class="text-white font-semibold">Daniel Poirier</strong> pour évaluer la faisabilité technique de votre projet et obtenir une soumission détaillée.
            </p>

            <!-- Spécifications concrètes de terrain -->
            <ul class="space-y-2 mb-8 text-xs text-slate-300">
              <li class="flex items-center gap-2.5">
                <span class="text-brand-red font-bold">✓</span>
                <span>Repérage cartographique GPS, conformité environnementale et plans d'urgence</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="text-brand-cyan font-bold">✓</span>
                <span>Moyens de tournage 4K, cadreurs outdoor et drones homologués Transports Canada</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="text-emerald-400 font-bold">✓</span>
                <span>Étude de faisabilité et estimation chiffrée remises sous 48 heures</span>
              </li>
            </ul>

            <!-- Actions claires et directes -->
            <div class="flex flex-wrap items-center gap-4">
              <a 
                href="/contact/" 
                class="px-7 py-3.5 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-xs uppercase tracking-wider transition-colors inline-flex items-center gap-2 shadow-sm"
              >
                <span>Demander une soumission</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>

              <a 
                href="mailto:info@enduranceaventure.com" 
                class="px-5 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-bold uppercase tracking-wider transition-colors inline-flex items-center gap-2"
              >
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <span>info@enduranceaventure.com</span>
              </a>

              <span class="text-xs text-slate-400">
                Magog, QC — <a href="tel:4506599944" class="text-slate-300 hover:text-white font-semibold underline underline-offset-4">(450) 659-9944</a>
              </span>
            </div>
          </div>

          <!-- Colonne Interlocuteurs : Bastien Michau en premier, puis Daniel Poirier -->
          <div class="lg:col-span-5 flex flex-col gap-3.5">
            <div class="text-[11px] uppercase font-heading font-bold tracking-widest text-slate-400 mb-0.5">
              Direction opérationnelle :
            </div>

            <!-- 1. Bastien Michau (En haut) -->
            <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-800/90 border border-slate-700/80">
              <img 
                src="/assets/bastien-michau.webp" 
                alt="Bastien Michau" 
                class="w-14 h-14 rounded-xl object-cover border border-slate-600 flex-shrink-0"
                onerror="this.src='/assets/bastien-michau.jpg'"
              />
              <div>
                <div class="text-white font-heading font-bold text-base leading-snug">Bastien Michau</div>
                <div class="text-xs text-brand-cyan font-semibold">Directeur de Production & Réalisateur</div>
                <div class="text-[11px] text-slate-400 mt-0.5">Captation outdoor extrême, drones certifiés & documentaires télévisés</div>
              </div>
            </div>

            <!-- 2. Daniel Poirier (En dessous) -->
            <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-800/90 border border-slate-700/80">
              <img 
                src="/assets/daniel-poirier-endurance-aventure.webp" 
                alt="Daniel Poirier" 
                class="w-14 h-14 rounded-xl object-cover border border-slate-600 flex-shrink-0"
                onerror="this.src='/assets/daniel-poirier-endurance-aventure.jpg'"
              />
              <div>
                <div class="text-white font-heading font-bold text-base leading-snug">Daniel Poirier</div>
                <div class="text-xs text-brand-red font-semibold">Fondateur & Directeur d'Épreuves</div>
                <div class="text-[11px] text-slate-400 mt-0.5">25 ans d'ingénierie de parcours, logistique en région isolée & sécurité civile</div>
              </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </section>


  <!-- SECTION DERNIÈRES NOUVELLES (Fond clair pour confort de lecture) -->
  <section class="py-24 bg-slate-100/70 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex items-center justify-between mb-16">
        <div>
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Récits de Terrain</span>
          <h2 class="text-3xl sm:text-4xl font-heading font-black uppercase tracking-tight text-slate-900">
            Actualités & Récits
          </h2>
        </div>
        <a href="/nouvelles" class="text-sm font-bold text-slate-700 hover:text-brand-red uppercase tracking-wider">
          Tous les articles ({news.length}) →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {latestNews.map((n) => (
          <article class="rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden flex flex-col group hover:shadow-lg transition-all duration-300">
            <div class="relative h-48 overflow-hidden bg-slate-200">
              <img 
                src={n.image} 
                alt={n.title} 
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                onerror="this.src='/assets/EnduranceAventure.jpg'"
              />
              <span class="absolute top-3 right-3 px-2.5 py-1 rounded bg-black/75 text-[11px] font-semibold text-white backdrop-blur-sm">
                📅 {n.date}
              </span>
            </div>
            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-heading font-bold text-slate-900 mb-2 group-hover:text-brand-red transition-colors line-clamp-2">
                  <a href={`/nouvelles/${n.slug}`}>{n.title}</a>
                </h3>
                <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed mb-4">
                  {n.excerpt}
                </p>
              </div>
              <a href={`/nouvelles/${n.slug}`} class="text-xs font-bold text-brand-red hover:underline uppercase tracking-wider">
                Lire l'article complet →
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <style>
    @keyframes infinite-scroll {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(-50%);
      }
    }
    .animate-infinite-scroll {
      animation: infinite-scroll 32s linear infinite;
    }
    .animate-infinite-scroll:hover {
      animation-play-state: paused;
    }
  </style>

</Layout>
