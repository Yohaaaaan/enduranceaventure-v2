---
import Layout from '../layouts/Layout.astro';
import events from '../data/events.json';
import services from '../data/services.json';
import news from '../data/news.json';

const featuredEvents = events.filter(e => e.featured);
const latestNews = news.slice(0, 3);

const serviceVisuals: Record<string, {
  tag: string;
  badgeClass: string;
  iconBg: string;
  borderHover: string;
  btnBorderHover: string;
  bulletColor: string;
  iconSvg: string;
}> = {
  'organisation-evenements': {
    tag: 'Logistique & Sécurité',
    badgeClass: 'bg-red-50 text-brand-red border-red-200/80',
    iconBg: 'bg-red-50 border-red-200 text-brand-red',
    borderHover: 'hover:border-brand-red/50 hover:shadow-red-500/10',
    btnBorderHover: 'hover:border-brand-red hover:bg-brand-red hover:text-white',
    bulletColor: 'text-brand-red',
    iconSvg: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/><circle cx="12" cy="11.5" r="2.2" class="fill-brand-red/20" stroke="currentColor" stroke-width="1.5"/></svg>`
  },
  'production-tele': {
    tag: 'Captation Extrême & 4K',
    badgeClass: 'bg-cyan-50 text-brand-cyan border-cyan-200/80',
    iconBg: 'bg-cyan-50 border-cyan-200 text-brand-cyan',
    borderHover: 'hover:border-brand-cyan/50 hover:shadow-cyan-500/10',
    btnBorderHover: 'hover:border-brand-cyan hover:bg-brand-cyan hover:text-white',
    bulletColor: 'text-brand-cyan',
    iconSvg: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/><circle cx="9" cy="13" r="2.2" class="fill-brand-cyan/20" stroke="currentColor" stroke-width="1.5"/><path stroke-linecap="round" stroke-width="1.8" d="M5 4h7"/></svg>`
  },
  'chronometrage-logistique': {
    tag: 'RFID & Suivi Live',
    badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200/80',
    iconBg: 'bg-emerald-50 border-emerald-200 text-emerald-600',
    borderHover: 'hover:border-emerald-500/50 hover:shadow-emerald-500/10',
    btnBorderHover: 'hover:border-emerald-600 hover:bg-emerald-600 hover:text-white',
    bulletColor: 'text-emerald-600',
    iconSvg: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="14" r="8" stroke-width="1.8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 10v4l2.5 2.5"/><path stroke-linecap="round" stroke-width="1.8" d="M10 2h4M12 2v3M19 6l1.5-1.5"/><circle cx="12" cy="14" r="1.5" class="fill-emerald-600"/></svg>`
  }
};
---

<Layout title="Endurance Aventure | Événements Plein Air & Production Audiovisuelle Extrême">
  
  <!-- HERO SECTION CINÉMATIQUE SOMBRE (Visuel d'action authentique) -->
  <section class="relative min-h-[82vh] flex flex-col justify-between overflow-hidden bg-slate-950">
    <!-- Image de fond authentique en plein écran avec assombrissement naturel -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/assets/2023-08-05_GBC500_mc_1498-scaled.webp" 
        alt="GBC 500 Gravel Bike Endurance Aventure" 
        class="w-full h-full object-cover object-center brightness-60 contrast-110"
        onerror="this.src='/assets/2023-08-05_GBC500_mc_1498-scaled.jpg'"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-black/60"></div>
    </div>

    <!-- Contenu Principal du Hero -->
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16 flex-grow flex flex-col justify-center text-left">
      
      <!-- Kicker d'autorité -->
      <div class="flex items-center gap-3 text-xs sm:text-sm font-heading font-bold uppercase tracking-widest text-slate-300 mb-4">
        <span class="px-2.5 py-1 bg-brand-red text-white rounded font-bold">Depuis 1998</span>
        <span>Organisation d'Événements Plein Air & Production Télévisuelle</span>
      </div>

      <!-- Titre d'impact sans dégradé arc-en-ciel artificiel -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-heading font-black uppercase tracking-tight text-white leading-tight max-w-4xl mb-6">
        L'aventure sportive <br class="hidden sm:inline" />
        <span class="text-brand-red">grandeur nature.</span>
      </h1>

      <!-- Descriptif ancré dans la réalité québécoise -->
      <p class="max-w-2xl text-base sm:text-xl text-slate-200 font-normal leading-relaxed mb-8">
        Endurance Aventure conçoit et organise des épreuves d'endurance uniques à travers les territoires les plus sauvages du Québec, et réalise des tournages extrêmes pour la télévision et le web.
      </p>

      <!-- Actions directes -->
      <div class="flex flex-wrap items-center gap-4">
        <a 
          href="#evenements" 
          class="px-8 py-4 rounded-lg bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-sm uppercase tracking-wider transition-colors shadow-lg"
        >
          Calendrier des Épreuves 2026/2027
        </a>
        <a 
          href="/services" 
          class="px-8 py-4 rounded-lg bg-slate-900/80 hover:bg-slate-900 text-slate-100 border border-slate-700 hover:border-slate-500 font-heading font-bold text-sm uppercase tracking-wider transition-colors backdrop-blur-sm"
        >
          Services Corporatifs & Tournages
        </a>
      </div>

    </div>

    <!-- Bandeau Bas d'Accès Direct aux 3 Épreuves Clés (Preuve concrète de terrain) -->
    <div class="relative z-10 border-t border-white/15 bg-black/80 backdrop-blur-md">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 divide-y md:divide-y-0 md:divide-x divide-white/10">
          
          <a href="/evenements/gbc500" class="group pt-3 md:pt-0 md:px-4 first:pl-0 flex items-center justify-between">
            <div>
              <div class="text-[11px] font-bold uppercase tracking-wider text-brand-red">Août 2026 • Cantons-de-l'Est</div>
              <div class="text-sm font-heading font-bold text-white group-hover:text-brand-red transition-colors">GBC 500 Gravel Bikepacking</div>
              <div class="text-xs text-slate-400">500 km • 250 km • 100 km</div>
            </div>
            <span class="text-slate-400 group-hover:text-white transition-colors">→</span>
          </a>

          <a href="/evenements/trail-des-neiges" class="group pt-3 md:pt-0 md:px-4 flex items-center justify-between">
            <div>
              <div class="text-[11px] font-bold uppercase tracking-wider text-brand-cyan">Février 2027 • Mont-Orford</div>
              <div class="text-sm font-heading font-bold text-white group-hover:text-brand-cyan transition-colors">Trail des Neiges</div>
              <div class="text-xs text-slate-400">5 km • 10 km • 15 km Nocturne</div>
            </div>
            <span class="text-slate-400 group-hover:text-white transition-colors">→</span>
          </a>

          <a href="/evenements/raids" class="group pt-3 md:pt-0 md:px-4 flex items-center justify-between">
            <div>
              <div class="text-[11px] font-bold uppercase tracking-wider text-slate-300">Automne • Gaspésie & Témiscamingue</div>
              <div class="text-sm font-heading font-bold text-white group-hover:text-brand-red transition-colors">Raids Aventure Multisports</div>
              <div class="text-xs text-slate-400">Expéditions canot, vélo, trek & boussole</div>
            </div>
            <span class="text-slate-400 group-hover:text-white transition-colors">→</span>
          </a>

        </div>
      </div>
    </div>
  </section>


  <!-- SECTION ÉVÉNEMENTS PHARES (Fond clair pour lisibilité parfaite) -->
  <section id="evenements" class="py-24 bg-slate-100/70 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Grand Public & Athlètes</span>
          <h2 class="text-3xl sm:text-5xl font-heading font-black uppercase tracking-tight text-slate-900">
            Nos Événements Sportifs
          </h2>
        </div>
        <a href="/evenements" class="text-brand-red hover:text-red-700 font-bold text-sm uppercase tracking-wider flex items-center gap-1.5 transition-colors">
          Voir tout le calendrier →
        </a>
      </div>

      <!-- Events Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {featuredEvents.map((evt) => (
          <div class="group rounded-2xl bg-white border border-slate-200/90 shadow-sm overflow-hidden flex flex-col transition-all duration-300 hover:border-slate-300 hover:shadow-xl hover:-translate-y-1">
            <!-- Image Frame -->
            <div class="relative h-64 overflow-hidden bg-slate-200">
              <img 
                src={evt.image} 
                alt={evt.title} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
              
              <!-- Badge Status -->
              <span class="absolute top-4 left-4 px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-brand-red text-white shadow-md">
                {evt.category}
              </span>
              
              <!-- Badge Location -->
              <span class="absolute bottom-4 left-4 px-3 py-1 rounded-md text-xs font-semibold bg-slate-950/80 text-white backdrop-blur-sm">
                📍 {evt.location}
              </span>
            </div>

            <!-- Content -->
            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <h3 class="text-2xl font-heading font-bold text-slate-900 mb-2 group-hover:text-brand-red transition-colors">
                  {evt.title}
                </h3>
                <p class="text-sm text-slate-600 mb-6 line-clamp-3 leading-relaxed">
                  {evt.description}
                </p>

                <!-- Key details list -->
                <ul class="space-y-2 mb-6 text-xs text-slate-700">
                  {evt.highlights.slice(0, 3).map(h => (
                    <li class="flex items-center gap-2">
                      <svg class="w-4 h-4 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Button -->
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs text-slate-500 font-semibold">{evt.dates}</span>
                <a 
                  href={`/evenements/${evt.slug === 'raid-gaspesie' ? 'raids' : evt.slug}/`} 
                  class="px-4 py-2.5 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white text-xs font-heading font-bold uppercase tracking-wider transition-all shadow-md shadow-brand-red/20"
                >
                  Détails & Inscription
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- SECTION SERVICES CORPORATIFS & B2B (Modèle Hybride : Fond blanc avec cartes structurées) -->
  <section class="py-24 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-16">
        <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest block mb-2">Expertise B2B & Municipalités</span>
        <h2 class="text-3xl sm:text-5xl font-heading font-black uppercase tracking-tight text-slate-900 mb-4">
          Services Événementiels & Production Audiovisuelle
        </h2>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          Nous mettons nos 25 années d'ingénierie tout-terrain et nos équipes de tournage au service de vos défis corporatifs, courses officielles et projets télévisés.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {services.map((srv) => {
          const meta = serviceVisuals[srv.id] || {
            tag: 'Expertise Pro',
            badgeClass: 'bg-slate-100 text-slate-700 border-slate-200',
            iconBg: 'bg-slate-100 border-slate-200 text-slate-700',
            borderHover: 'hover:border-slate-400',
            btnBorderHover: 'hover:border-slate-800 hover:bg-slate-800 hover:text-white',
            bulletColor: 'text-brand-cyan',
            iconSvg: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
          };

          return (
            <div class={`rounded-2xl bg-slate-50/90 border border-slate-200 p-8 flex flex-col justify-between transition-all duration-300 ${meta.borderHover} hover:shadow-xl hover:-translate-y-1`}>
              <div>
                <div class="flex items-center justify-between mb-6">
                  <div class={`w-12 h-12 rounded-xl border flex items-center justify-center font-bold shadow-sm ${meta.iconBg}`} set:html={meta.iconSvg}>
                  </div>
                  <span class={`text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md border ${meta.badgeClass}`}>
                    {meta.tag}
                  </span>
                </div>

                <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">
                  {srv.title}
                </h3>
                <p class="text-sm text-slate-600 mb-6 leading-relaxed">
                  {srv.description}
                </p>

                <ul class="space-y-2.5 mb-8 text-xs text-slate-700">
                  {srv.features.map((f) => (
                    <li class="flex items-start gap-2.5">
                      <span class={`font-bold mt-0.5 ${meta.bulletColor}`}>•</span>
                      <span class="leading-relaxed">{f}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <a 
                href={`/services/${srv.slug}/`} 
                class={`w-full py-3 rounded-xl border border-slate-300 text-slate-800 text-center text-xs font-bold uppercase tracking-wider transition-all shadow-sm ${meta.btnBorderHover}`}
              >
                Consulter les détails →
              </a>
            </div>
          );
        })}
      </div>

      <!-- BANDEAU HAUTE VALEUR : Consultation & Ingénierie Projet avec Photos des Fondateurs -->
      <div class="mt-20 relative overflow-hidden rounded-3xl bg-slate-950 text-white p-8 sm:p-12 lg:p-14 border border-slate-800 shadow-2xl">
        <!-- Ligne d'accent supérieure dégradée marque -->
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-brand-red via-brand-cyan to-brand-red"></div>
        
        <!-- Halos subtils d'ambiance en arrière-plan -->
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-brand-cyan/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-brand-red/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
          
          <!-- Badge d'engagement direct -->
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/15 text-xs font-bold uppercase tracking-wider text-cyan-300 mb-6 backdrop-blur-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Conseil direct & Étude de faisabilité sous 48h</span>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            
            <!-- Colonne Titre & Pitch -->
            <div class="lg:col-span-7">
              <h3 class="text-2xl sm:text-4xl font-heading font-black uppercase tracking-tight text-white mb-4 leading-tight">
                Un projet d'événement ou un tournage extrême ?
              </h3>
              <p class="text-base sm:text-lg text-slate-300 leading-relaxed mb-6">
                Échangez directement avec <strong class="text-white font-semibold">Daniel Poirier</strong>, <strong class="text-white font-semibold">Bastien Michau</strong> et notre équipe technique pour une étude de faisabilité rigoureuse et un devis personnalisé.
              </p>

              <!-- Points d'engagement clés -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
                <div class="flex items-center gap-2 text-xs text-slate-200">
                  <svg class="w-4 h-4 text-brand-red flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                  <span>Terrain & sécurité civile</span>
                </div>
                <div class="flex items-center gap-2 text-xs text-slate-200">
                  <svg class="w-4 h-4 text-brand-cyan flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                  <span>Drones & cadreurs 4K</span>
                </div>
                <div class="flex items-center gap-2 text-xs text-slate-200">
                  <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                  <span>Chiffrage clair sous 48h</span>
                </div>
              </div>

              <!-- Boutons d'action -->
              <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
                <a 
                  href="/contact/" 
                  class="inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-sm uppercase tracking-wider transition-all shadow-lg shadow-brand-red/30 hover:scale-[1.02]"
                >
                  <span>Demander une soumission</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
                <a 
                  href="mailto:info@enduranceaventure.com" 
                  class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-heading font-bold text-xs uppercase tracking-wider transition-all border border-white/15"
                >
                  <svg class="w-4 h-4 text-brand-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <span>info@enduranceaventure.com</span>
                </a>
              </div>
            </div>

            <!-- Colonne Vos Interlocuteurs Directs (Photos Réelles Daniel & Bastien) -->
            <div class="lg:col-span-5 flex flex-col gap-4">
              <div class="text-xs uppercase font-heading font-bold tracking-widest text-slate-400 mb-1">
                Vos interlocuteurs dédiés :
              </div>

              <!-- Daniel Poirier Card -->
              <div class="flex items-center gap-4 p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm transition-all hover:bg-white/10">
                <img 
                  src="/assets/daniel-poirier-endurance-aventure.webp" 
                  alt="Daniel Poirier" 
                  class="w-14 h-14 rounded-full object-cover border-2 border-brand-red flex-shrink-0 shadow-md"
                  onerror="this.src='/assets/daniel-poirier-endurance-aventure.jpg'"
                />
                <div>
                  <div class="text-white font-heading font-bold text-base">Daniel Poirier</div>
                  <div class="text-xs text-brand-red font-semibold">Fondateur & Directeur Général</div>
                  <div class="text-[11px] text-slate-300 mt-0.5">25 ans d'ingénierie parcours & logistique tout-terrain</div>
                </div>
              </div>

              <!-- Bastien Michau Card -->
              <div class="flex items-center gap-4 p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm transition-all hover:bg-white/10">
                <img 
                  src="/assets/bastien-michau.webp" 
                  alt="Bastien Michau" 
                  class="w-14 h-14 rounded-full object-cover border-2 border-brand-cyan flex-shrink-0 shadow-md"
                  onerror="this.src='/assets/bastien-michau.jpg'"
                />
                <div>
                  <div class="text-white font-heading font-bold text-base">Bastien Michau</div>
                  <div class="text-xs text-cyan-400 font-semibold">Directeur de Production & Réalisateur</div>
                  <div class="text-[11px] text-slate-300 mt-0.5">Captation outdoor extrême, drones & émissions TV</div>
                </div>
              </div>

            </div>

          </div>

        </div>
      </div>

    </div>
  </section>


  <!-- SECTION DERNIÈRES NOUVELLES (Fond clair pour confort de lecture) -->
  <section class="py-24 bg-slate-100/70 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex items-center justify-between mb-16">
        <div>
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Récits de Terrain</span>
          <h2 class="text-3xl sm:text-4xl font-heading font-black uppercase tracking-tight text-slate-900">
            Actualités & Récits
          </h2>
        </div>
        <a href="/nouvelles" class="text-sm font-bold text-slate-700 hover:text-brand-red uppercase tracking-wider">
          Tous les articles ({news.length}) →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {latestNews.map((n) => (
          <article class="rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden flex flex-col group hover:shadow-lg transition-all duration-300">
            <div class="relative h-48 overflow-hidden bg-slate-200">
              <img 
                src={n.image} 
                alt={n.title} 
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                onerror="this.src='/assets/EnduranceAventure.jpg'"
              />
              <span class="absolute top-3 right-3 px-2.5 py-1 rounded bg-black/75 text-[11px] font-semibold text-white backdrop-blur-sm">
                📅 {n.date}
              </span>
            </div>
            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-heading font-bold text-slate-900 mb-2 group-hover:text-brand-red transition-colors line-clamp-2">
                  <a href={`/nouvelles/${n.slug}`}>{n.title}</a>
                </h3>
                <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed mb-4">
                  {n.excerpt}
                </p>
              </div>
              <a href={`/nouvelles/${n.slug}`} class="text-xs font-bold text-brand-red hover:underline uppercase tracking-wider">
                Lire l'article complet →
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

</Layout>
