---
import Layout from '../layouts/Layout.astro';
import events from '../data/events.json';
import services from '../data/services.json';
import news from '../data/news.json';

const featuredEvents = events.filter(e => e.featured);
const latestNews = news.slice(0, 3);

const serviceVisuals: Record<string, {
  tag: string;
  badgeClass: string;
  iconBg: string;
  borderHover: string;
  btnBorderHover: string;
  bulletColor: string;
  image: string;
  imageAlt: string;
  iconSvg: string;
}> = {
  'organisation-evenements': {
    tag: 'Logistique & Sécurité',
    badgeClass: 'bg-red-50 text-brand-red border-red-200/80',
    iconBg: 'bg-red-50 border-red-200 text-brand-red',
    borderHover: 'hover:border-brand-red/50 hover:shadow-red-500/10',
    btnBorderHover: 'hover:border-brand-red hover:bg-brand-red hover:text-white',
    bulletColor: 'text-brand-red',
    image: '/assets/canadaman-2017-sommet-mont-megantic-ligne-arrivee.webp',
    imageAlt: 'Organisation clé en main et logistique tout-terrain',
    iconSvg: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/><circle cx="12" cy="11.5" r="2.2" class="fill-brand-red/20" stroke="currentColor" stroke-width="1.5"/></svg>`
  },
  'production-tele': {
    tag: 'Captation Extrême & 4K',
    badgeClass: 'bg-cyan-50 text-brand-cyan border-cyan-200/80',
    iconBg: 'bg-cyan-50 border-cyan-200 text-brand-cyan',
    borderHover: 'hover:border-brand-cyan/50 hover:shadow-cyan-500/10',
    btnBorderHover: 'hover:border-brand-cyan hover:bg-brand-cyan hover:text-white',
    bulletColor: 'text-brand-cyan',
    image: '/assets/JMMsony-September-13-2014_DSC1007.webp',
    imageAlt: 'Captation vidéo et production documentaire en milieux isolés',
    iconSvg: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/><circle cx="9" cy="13" r="2.2" class="fill-brand-cyan/20" stroke="currentColor" stroke-width="1.5"/><path stroke-linecap="round" stroke-width="1.8" d="M5 4h7"/></svg>`
  }
};
---

<Layout 
  title="Organisation d'Événements Sportifs & Production Plein Air au Québec | Endurance Aventure"
  description="Pionnier depuis 1998 : organisation d'épreuves sportives clés en main, logistique tout-terrain, teambuilding entreprise et captation télévisuelle par drones 4K au Québec."
>
  
  <!-- HERO SECTION CINÉMATIQUE SOMBRE (Visuel d'action authentique) -->
  <section class="relative min-h-[88vh] sm:min-h-screen flex flex-col justify-center overflow-hidden bg-slate-950">
    <!-- Image de fond authentique en plein écran avec assombrissement naturel -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/assets/2023-08-05_GBC500_mc_1498-scaled.webp" 
        alt="GBC 500 Gravel Bike Endurance Aventure" 
        class="w-full h-full object-cover object-center opacity-90 brightness-95 contrast-105"
        onerror="this.src='/assets/2023-08-05_GBC500_mc_1498-scaled.jpg'"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-black/15 to-black/25"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/60 via-transparent to-transparent"></div>
    </div>

    <!-- Contenu Principal du Hero -->
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16 flex-grow flex flex-col justify-center text-left">
      
      <!-- Kicker d'autorité -->
      <div class="flex items-center gap-3 text-xs sm:text-sm font-heading font-bold uppercase tracking-widest text-slate-300 mb-4">
        <span class="px-2.5 py-1 bg-brand-red text-white rounded font-bold">Depuis 1998</span>
        <span>Organisation d'Événements Plein Air & Production Télévisuelle</span>
      </div>

      <!-- Titre d'impact sans dégradé arc-en-ciel artificiel -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-heading font-black uppercase tracking-tight text-white leading-tight max-w-4xl mb-6">
        L'aventure sportive <br class="hidden sm:inline" />
        <span class="text-brand-red">grandeur nature.</span>
      </h1>

      <!-- Descriptif ancré dans la réalité québécoise -->
      <p class="max-w-2xl text-base sm:text-xl text-slate-200 font-normal leading-relaxed mb-8">
        Endurance Aventure conçoit et organise des épreuves d'endurance uniques à travers les territoires les plus sauvages du Québec, et réalise des tournages extrêmes pour la télévision et le web.
      </p>

      <!-- Actions directes -->
      <div class="flex flex-wrap items-center gap-4">
        <a 
          href="#evenements" 
          class="px-8 py-4 rounded-lg bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-sm uppercase tracking-wider transition-colors shadow-lg"
        >
          Calendrier des Épreuves 2026/2027
        </a>
        <a 
          href="/services" 
          class="px-8 py-4 rounded-lg bg-slate-900/80 hover:bg-slate-900 text-slate-100 border border-slate-700 hover:border-slate-500 font-heading font-bold text-sm uppercase tracking-wider transition-colors backdrop-blur-sm"
        >
          Services Corporatifs & Tournages
        </a>
      </div>

    </div>
  </section>

  <!-- SECTION ÉVÉNEMENTS PHARES (Fond clair avec relief topographique de terrain) -->
  <section id="evenements" class="py-24 bg-slate-100/70 border-t border-slate-200 relative overflow-hidden">
    <!-- Formes de Relief Topographique Style Carte IGN / Outdoor (Courbes de niveau & Dénivelé) -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
      <svg class="absolute -top-10 left-1/2 -translate-x-1/2 w-[160%] sm:w-full h-[120%] opacity-[0.035] text-slate-900" viewBox="0 0 1440 900" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M-100 120 C 200 40, 450 260, 750 140 C 1050 20, 1300 180, 1600 90" stroke="currentColor" stroke-width="2" />
        <path d="M-100 200 C 220 110, 480 320, 780 210 C 1080 100, 1320 250, 1600 170" stroke="currentColor" stroke-width="1.5" />
        <path d="M-100 280 C 240 180, 510 390, 810 280 C 1110 170, 1340 320, 1600 250" stroke="currentColor" stroke-width="2" stroke-dasharray="12 6" />
        <path d="M-100 360 C 260 250, 540 460, 840 350 C 1140 240, 1360 390, 1600 330" stroke="currentColor" stroke-width="1.5" />
        <path d="M-100 440 C 280 320, 570 530, 870 420 C 1170 310, 1380 460, 1600 410" stroke="currentColor" stroke-width="2" />
        <path d="M-100 520 C 300 390, 600 600, 900 490 C 1200 380, 1400 530, 1600 490" stroke="currentColor" stroke-width="1.5" stroke-dasharray="8 6" />
        <path d="M-100 600 C 320 460, 630 670, 930 560 C 1230 450, 1420 600, 1600 570" stroke="currentColor" stroke-width="2" />
        <path d="M-100 680 C 340 530, 660 740, 960 630 C 1260 520, 1440 670, 1600 650" stroke="currentColor" stroke-width="1.5" />
        <path d="M-100 760 C 360 600, 690 810, 990 700 C 1290 590, 1460 740, 1600 730" stroke="currentColor" stroke-width="2" />
        <!-- Points de repères d'altitude style carte IGN -->
        <text x="320" y="275" font-size="11" font-family="sans-serif" font-weight="bold" fill="currentColor" opacity="0.6">850m</text>
        <text x="820" y="345" font-size="11" font-family="sans-serif" font-weight="bold" fill="currentColor" opacity="0.6">1200m (Mont-Orford)</text>
        <text x="1220" y="195" font-size="11" font-family="sans-serif" font-weight="bold" fill="currentColor" opacity="0.6">620m</text>
      </svg>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Grand Public & Athlètes</span>
          <h2 class="text-3xl sm:text-5xl font-heading font-black uppercase tracking-tight text-slate-900">
            Nos Événements Sportifs
          </h2>
        </div>
        <a href="/evenements" class="text-brand-red hover:text-red-700 font-bold text-sm uppercase tracking-wider flex items-center gap-1.5 transition-colors">
          <span>Voir tout le calendrier</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

      <!-- Events Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredEvents.map((evt) => (
          <div class="group rounded-lg bg-white border border-slate-200/90 shadow-sm overflow-hidden flex flex-col transition-all duration-300 hover:border-slate-300 hover:shadow-lg hover:-translate-y-0.5">
            <!-- Image Frame -->
            <div class="relative h-64 overflow-hidden bg-slate-200">
              <img 
                src={evt.image} 
                alt={evt.title} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
              
              <!-- Badge Status -->
              <span class="absolute top-4 left-4 px-2.5 py-1 rounded-sm text-xs font-bold uppercase tracking-wider bg-brand-red text-white shadow-sm">
                {evt.category}
              </span>

              <!-- Badge Logos Officiels sur capsule blanche -->
              {evt.logo && (
                <div class="absolute top-4 right-4 p-1.5 sm:p-2 rounded-md bg-white shadow-sm border border-slate-200/90 flex items-center gap-2 z-10">
                  <img 
                    src={evt.logo} 
                    alt={`Logo ${evt.title}`} 
                    class="h-7 sm:h-9 w-auto object-contain max-w-[100px]" 
                  />
                  {evt.secondaryLogo && (
                    <>
                      <div class="h-6 w-px bg-slate-200"></div>
                      <img 
                        src={evt.secondaryLogo} 
                        alt={`Partenaire / Logo secondaire ${evt.title}`} 
                        class="h-6 sm:h-7 w-auto object-contain max-w-[70px]" 
                      />
                    </>
                  )}
                </div>
              )}
              
              <!-- Badge Location -->
              <span class="absolute bottom-4 left-4 px-2.5 py-1 rounded-sm text-xs font-semibold bg-slate-950/85 text-white backdrop-blur-sm border border-slate-800 flex items-center gap-1.5 shadow-sm">
                <svg class="w-3.5 h-3.5 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span>{evt.location}</span>
              </span>
            </div>

            <!-- Content -->
            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <h3 class="text-2xl font-heading font-bold text-slate-900 mb-2 group-hover:text-brand-red transition-colors">
                  {evt.title}
                </h3>
                <p class="text-sm text-slate-600 mb-6 line-clamp-3 leading-relaxed">
                  {evt.description}
                </p>

                <!-- Key details list -->
                <ul class="space-y-2 mb-6 text-xs text-slate-700">
                  {evt.highlights.slice(0, 3).map(h => (
                    <li class="flex items-center gap-2">
                      <svg class="w-4 h-4 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Button -->
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs text-slate-500 font-semibold">{evt.dates}</span>
                {evt.registrationLink && evt.registrationLink !== '#' ? (
                  <a 
                    href={evt.registrationLink} 
                    target={evt.registrationLink.startsWith('http') ? '_blank' : undefined}
                    rel={evt.registrationLink.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="px-4 py-2.5 rounded-md bg-brand-red hover:bg-brand-red-dark text-white text-xs font-heading font-bold uppercase tracking-wider transition-all shadow-sm inline-flex items-center gap-1.5"
                  >
                    <span>{evt.buttonText || (evt.registrationLink.startsWith('http') ? 'Visiter le site' : 'Détails')}</span>
                    {evt.registrationLink.startsWith('http') && (
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    )}
                  </a>
                ) : (
                  <span class="px-4 py-2.5 rounded-md bg-slate-100 text-slate-400 border border-slate-200 text-xs font-heading font-bold uppercase tracking-wider inline-flex items-center gap-1.5 cursor-not-allowed">
                    À venir
                  </span>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- SECTION ADN D'EXPÉDITION & IMPACT DE TERRAIN (Design Clair Élégant & Preuves Concrètes) -->
  <section class="py-20 bg-slate-150/70 border-t border-slate-200 relative overflow-hidden bg-gradient-to-b from-slate-100/90 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Colonne Texte & Vision -->
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-white border border-slate-200 border-l-2 border-l-brand-red text-slate-800 text-xs font-heading font-bold uppercase tracking-wider shadow-sm">
            <span>Pionniers du Plein Air au Québec depuis 1998</span>
          </div>
          <h2 class="text-3xl sm:text-5xl font-heading font-black uppercase tracking-tight text-slate-900 leading-tight">
            25 Ans d'Expédition & d'Ingénierie Sportive
          </h2>
          <p class="text-base text-slate-700 leading-relaxed">
            Endurance Aventure collabore étroitement avec les municipalités, parcs nationaux et diffuseurs pour concevoir, tracer et produire des événements d’envergure qui révèlent la beauté sauvage du Québec.
          </p>
          <p class="text-sm text-slate-600 leading-relaxed">
            Du repérage cartographique GPS à la coordination des secours en région isolée, nos traceurs et réalisateurs créent des leviers majeurs d'attractivité touristique et économique, amplifiés par des captations audiovisuelles diffusées à travers le monde.
          </p>

          <div class="pt-2 flex flex-wrap gap-4">
            <a 
              href="/entreprise/" 
              class="px-7 py-3.5 rounded-md bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-xs uppercase tracking-wider transition-colors inline-flex items-center gap-2 shadow-sm"
            >
              <span>Découvrir l'histoire & l'équipe</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <a 
              href="/services/organisation-evenements/" 
              class="px-6 py-3.5 rounded-md bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 font-heading font-bold text-xs uppercase tracking-wider transition-colors inline-flex items-center gap-2 shadow-sm"
            >
              <span>Organisation d'Événements</span>
            </a>
          </div>
        </div>

        <!-- Colonne Preuves Sociales Réelles & Photos de Terrain -->
        <div class="lg:col-span-6 space-y-6">
          <!-- 4 Stats Cards Claires et Professionnelles -->
          <div class="grid grid-cols-2 gap-4">
            <div class="p-5 rounded-lg bg-white border border-slate-200 shadow-sm">
              <div class="text-3xl sm:text-4xl font-heading font-black text-brand-red mb-1">1998</div>
              <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Fondation au Québec</div>
              <div class="text-[11px] text-slate-600 mt-1">+25 ans d'organisation pionnière</div>
            </div>
            <div class="p-5 rounded-lg bg-white border border-slate-200 shadow-sm">
              <div class="text-3xl sm:text-4xl font-heading font-black text-brand-cyan mb-1">+10 000 km</div>
              <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Parcours & Sentiers Tracés</div>
              <div class="text-[11px] text-slate-600 mt-1">Explorés, cartographiés et sécurisés en milieu sauvage</div>
            </div>
            <div class="p-5 rounded-lg bg-white border border-slate-200 shadow-sm">
              <div class="text-3xl sm:text-4xl font-heading font-black text-slate-800 mb-1">30+</div>
              <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Régions & Villes Partenaires</div>
              <div class="text-[11px] text-slate-600 mt-1">Gaspésie, Témiscamingue, Estrie, Cantons</div>
            </div>
            <div class="p-5 rounded-lg bg-white border border-slate-200 shadow-sm">
              <div class="text-3xl sm:text-4xl font-heading font-black text-emerald-600 mb-1">RDS & TVA</div>
              <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Diffusion Média Nationale</div>
              <div class="text-[11px] text-slate-600 mt-1">Documentaires sportifs & séries d'aventure</div>
            </div>
          </div>

          <!-- Duo Photos de Terrain Authentiques -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="rounded-lg overflow-hidden bg-slate-100 border border-slate-200 h-44 relative group shadow-sm">
              <img 
                src="/assets/51581835318_775ae15a4e_k.webp" 
                alt="Repérages cartographiques en pleine nature boréale" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent"></div>
              <span class="absolute bottom-2.5 left-3 text-white text-xs font-semibold">Repérage de sentiers sauvages</span>
            </div>
            <div class="rounded-lg overflow-hidden bg-slate-100 border border-slate-200 h-44 relative group shadow-sm">
              <img 
                src="/assets/JMMsony-September-12-2014_DSC0167.webp" 
                alt="Logistique tout-terrain et coordination des épreuves" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent"></div>
              <span class="absolute bottom-2.5 left-3 text-white text-xs font-semibold">Logistique d'expédition & régie</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- SECTION SERVICES CORPORATIFS, B2B & MUNICIPALITÉS (Fond Blanc Épuré) -->
  <section class="py-24 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-16">
        <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest block mb-2">Expertise B2B, Villes & Entreprises</span>
        <h2 class="text-3xl sm:text-5xl font-heading font-black uppercase tracking-tight text-slate-900 mb-4">
          Services Événementiels & Production Audiovisuelle
        </h2>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          Nous mettons nos 25 années d'ingénierie tout-terrain et nos équipes de tournage au service de vos défis corporatifs, courses officielles et projets télévisés.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl">
        {services.map((srv) => {
          const meta = serviceVisuals[srv.id] || {
            tag: 'Expertise Pro',
            badgeClass: 'bg-slate-100 text-slate-700 border-slate-200',
            iconBg: 'bg-slate-100 border-slate-200 text-slate-700',
            borderHover: 'hover:border-slate-400',
            btnBorderHover: 'hover:border-slate-800 hover:bg-slate-800 hover:text-white',
            bulletColor: 'text-brand-cyan',
            image: '/assets/canadaman-2017-sommet-mont-megantic-ligne-arrivee.webp',
            imageAlt: srv.title,
            iconSvg: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
          };

          return (
            <div class={`rounded-lg bg-white border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between transition-all duration-300 ${meta.borderHover} hover:shadow-lg hover:-translate-y-0.5 group`}>
              <div>
                <!-- Bannière Photo Authentique -->
                <div class="h-48 overflow-hidden bg-slate-100 relative">
                  <img 
                    src={meta.image} 
                    alt={meta.imageAlt} 
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-black/15 to-transparent"></div>
                  <span class={`absolute top-3 right-3 text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-sm border shadow-sm ${meta.badgeClass}`}>
                    {meta.tag}
                  </span>
                </div>

                <div class="p-6 sm:p-8">
                  <div class="flex items-center gap-3 mb-4">
                    <div class={`w-10 h-10 rounded-md border flex items-center justify-center font-bold shadow-sm flex-shrink-0 ${meta.iconBg}`} set:html={meta.iconSvg}>
                    </div>
                    <h3 class="text-xl font-heading font-bold text-slate-900">
                      {srv.title}
                    </h3>
                  </div>

                  <p class="text-sm text-slate-600 mb-6 leading-relaxed">
                    {srv.description}
                  </p>

                  <ul class="space-y-2.5 mb-8 text-xs text-slate-700">
                    {srv.features.map((f) => (
                      <li class="flex items-start gap-2.5">
                        <span class={`font-bold mt-0.5 ${meta.bulletColor}`}>•</span>
                        <span class="leading-relaxed">{f}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="px-6 sm:px-8 pb-6 sm:pb-8 pt-0">
                <a 
