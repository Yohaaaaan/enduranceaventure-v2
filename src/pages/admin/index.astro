---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Tableau de Bord Analytics | Endurance Aventure"
  description="Panneau d'administration et statistiques de fréquentation du site Endurance Aventure."
>

  <div class="bg-brand-dark min-h-[85vh] text-slate-100">
  <!-- LOGIN MODAL / SCREEN (shown when not authenticated) -->
  <div id="login-overlay" class="min-h-[70vh] flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-md bg-brand-darker border border-brand-gray/80 rounded-lg p-8 shadow-xl relative overflow-hidden">
      
      <div class="relative text-center mb-8">
        <div class="w-14 h-14 mx-auto rounded-md bg-brand-red flex items-center justify-center font-heading font-black text-white text-xl shadow-sm mb-4">
          EA
        </div>
        <h1 class="text-2xl font-heading font-black text-white">Espace Administration</h1>
        <p class="text-xs text-slate-400 mt-2">Veuillez entrer le mot de passe d'accès pour consulter les statistiques.</p>
      </div>

      <form id="login-form" class="space-y-5 relative">
        <div id="login-error" class="hidden text-xs text-red-400 bg-red-950/60 border border-red-800/60 rounded-md px-4 py-3 font-semibold text-center">
          Mot de passe incorrect.
        </div>

        <div>
          <label for="admin-password" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Mot de passe</label>
          <input 
            type="password" 
            id="admin-password" 
            required 
            placeholder="•••••••••"
            autocomplete="current-password"
            class="w-full bg-brand-dark border border-brand-gray focus:border-brand-red text-white text-sm rounded-md px-4 py-3 focus:outline-none transition-colors"
          />
        </div>

        <button 
          type="submit" 
          id="login-btn"
          class="w-full py-3.5 px-6 rounded-md bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-xs uppercase tracking-wider shadow-sm transition-all flex items-center justify-center gap-2"
        >
          <span>Déverrouiller l'accès</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
      </form>
    </div>
  </div>

  <!-- MAIN ADMIN DASHBOARD (Hidden until authenticated) -->
  <div id="admin-dashboard" class="hidden">
    
    <!-- Top header banner -->
    <div class="bg-brand-darker border-b border-brand-gray/60 py-6">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-md bg-brand-red flex items-center justify-center font-heading font-bold text-white shadow-sm">
            EA
          </div>
          <div>
            <h1 class="text-xl font-heading font-bold text-white flex items-center gap-2">
              Panneau d'Administration & Analytics
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm text-[10px] font-bold uppercase tracking-wider bg-slate-900 text-emerald-400 border border-emerald-500/40">
                <span class="w-1.5 h-1.5 rounded-sm bg-emerald-400"></span>
                En direct
              </span>
            </h1>
            <p class="text-xs text-slate-400">Statistiques de visites & provenance (Inspiré de Plausible / Umami Open-Source)</p>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 w-full sm:w-auto">
          <select id="time-range" class="flex-1 sm:flex-initial bg-brand-dark border border-brand-gray text-slate-200 text-xs font-semibold rounded-md px-3 py-2.5 min-h-[44px] focus:outline-none focus:border-brand-cyan">
            <option value="today">Aujourd'hui</option>
            <option value="7d" selected>7 Derniers Jours</option>
            <option value="30d">30 Derniers Jours</option>
            <option value="all">Tout l'historique</option>
          </select>
          <button id="refresh-btn" class="px-3.5 py-2.5 min-h-[44px] rounded-md bg-brand-gray hover:bg-slate-700 text-white text-xs font-bold transition-all flex items-center justify-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            Actualiser
          </button>
          <button id="logout-btn" class="px-3.5 py-2.5 min-h-[44px] rounded-md border border-red-900/60 hover:bg-red-950 text-red-300 text-xs font-bold transition-all flex items-center justify-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            Déconnexion
          </button>
        </div>
      </div>
    </div>

    <!-- Main Analytics Container -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
      
      <!-- KPI CARDS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="rounded-lg bg-brand-darker border border-brand-gray p-6">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Vues de Pages Totales</div>
          <div id="stat-views" class="text-3xl font-heading font-black text-white">--</div>
          <div class="text-[11px] font-semibold mt-2 flex items-center gap-1">
            <span id="stat-period-tag" class="text-slate-400">• Période sélectionnée</span>
          </div>
        </div>

        <div class="rounded-lg bg-brand-darker border border-brand-gray p-6">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Visiteurs Uniques</div>
          <div id="stat-visitors" class="text-3xl font-heading font-black text-brand-red">--</div>
          <div class="text-[11px] text-slate-400 font-semibold mt-2">
            Adresses uniques anonymisées
          </div>
        </div>

        <div class="rounded-lg bg-brand-darker border border-brand-gray p-6">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Source Principale</div>
          <div id="stat-top-source" class="text-xl font-heading font-bold text-brand-cyan truncate">--</div>
          <div class="text-[11px] text-slate-400 font-semibold mt-2">
            Premier canal de provenance
          </div>
        </div>

        <div class="rounded-lg bg-brand-darker border border-brand-gray p-6">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Page la Plus Consultée</div>
          <div id="stat-top-page" class="text-xl font-heading font-bold text-white truncate">--</div>
          <div class="text-[11px] text-slate-400 font-semibold mt-2">
            Volume de trafic maximal
          </div>
        </div>
      </div>

      <!-- MAIN CHART -->
      <div class="rounded-lg bg-brand-darker border border-brand-gray p-6 sm:p-8">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-lg font-heading font-bold text-white">Évolution de la Fréquentation</h2>
            <p class="text-xs text-slate-400">Vues quotidiennes sur la période sélectionnée</p>
          </div>
          <div class="flex items-center gap-2 text-xs">
            <span class="inline-block w-3 h-3 rounded-sm bg-brand-red"></span>
            <span class="text-slate-300 font-semibold">Pages Vues</span>
          </div>
        </div>

        <div class="relative h-72 w-full">
          <canvas id="views-chart"></canvas>
        </div>
      </div>

      <!-- 2 COLUMNS BREAKDOWN -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- TOP PAGES -->
        <div class="rounded-lg bg-brand-darker border border-brand-gray p-6">
          <div class="flex items-center justify-between mb-6 border-b border-brand-gray/60 pb-4">
            <h3 class="text-base font-heading font-bold text-white flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              <span>Pages les plus visitées</span>
            </h3>
            <span class="text-xs text-slate-500 font-bold uppercase">Vues</span>
          </div>
          <div id="top-pages-list" class="space-y-3">
            <div class="text-xs text-slate-500 py-4 text-center">Chargement des données...</div>
          </div>
        </div>

        <!-- SOURCES & REFERRERS -->
        <div class="rounded-lg bg-brand-darker border border-brand-gray p-6">
          <div class="flex items-center justify-between mb-6 border-b border-brand-gray/60 pb-4">
            <h3 class="text-base font-heading font-bold text-white flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
              <span>Origine des Visiteurs (Provenance / Referrers)</span>
            </h3>
            <span class="text-xs text-slate-500 font-bold uppercase">Visites</span>
          </div>
          <div id="top-referrers-list" class="space-y-3">
            <div class="text-xs text-slate-500 py-4 text-center">Chargement des données...</div>
          </div>
        </div>

      </div>

      <!-- DEVICES & RECENT ACTIVITY -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Devices -->
        <div class="rounded-lg bg-brand-darker border border-brand-gray p-6">
          <h3 class="text-base font-heading font-bold text-white mb-6 border-b border-brand-gray/60 pb-4 flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
            <span>Appareils & Navigateurs</span>
          </h3>
          <div id="devices-breakdown" class="space-y-4">
            <!-- Filled by JS -->
          </div>
        </div>

        <!-- Recent Log Stream -->
        <div class="lg:col-span-2 rounded-lg bg-brand-darker border border-brand-gray p-6">
          <div class="flex items-center justify-between mb-6 border-b border-brand-gray/60 pb-4">
            <h3 class="text-base font-heading font-bold text-white flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              <span>Flux des Dernières Visites (Temps Réel)</span>
            </h3>
            <span class="text-[11px] text-brand-cyan font-bold uppercase">Anonymisé RGPD</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="text-slate-500 border-b border-brand-gray/50 pb-2">
                  <th class="pb-2 font-bold">Page</th>
                  <th class="pb-2 font-bold">Source</th>
                  <th class="pb-2 font-bold">Appareil</th>
                  <th class="pb-2 font-bold text-right">Moment</th>
                </tr>
              </thead>
              <tbody id="recent-stream" class="divide-y divide-brand-gray/30 text-slate-300">
                <!-- Filled by JS -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Section Demandes de Soumissions B2B & Messages -->
        <div class="lg:col-span-3 rounded-lg bg-brand-darker border border-brand-gray p-6">
          <div class="flex items-center justify-between mb-6 border-b border-brand-gray/60 pb-4">
            <h3 class="text-base font-heading font-bold text-white flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <span>Demandes de Soumissions B2B & Messages Reçus</span>
            </h3>
            <span id="leads-count-badge" class="px-2.5 py-1 rounded-sm text-xs font-bold bg-brand-red text-white">
              0 demande
            </span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="text-slate-400 border-b border-brand-gray/50 pb-2">
                  <th class="pb-3 font-bold">Date</th>
                  <th class="pb-3 font-bold">Type</th>
                  <th class="pb-3 font-bold">Organisation / Nom</th>
                  <th class="pb-3 font-bold">Coordonnées</th>
                  <th class="pb-3 font-bold">Prestation / Événement</th>
                  <th class="pb-3 font-bold">Participants / Budget</th>
                  <th class="pb-3 font-bold">Message</th>
                </tr>
              </thead>
              <tbody id="contacts-stream" class="divide-y divide-brand-gray/30 text-slate-300">
                <tr>
                  <td colspan="7" class="py-6 text-center text-slate-500">Chargement des demandes...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- Chart.js Script via official CDN -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script is:inline>
    let chartInstance = null;
    const TOKEN_KEY = 'ea_admin_token';

    function getToken() {
      return sessionStorage.getItem(TOKEN_KEY);
    }

    function setToken(token) {
      sessionStorage.setItem(TOKEN_KEY, token);
    }

    function clearToken() {
      sessionStorage.removeItem(TOKEN_KEY);
    }

    function checkAuth() {
      const token = getToken();
      const loginOverlay = document.getElementById('login-overlay');
      const dashboard = document.getElementById('admin-dashboard');

      if (token) {
        loginOverlay.classList.add('hidden');
        dashboard.classList.remove('hidden');
        loadStats();
      } else {
        loginOverlay.classList.remove('hidden');
        dashboard.classList.add('hidden');
      }
    }

    // Login Form Submit
    document.getElementById('login-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pass = (document.getElementById('admin-password').value || '').trim();
      const errBox = document.getElementById('login-error');
      errBox.classList.add('hidden');

      try {
        const res = await fetch('/api/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: pass }),
        });

        const data = await res.json();
        if (res.ok && data.success && data.token) {
          setToken(data.token);
          checkAuth();
        } else {
          errBox.textContent = data.error || 'Mot de passe incorrect';
          errBox.classList.remove('hidden');
        }
      } catch (err) {
        errBox.textContent = 'Erreur réseau, réessayez.';
        errBox.classList.remove('hidden');
      }
    });

    // Logout
    document.getElementById('logout-btn')?.addEventListener('click', () => {
      clearToken();
      checkAuth();
    });

    // Load Stats from API
    async function loadStats() {
      const token = getToken();
      if (!token) {
        checkAuth();
        return;
      }

      const rangeSelect = document.getElementById('time-range');
      const range = rangeSelect ? rangeSelect.value : '7d';

      try {
        const res = await fetch(`/api/stats?range=${encodeURIComponent(range)}`, {
          headers: {
            'Authorization': 'Bearer ' + token
          }
        });

        if (res.status === 401) {
          clearToken();
          checkAuth();
          return;
        }

        const data = await res.json();

        // Update KPIs with real data
        document.getElementById('stat-views').innerText = (data.totalViews || 0).toLocaleString('fr-CA');
        document.getElementById('stat-visitors').innerText = (data.uniqueVisitors || 0).toLocaleString('fr-CA');
        document.getElementById('stat-top-source').innerText = data.topReferrer || '-';
        document.getElementById('stat-top-page').innerText = data.topPage || '-';

        const periodLabelMap = {
          today: "Aujourd'hui",
          '7d': '7 derniers jours',
          '30d': '30 derniers jours',
          all: 'Historique complet'
        };
        const periodTag = document.getElementById('stat-period-tag');
        if (periodTag) {
          periodTag.innerText = `• ${periodLabelMap[range] || 'Période active'}`;
        }

        // Render Chart
        const canvas = document.getElementById('views-chart');
        if (canvas) {
          const ctx = canvas.getContext('2d');
          if (chartInstance) chartInstance.destroy();

          chartInstance = new Chart(ctx, {
            type: 'line',
            data: {
              labels: data.timeline.labels,
              datasets: [{
                label: 'Vues',
                data: data.timeline.values,
                borderColor: '#DB2E3C',
                backgroundColor: 'rgba(219, 46, 60, 0.15)',
                borderWidth: 3,
                fill: true,
                tension: 0.35,
                pointBackgroundColor: '#DB2E3C',
                pointRadius: 4,
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false }
              },
              scales: {
                x: {
                  grid: { color: 'rgba(255, 255, 255, 0.05)' },
                  ticks: { color: '#8A8D9F', font: { size: 11 } }
                },
                y: {
                  beginAtZero: true,
                  grid: { color: 'rgba(255, 255, 255, 0.05)' },
                  ticks: { color: '#8A8D9F', font: { size: 11 }, precision: 0 }
                }
              }
            }
          });
        }

        // Render Top Pages
        const pagesEl = document.getElementById('top-pages-list');
        if (pagesEl) {
          pagesEl.innerHTML = data.topPages.map(p => `
            <div class="flex items-center justify-between text-xs py-2 px-3 rounded-lg bg-brand-dark border border-brand-gray/50 hover:border-brand-gray transition-colors">
              <span class="font-mono text-slate-300 truncate max-w-[280px]">${p.path}</span>
              <span class="font-bold text-white px-2 py-0.5 rounded bg-brand-darker border border-slate-700">${p.count}</span>
            </div>
          `).join('') || '<div class="text-xs text-slate-500 text-center py-4">Aucune vue encore enregistrée.</div>';
        }

        // Render Top Referrers
        const refEl = document.getElementById('top-referrers-list');
        if (refEl) {
          refEl.innerHTML = data.topReferrers.map(r => `
            <div class="flex items-center justify-between text-xs py-2 px-3 rounded-lg bg-brand-dark border border-brand-gray/50 hover:border-brand-gray transition-colors">
              <span class="text-slate-300 font-semibold truncate max-w-[280px]">${r.source}</span>
              <span class="font-bold text-brand-cyan px-2 py-0.5 rounded bg-brand-darker border border-slate-700">${r.count}</span>
            </div>
          `).join('') || '<div class="text-xs text-slate-500 text-center py-4">Aucun référent externe détecté.</div>';
        }

        // Render Devices
        const devEl = document.getElementById('devices-breakdown');
        if (devEl) {
          const dev = data.devices || { mobile: 0, desktop: 0 };
          const totalDev = (dev.mobile + dev.desktop) || 1;
          const mobPct = Math.round((dev.mobile / totalDev) * 100);
          const deskPct = 100 - mobPct;

          devEl.innerHTML = `
            <div class="space-y-3">
              <div>
                <div class="flex justify-between text-xs mb-1">
                  <span class="text-slate-300">Mobile & Tablette</span>
                  <span class="font-bold text-white">${mobPct}% (${dev.mobile})</span>
                </div>
                <div class="w-full bg-brand-dark rounded-sm h-2 overflow-hidden">
                  <div class="bg-brand-red h-full rounded-sm" style="width: ${mobPct}%"></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between text-xs mb-1">
                  <span class="text-slate-300">Ordinateur (Desktop)</span>
                  <span class="font-bold text-white">${deskPct}% (${dev.desktop})</span>
                </div>
                <div class="w-full bg-brand-dark rounded-sm h-2 overflow-hidden">
                  <div class="bg-brand-cyan h-full rounded-sm" style="width: ${deskPct}%"></div>
                </div>
              </div>
            </div>
          `;
        }

        // Render Recent Stream
        const streamEl = document.getElementById('recent-stream');
        if (streamEl) {
          streamEl.innerHTML = data.recent.map(item => `
            <tr>
              <td class="py-2.5 font-mono text-slate-200">${item.path}</td>
              <td class="py-2.5 text-slate-400">${item.referrer}</td>
              <td class="py-2.5 text-slate-400">${item.device}</td>
              <td class="py-2.5 text-right text-slate-500">${item.time}</td>
            </tr>
          `).join('') || '<tr><td colspan="4" class="py-4 text-center text-slate-500">En attente de nouvelles visites...</td></tr>';
        }

        // Also load contacts
        loadContacts();

      } catch (err) {
        console.error('Failed to load stats:', err);
      }
    }

    async function loadContacts() {
      const token = getToken();
      if (!token) return;

      try {
        const res = await fetch('/api/contacts', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!res.ok) return;

        const data = await res.json();
        const contacts = data.contacts || [];

        const badgeEl = document.getElementById('leads-count-badge');
        if (badgeEl) {
          badgeEl.innerText = `${contacts.length} demande${contacts.length > 1 ? 's' : ''}`;
        }

        const tbody = document.getElementById('contacts-stream');
        if (tbody) {
          if (contacts.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="py-6 text-center text-slate-500">Aucune demande reçue pour le moment.</td></tr>';
          } else {
            tbody.innerHTML = contacts.map(c => {
              const isB2b = c.type === 'b2b';
              const dateStr = c.createdAt ? new Date(c.createdAt).toLocaleDateString('fr-CA', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-';
              return `
                <tr class="hover:bg-brand-dark/50 transition-colors">
                  <td class="py-3 text-slate-400 whitespace-nowrap">${dateStr}</td>
                  <td class="py-3">
                    <span class="px-2 py-0.5 rounded-sm text-[10px] font-bold uppercase tracking-wider ${isB2b ? 'bg-brand-red/20 text-brand-red border border-brand-red/30' : 'bg-brand-cyan/20 text-cyan-400 border border-brand-cyan/30'}">
                      ${isB2b ? 'B2B' : 'Coureur'}
                    </span>
                  </td>
                  <td class="py-3">
                    <div class="font-bold text-white">${c.name}</div>
                    ${c.organization ? `<div class="text-[11px] text-slate-400">${c.organization} (${c.orgType || 'Entité'})</div>` : ''}
                  </td>
                  <td class="py-3">
                    <a href="mailto:${c.email}" class="text-brand-cyan hover:underline block">${c.email}</a>
                    ${c.phone ? `<div class="text-slate-400 text-[11px]">${c.phone}</div>` : ''}
                  </td>
                  <td class="py-3">
                    <span class="font-medium text-slate-200">${c.service || c.subject || '-'}</span>
                  </td>
                  <td class="py-3 text-slate-300">
                    <div>${c.participants ? `Part. : ${c.participants}` : '-'}</div>
                    ${c.budget ? `<div class="text-emerald-400 text-[11px]">Budget : ${c.budget}</div>` : ''}
                  </td>
                  <td class="py-3 max-w-[240px]">
                    <div class="truncate text-slate-300 hover:text-white" title="${c.message}">${c.message}</div>
                  </td>
                </tr>
              `;
            }).join('');
          }
        }
      } catch (e) {
        console.error('Failed to load contacts:', e);
      }
    }

    document.getElementById('refresh-btn')?.addEventListener('click', () => {
      loadStats();
      loadContacts();
    });

    document.getElementById('time-range')?.addEventListener('change', () => {
      loadStats();
    });

    // Initial check
    checkAuth();
    setInterval(() => {
      if (getToken()) {
        loadStats();
        loadContacts();
      }
    }, 15000);
  </script>
  </div>

</Layout>
