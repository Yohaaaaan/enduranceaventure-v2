---
import Layout from '../layouts/Layout.astro';

const team = [
  {
    name: 'Daniel Poirier',
    role: 'Cofondateur, Directeur de la production télévisuelle',
    badge: 'Cofondateur & Réalisateur TV',
    badgeClass: 'bg-brand-cyan text-white',
    bio: 'Cofondateur d\'Endurance Aventure en 1998. Raideur passionné et triathlète longue distance, Daniel pilote la réalisation de documentaires sportifs et les tournages extrêmes en milieux hostiles diffusés sur les télévisions nationales.',
    image: '/assets/daniel-poirier-endurance-aventure.webp',
    fallback: '/assets/daniel-poirier-endurance-aventure.jpg',
    email: 'dpoirier@enduranceaventure.com',
    highlight: true,
  },
  {
    name: 'Jean-Thomas Boily',
    role: 'Cofondateur, Directeur des opérations & de la logistique',
    badge: 'Cofondateur & Logistique Terrain',
    badgeClass: 'bg-slate-900 text-white',
    bio: 'Cofondateur de l\'entreprise, skieur de fond paralympien et cycliste d\'élite. Jean-Thomas orchestre la logistique globale, la sécurité des parcours et l\'ingénierie terrain de chaque épreuve.',
    image: '/assets/jean-thomas-boily.webp',
    fallback: '/assets/jean-thomas-boily.jpg',
    email: 'jtboily@enduranceaventure.com',
    highlight: true,
  },
  {
    name: 'Bastien Michau',
    role: 'Associé, Directeur de course & Dessinateur de parcours',
    badge: 'Directeur de course & Associé',
    badgeClass: 'bg-brand-red text-white',
    bio: 'Guide spéléo et canyon, raideur d\'expédition et orienteur chevronné. Figure incontournable du raid aventure en Amérique du Nord, Bastien conçoit et supervise les tracés les plus exigeants, notamment le Raid Témiscamingue et le premier Championnat du monde junior de raid aventure (ARWS).',
    image: '/assets/bastien-michau.webp',
    fallback: '/assets/bastien-michau.jpg',
    email: 'bmichau@enduranceaventure.com',
    highlight: true,
  },
  {
    name: 'Marc Plante',
    role: 'Associé, Producteur exécutif & Distribution',
    badge: 'Producteur Exécutif & Associé',
    badgeClass: 'bg-slate-800 text-white',
    bio: 'Associé depuis 2017. Passionné de hockey et de sport d\'équipe, Marc assure la production exécutive des projets documentaires et développe les partenariats de distribution internationale.',
    image: '/assets/marc-plante.webp',
    fallback: '/assets/marc-plante.jpg',
    email: 'mplante@enduranceaventure.com',
    highlight: false,
  },
  {
    name: 'Patricia Desgagné',
    role: 'Relations médias & Athlètes internationaux',
    badge: 'Relations Médias & Accueil',
    badgeClass: 'bg-slate-700 text-white',
    bio: 'Anthropologue et polyglotte, Patricia coordonne l\'accueil et l\'accompagnement des délégations internationales, des équipes d\'expédition et des journalistes étrangers.',
    image: '/assets/patricia-desgagne.webp',
    fallback: '/assets/patricia-desgagne.jpg',
    email: 'pdesgagne@enduranceaventure.com',
    highlight: false,
  },
];
---

<Layout 
  title="Experts en Ingénierie Sportive & Expédition depuis 1998 | Endurance Aventure" 
  description="Fondée en 1998 au Québec par Jean-Thomas Boily et Daniel Poirier, rejoints par Bastien Michau et Marc Plante. L'équipe pionnière de l'événementiel d'aventure."
  image="/assets/bastien-michau.webp"
>
  
  <!-- En-tête de page immersif avec photo authentique Endurance Aventure -->
  <header class="relative min-h-[50vh] sm:min-h-[58vh] flex items-center bg-slate-950 border-b border-slate-800 overflow-hidden">
    <img 
      src="/assets/51581835318_775ae15a4e_k.webp" 
      alt="L'histoire et les expéditions de terrain d'Endurance Aventure depuis 1998" 
      class="absolute inset-0 w-full h-full object-cover object-center opacity-95 brightness-95 contrast-105"
      onerror="this.src='/assets/28514399477_3839a9ca93_o-scaled.webp'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-black/20 to-black/20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/50 via-transparent to-transparent"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-16 sm:py-24">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-slate-900 border-l-2 border-brand-red text-slate-200 text-xs font-heading font-bold uppercase tracking-wider mb-5">
        <span>Histoire & Gouvernance (Depuis 1998)</span>
      </div>
      <h1 class="text-3xl sm:text-6xl font-heading font-black uppercase text-white mb-6 drop-shadow-lg">
        L'Entreprise & L'Équipe
      </h1>
      <p class="max-w-3xl text-base sm:text-lg text-slate-100 font-normal leading-relaxed drop-shadow-md mb-4">
        Créée en 1998 au Québec, Endurance Aventure collabore avec les régions pour concevoir et produire des événements sportifs d’envergure internationale qui mettent en valeur leurs territoires d’exception. Bien plus que des compétitions, ces événements deviennent de véritables leviers de rayonnement touristique, de promotion territoriale et de développement économique local, amplifiés par des productions télévisuelles diffusées à travers le monde.
      </p>
    </div>
  </header>

  <!-- Contenu Principal sur Fond Clair pour lisibilité optimale -->
  <div class="bg-slate-50 py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      
      <!-- Histoire et Genèse -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-7 bg-white rounded-lg border border-slate-200 p-8 sm:p-10 shadow-sm space-y-6 text-slate-700 leading-relaxed text-sm sm:text-base">
          <h2 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900">
            Révéler le potentiel des grands espaces québécois
          </h2>
          <p>
            Fondée en 1998 par <strong class="text-slate-900 font-semibold">Jean-Thomas Boily</strong> et <strong class="text-slate-900 font-semibold">Daniel Poirier</strong>, Endurance Aventure rassemble les passionnés de sports d’endurance autour d’événements uniques, à la découverte de territoires exceptionnels et de communautés inspirantes. En 2017, Bastien Michau et Marc Plante rejoignent la direction comme associés, renforçant son rayonnement international.
          </p>
          <p>
            Aujourd'hui, Endurance Aventure cumule plus de <strong class="text-slate-900 font-semibold">10 000 km de parcours balisés</strong>, des dizaines d'événements majeurs (GBC 500, Championnat du Monde Junior ARWS Témiscamingue, Raid International Gaspésie, Canada Man/Woman Xtri, Raid International China, Traversée internationale du Lac Memphrémagog) et mobilise un réseau de <strong class="text-slate-900 font-semibold">150 professionnels de terrain</strong> (traceurs, secouristes d'expédition, cadreurs tout-terrain, logisticiens).
          </p>
          <p>
            Parallèlement aux épreuves sportives, notre équipe audiovisuelle produit des émissions et documentaires d'aventure captivants pour les diffuseurs télévisuels et le web, offrant aux régions hôtes une vitrine d'attractivité touristique majeure.
          </p>
        </div>

        <div class="lg:col-span-5 bg-white rounded-lg border border-slate-200 p-8 shadow-sm space-y-6">
          <h3 class="text-lg font-heading font-bold text-slate-900 border-l-2 border-brand-red pl-3">
            Repères & Chiffres Clés
          </h3>
          <dl class="space-y-4 text-xs sm:text-sm">
            <div class="border-b border-slate-100 pb-3">
              <dt class="text-slate-500 font-medium">Fondation</dt>
              <dd class="text-slate-900 font-bold text-base mt-0.5">1998 au Québec (Plus de 25 ans d'activité)</dd>
            </div>
            <div class="border-b border-slate-100 pb-3">
              <dt class="text-slate-500 font-medium">Parcours tracés & validés</dt>
              <dd class="text-slate-900 font-bold text-base mt-0.5">+ 10 000 kilomètres en pleine nature</dd>
            </div>
            <div class="border-b border-slate-100 pb-3">
              <dt class="text-slate-500 font-medium">Équipe de direction</dt>
              <dd class="text-slate-900 font-bold text-base mt-0.5">Daniel Poirier, Jean-Thomas Boily, Bastien Michau, Marc Plante</dd>
            </div>
            <div>
              <dt class="text-slate-500 font-medium">Siège opérationnel</dt>
              <dd class="text-slate-900 font-bold text-base mt-0.5">Magog, Cantons-de-l'Est, Québec, Canada</dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Direction & Membres Clés -->
      <div>
        <div class="mb-12">
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-1">Expertise Terrain</span>
          <h2 class="text-2xl sm:text-4xl font-heading font-black uppercase text-slate-900">
            L'Équipe de Direction
          </h2>
          <p class="text-sm text-slate-600 mt-2">
            Des athlètes d'endurance, guides de haute nature et producteurs au service de vos défis.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-5">
          {team.map((member) => (
            <div class={`rounded-lg bg-white border overflow-hidden flex flex-col justify-between transition-all duration-300 shadow-sm ${member.highlight ? 'border-slate-300 hover:border-brand-red hover:shadow-lg' : 'border-slate-200 hover:border-slate-300 hover:shadow-md'}`}>
              <div>
                <div class="h-48 sm:h-52 overflow-hidden bg-slate-200 relative">
                  <img 
                    src={member.image} 
                    alt={member.name} 
                    class="w-full h-full object-cover object-top transition-all duration-300 hover:scale-105"
                    onerror={`this.src='${member.fallback}'`}
                  />
                  <span class={`absolute top-2 right-2 px-2 py-0.5 rounded-sm ${member.badgeClass || 'bg-slate-900 text-white'} text-[10px] font-bold uppercase tracking-wider shadow-sm`}>
                    {member.badge}
                  </span>
                </div>
                <div class="p-4 sm:p-5">
                  <h3 class="text-base sm:text-lg font-heading font-bold text-slate-900 mb-1">
                    {member.name}
                  </h3>
                  <div class="text-[11px] font-bold text-brand-cyan mb-3 font-heading uppercase tracking-wider line-clamp-2">
                    {member.role}
                  </div>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    {member.bio}
                  </p>
                </div>
              </div>

              <div class="px-4 sm:px-5 pb-4 pt-1">
                <a 
                  href={`mailto:${member.email}`} 
                  class="text-[11px] font-semibold text-slate-500 hover:text-brand-red flex items-center gap-1.5 transition-colors truncate"
                  title={member.email}
                >
                  <svg class="w-3 h-3 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <span class="truncate">{member.email}</span>
                </a>
              </div>
            </div>
          ))}
      </div>

      <!-- Piliers Opérationnels Authentiques (Remplacement des 4 emojis génériques) -->
      <div class="bg-white rounded-lg border border-slate-200 p-8 sm:p-12 shadow-sm">
        <div class="max-w-2xl mb-10">
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-1">Standards de Terrain</span>
          <h3 class="text-2xl font-heading font-bold text-slate-900 mb-3">Nos Piliers Opérationnels</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Chez Endurance Aventure, chaque défi est construit avec une rigueur logistique éprouvée et un ancrage profond dans les communautés québécoises hôtes.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="p-6 rounded-md bg-slate-50 border border-slate-200">
            <div class="text-brand-red font-heading font-black text-xl mb-2">01. Sécurité en Milieu Isolé</div>
            <div class="text-xs text-slate-600 leading-relaxed">Protocoles d'évacuation d'urgence, coordination avec les services de secours locaux et liaisons radio tout-terrain.</div>
          </div>
          <div class="p-6 rounded-md bg-slate-50 border border-slate-200">
            <div class="text-brand-cyan font-heading font-black text-xl mb-2">02. Concertation Territoriale</div>
            <div class="text-xs text-slate-600 leading-relaxed">Ententes officielles avec la Sépaq, les MRC et les municipalités. Respect strict de l'éthique « Sans Trace » en nature.</div>
          </div>
          <div class="p-6 rounded-md bg-slate-50 border border-slate-200">
            <div class="text-slate-900 font-heading font-black text-xl mb-2">03. Formation de la Relève</div>
            <div class="text-xs text-slate-600 leading-relaxed">Organisation du Championnat du monde junior de raid aventure (ARWS Youth) et inclusion des jeunes athlètes.</div>
          </div>
          <div class="p-6 rounded-md bg-slate-50 border border-slate-200">
            <div class="text-brand-red font-heading font-black text-xl mb-2">04. Ingénierie de Tracés</div>
            <div class="text-xs text-slate-600 leading-relaxed">+10 000 km explorés et validés par nos directeurs de course pour offrir des parcours inédits, équilibrés et sécuritaires.</div>
          </div>
        </div>
      </div>

      <!-- Section CTA légère & raffinée -->
      <div class="rounded-2xl bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 border border-slate-800 p-8 sm:p-12 text-white shadow-xl relative overflow-hidden">
        <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-brand-red/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-8">
          <div class="max-w-2xl">
            <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest block mb-2 font-heading">
              Collaboration & Projets
            </span>
            <h3 class="text-2xl sm:text-3xl font-heading font-black uppercase text-white mb-3">
              Un projet d'expédition, un événement ou une production télé ?
            </h3>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
              Mettez plus de 25 ans d'expertise terrain, de logistique d'expédition et de captation extrême au service de votre vision.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 flex-shrink-0">
            <a 
              href="/contact/" 
              class="px-7 py-3.5 rounded-lg bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-xs uppercase tracking-wider transition-all shadow-lg shadow-brand-red/25 text-center flex items-center justify-center gap-2"
            >
              <span>Échanger avec notre équipe</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <a 
              href="/services/" 
              class="px-6 py-3.5 rounded-lg bg-slate-800/80 hover:bg-slate-800 text-slate-200 border border-slate-700 font-heading font-bold text-xs uppercase tracking-wider transition-all text-center"
            >
              Découvrir nos services
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>

</Layout>
