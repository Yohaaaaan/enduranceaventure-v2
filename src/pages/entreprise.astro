---
import Layout from '../layouts/Layout.astro';

const team = [
  {
    name: 'Bastien Michau',
    role: 'Associé, Directeur de course & Dessinateur de parcours',
    badge: 'Directeur de course & Associé',
    badgeClass: 'bg-brand-red text-white',
    bio: 'Guide spéléo et canyon, raideur d\'expédition et orienteur chevronné. Figure incontournable du raid aventure en Amérique du Nord, Bastien conçoit et supervise les tracés les plus exigeants, notamment le Raid Témiscamingue et le premier Championnat du monde junior de raid aventure (ARWS).',
    image: '/assets/bastien-michau.webp',
    fallback: '/assets/bastien-michau.jpg',
    email: 'bmichau@enduranceaventure.com',
    highlight: true,
  },
  {
    name: 'Daniel Poirier',
    role: 'Cofondateur, Directeur de la production télévisuelle',
    badge: 'Cofondateur & Réalisateur TV',
    badgeClass: 'bg-brand-cyan text-white',
    bio: 'Cofondateur d\'Endurance Aventure en 1998. Raideur passionné et triathlète longue distance, Daniel pilote la réalisation de documentaires sportifs et les tournages extrêmes en milieux hostiles diffusés sur les télévisions nationales.',
    image: '/assets/daniel-poirier-endurance-aventure.webp',
    fallback: '/assets/daniel-poirier-endurance-aventure.jpg',
    email: 'dpoirier@enduranceaventure.com',
    highlight: true,
  },
  {
    name: 'Jean-Thomas Boily',
    role: 'Cofondateur, Directeur des opérations & de la logistique',
    badge: 'Cofondateur & Logistique Terrain',
    badgeClass: 'bg-slate-900 text-white',
    bio: 'Cofondateur de l\'entreprise, skieur de fond paralympien et cycliste d\'élite. Jean-Thomas orchestre la logistique globale, la sécurité des parcours et l\'ingénierie terrain de chaque épreuve.',
    image: '/assets/jean-thomas-boily.webp',
    fallback: '/assets/jean-thomas-boily.jpg',
    email: 'jtboily@enduranceaventure.com',
    highlight: true,
  },
  {
    name: 'Marc Plante',
    role: 'Associé, Producteur exécutif & Distribution',
    badge: 'Producteur Exécutif & Associé',
    badgeClass: 'bg-slate-800 text-white',
    bio: 'Associé depuis 2017. Passionné de hockey et de sport d\'équipe, Marc assure la production exécutive des projets documentaires et développe les partenariats de distribution internationale.',
    image: '/assets/marc-plante.webp',
    fallback: '/assets/marc-plante.jpg',
    email: 'mplante@enduranceaventure.com',
    highlight: false,
  },
  {
    name: 'Patricia Desgagné',
    role: 'Relations médias & Athlètes internationaux',
    badge: 'Relations Médias & Accueil',
    badgeClass: 'bg-slate-700 text-white',
    bio: 'Anthropologue et polyglotte, Patricia coordonne l\'accueil et l\'accompagnement des délégations internationales, des équipes d\'expédition et des journalistes étrangers.',
    image: '/assets/patricia-desgagne.webp',
    fallback: '/assets/patricia-desgagne.jpg',
    email: 'pdesgagne@enduranceaventure.com',
    highlight: false,
  },
];
---

<Layout 
  title="L'Entreprise & L'Équipe | Endurance Aventure" 
  description="Fondée en 1998 au Québec par Jean-Thomas Boily et Daniel Poirier, rejoints par Bastien Michau et Marc Plante. Découvrez l'histoire et les visages d'Endurance Aventure."
  image="/assets/bastien-michau.webp"
>
  
  <!-- En-tête de page sobre et sombre (Action & prestige) -->
  <div class="bg-slate-950 py-16 sm:py-20 border-b border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Histoire & Gouvernance</span>
      <h1 class="text-3xl sm:text-5xl font-heading font-black uppercase text-white mb-4">
        L'Entreprise & L'Équipe
      </h1>
      <p class="max-w-3xl text-base sm:text-lg text-slate-300 font-light leading-relaxed">
        Créée en 1998 au Québec, Endurance Aventure transforme les territoires sauvages en théâtres d'épreuves d'endurance d'envergure internationale et produit des images d'expédition diffusées à travers le monde.
      </p>
    </div>
  </div>

  <!-- Contenu Principal sur Fond Clair pour lisibilité optimale -->
  <div class="bg-slate-50 py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      
      <!-- Histoire et Genèse -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-7 bg-white rounded-3xl border border-slate-200 p-8 sm:p-10 shadow-sm space-y-6 text-slate-700 leading-relaxed text-sm sm:text-base">
          <h2 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900">
            Révéler le potentiel des grands espaces québécois
          </h2>
          <p>
            Fondée en 1998 par <strong class="text-slate-900 font-semibold">Jean-Thomas Boily</strong> et <strong class="text-slate-900 font-semibold">Daniel Poirier</strong>, Endurance Aventure s'est bâtie sur le terrain, en explorant les cours d'eau, les forêts denses et les massifs montagneux du Canada. En 2017, <strong class="text-slate-900 font-semibold">Bastien Michau</strong> et <strong class="text-slate-900 font-semibold">Marc Plante</strong> ont rejoint la direction en tant qu'associés, propulsant le rayonnement international de l'organisation.
          </p>
          <p>
            Aujourd'hui, Endurance Aventure cumule plus de <strong class="text-slate-900 font-semibold">10 000 km de parcours balisés</strong>, des dizaines d'événements majeurs (GBC 500, Raid International Gaspésie, Raid Témiscamingue, Trail des Neiges, Canada Man/Woman Xtri) et mobilise un réseau de <strong class="text-slate-900 font-semibold">150 professionnels de terrain</strong> (traceurs, secouristes d'expédition, cadreurs tout-terrain, logisticiens).
          </p>
          <p>
            Parallèlement aux épreuves sportives, notre division audiovisuelle produit des émissions et documentaires d'aventure captivants pour les diffuseurs télévisuels et le web, offrant aux régions hôtes une vitrine d'attractivité touristique majeure.
          </p>
        </div>

        <div class="lg:col-span-5 bg-white rounded-3xl border border-slate-200 p-8 shadow-sm space-y-6">
          <h3 class="text-lg font-heading font-bold text-slate-900 border-l-2 border-brand-red pl-3">
            Repères & Chiffres Clés
          </h3>
          <dl class="space-y-4 text-xs sm:text-sm">
            <div class="border-b border-slate-100 pb-3">
              <dt class="text-slate-500 font-medium">Fondation</dt>
              <dd class="text-slate-900 font-bold text-base mt-0.5">1998 au Québec (Plus de 25 ans d'activité)</dd>
            </div>
            <div class="border-b border-slate-100 pb-3">
              <dt class="text-slate-500 font-medium">Parcours tracés & validés</dt>
              <dd class="text-slate-900 font-bold text-base mt-0.5">+ 10 000 kilomètres en pleine nature</dd>
            </div>
            <div class="border-b border-slate-100 pb-3">
              <dt class="text-slate-500 font-medium">Équipe de direction</dt>
              <dd class="text-slate-900 font-bold text-base mt-0.5">Jean-Thomas Boily, Daniel Poirier, Bastien Michau, Marc Plante</dd>
            </div>
            <div>
              <dt class="text-slate-500 font-medium">Siège opérationnel</dt>
              <dd class="text-slate-900 font-bold text-base mt-0.5">Magog, Cantons-de-l'Est, Québec, Canada</dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- GALERIE PATRIMOINE VISUEL (25 ans d'expéditions & d'émotions brutes) -->
      <div>
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest block mb-2">Histoire de Terrain</span>
          <h3 class="text-2xl sm:text-3xl font-heading font-black uppercase text-slate-900">
            25 Ans d'Exploration & d'Épreuves Hors Norme
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2">
            De la baie des Chaleurs aux crêtes de Mégantic, nos caméras et nos équipes ont façonné la légende du plein air au Québec.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          <div class="group rounded-2xl overflow-hidden bg-slate-200 shadow-md relative h-72">
            <img 
              src="/assets/canadaman-2017-lac-megantic-ligne-depart-nuit-1920x718.jpg" 
              alt="Départ de nuit du Canada Man à Lac-Mégantic" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-3 text-white text-xs font-bold">Canada Man/Woman • Nuit de Lac-Mégantic</span>
          </div>

          <div class="group rounded-2xl overflow-hidden bg-slate-200 shadow-md relative h-72">
            <img 
              src="/assets/raid-international-gaspesie-2017-canot-carleton-sur-mer-freres-theriault-wtogumi-1920x1280.jpg" 
              alt="Raid International Gaspésie en mer" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-3 text-white text-xs font-bold">Raid Gaspésie • Canot en mer</span>
          </div>

          <div class="group rounded-2xl overflow-hidden bg-slate-200 shadow-md relative h-72">
            <img 
              src="/assets/gravelbike-grange-scaled.webp" 
              alt="GBC 500 dans les Cantons-de-l'Est" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-3 text-white text-xs font-bold">GBC 500 • Les Cantons-de-l'Est</span>
          </div>

          <div class="group rounded-2xl overflow-hidden bg-slate-200 shadow-md relative h-72">
            <img 
              src="/assets/TDN-2018-Trail-des-Neiges-D%C3%A9part1.webp" 
              alt="Trail des Neiges au Mont-Orford" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='/assets/51581835318_775ae15a4e_k.webp'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-3 text-white text-xs font-bold">Trail des Neiges • Mont-Orford</span>
          </div>
        </div>
      </div>

      <!-- Direction & Membres Clés -->
      <div>
        <div class="mb-12">
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-1">Expertise Terrain</span>
          <h2 class="text-2xl sm:text-4xl font-heading font-black uppercase text-slate-900">
            L'Équipe de Direction
          </h2>
          <p class="text-sm text-slate-600 mt-2">
            Des athlètes d'endurance, guides de haute nature et producteurs au service de vos défis.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {team.map((member) => (
            <div class={`rounded-2xl bg-white border overflow-hidden flex flex-col justify-between transition-all duration-300 shadow-sm ${member.highlight ? 'border-slate-300 hover:border-brand-red hover:shadow-xl' : 'border-slate-200 hover:border-slate-300 hover:shadow-md'}`}>
              <div>
                <div class="h-64 overflow-hidden bg-slate-200 relative">
                  <img 
                    src={member.image} 
                    alt={member.name} 
                    class="w-full h-full object-cover object-top transition-all duration-300 hover:scale-105"
                    onerror={`this.src='${member.fallback}'`}
                  />
                  <span class={`absolute top-3 right-3 px-2.5 py-1 rounded ${member.badgeClass || 'bg-slate-900 text-white'} text-[11px] font-bold uppercase tracking-wider shadow-md backdrop-blur-sm`}>
                    {member.badge}
                  </span>
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-heading font-bold text-slate-900 mb-1">
                    {member.name}
                  </h3>
                  <div class="text-xs font-bold text-brand-cyan mb-4">
                    {member.role}
                  </div>
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                    {member.bio}
                  </p>
                </div>
              </div>

              <div class="px-6 pb-6 pt-2">
                <a 
                  href={`mailto:${member.email}`} 
                  class="text-xs font-semibold text-slate-500 hover:text-brand-red flex items-center gap-1.5 transition-colors"
                >
                  <svg class="w-3.5 h-3.5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <span>{member.email}</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Piliers Opérationnels Authentiques (Remplacement des 4 emojis génériques) -->
      <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm">
        <div class="max-w-2xl mb-10">
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-1">Standards de Terrain</span>
          <h3 class="text-2xl font-heading font-bold text-slate-900 mb-3">Nos Piliers Opérationnels</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Chez Endurance Aventure, chaque défi est construit avec une rigueur logistique éprouvée et un ancrage profond dans les communautés québécoises hôtes.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="text-brand-red font-heading font-black text-xl mb-2">01. Sécurité en Milieu Isolé</div>
            <div class="text-xs text-slate-600 leading-relaxed">Protocoles d'évacuation d'urgence, coordination avec les services de secours locaux et liaisons radio tout-terrain.</div>
          </div>
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="text-brand-cyan font-heading font-black text-xl mb-2">02. Concertation Territoriale</div>
            <div class="text-xs text-slate-600 leading-relaxed">Ententes officielles avec la Sépaq, les MRC et les municipalités. Respect strict de l'éthique « Sans Trace » en nature.</div>
          </div>
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="text-slate-900 font-heading font-black text-xl mb-2">03. Formation de la Relève</div>
            <div class="text-xs text-slate-600 leading-relaxed">Organisation du Championnat du monde junior de raid aventure (ARWS Youth) et inclusion des jeunes athlètes.</div>
          </div>
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="text-brand-red font-heading font-black text-xl mb-2">04. Ingénierie de Tracés</div>
            <div class="text-xs text-slate-600 leading-relaxed">+10 000 km explorés et validés par nos directeurs de course pour offrir des parcours inédits, équilibrés et sécuritaires.</div>
          </div>
        </div>
      </div>

    </div>
  </div>

</Layout>
