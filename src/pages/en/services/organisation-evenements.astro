---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="Turnkey Sporting Event Organization in Quebec | Endurance Aventure" 
  description="Route engineering, wilderness expedition logistics, starting corrals, and emergency safety plans for large-scale races and corporate challenges in Quebec."
  image="/assets/organisation-evenements-sportifs-services-endurance-aventure.jpg"
  lang="en"
>
  <!-- Immersive Dark Header with Real Field Logistics Photo -->
  <header class="relative min-h-[48vh] sm:min-h-[55vh] flex items-center bg-slate-950 border-b border-slate-800 overflow-hidden">
    <img 
      src="/assets/51581607901_c23c63d19b_k.webp" 
      alt="Sporting event organization and large-scale logistics" 
      class="absolute inset-0 w-full h-full object-cover object-center opacity-90 brightness-95 contrast-105"
      onerror="this.src='/assets/organisation-evenements-sportifs-services-endurance-aventure.jpg'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-black/20 to-black/20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/50 via-transparent to-transparent"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-16 sm:py-20 w-full">
      <a href="/en/services/organisation-evenements/" class="text-xs text-brand-cyan hover:text-white font-bold uppercase tracking-wider mb-4 inline-flex items-center gap-1.5 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span>Pro Services</span>
      </a>
      <h1 class="text-3xl sm:text-5xl font-heading font-black uppercase text-white mb-4 drop-shadow-lg">
        Sporting Event Organization
      </h1>
      <p class="text-base sm:text-lg text-slate-100 font-normal leading-relaxed drop-shadow-md max-w-3xl">
        Comprehensive logistical, technical, and safety management for large-scale endurance races and custom corporate expeditions.
      </p>
    </div>
  </header>

  <!-- Main Content -->
  <div class="bg-slate-50 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- High-res illustrative photo -->
      <div class="rounded-lg overflow-hidden mb-12 shadow-md border border-slate-200 h-[420px] bg-slate-900 relative group">
        <img 
          src="/assets/canadaman-2017-sommet-mont-megantic-ligne-arrivee.webp" 
          alt="Summit finish line atop Mont-Mégantic - Canada Man / Canada Woman XTRI Triathlon" 
          class="w-full h-full object-cover object-center group-hover:scale-102 transition-transform duration-500"
          onerror="this.src='/assets/canadaman-2017-sommet-mont-megantic-ligne-arrivee.jpg'"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
        <div class="absolute bottom-4 left-6 right-6 text-white flex items-center justify-between">
          <div>
            <span class="text-xs uppercase font-bold tracking-wider text-brand-red">Iconic Stage Finish</span>
            <div class="text-sm sm:text-base font-bold">Summit Finish Arch • Panoramic view over Quebec's mountain peaks</div>
          </div>
        </div>
      </div>

      <!-- Main Body -->
      <div class="bg-white rounded-lg border border-slate-200 p-8 sm:p-12 shadow-sm space-y-8">
        <div>
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Turnkey Expertise</span>
          <h2 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900 mb-4">
            About 28 Years of Proven Wilderness Experience
          </h2>
          <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
            Endurance Aventure supports your event from concept to completion, whether organizing official competitions for hundreds of athletes or designing bespoke corporate challenges that build lasting team cohesion.
          </p>
        </div>

        <!-- 4 Domains of Expertise Grid (2 columns on mobile) -->
        <div class="grid grid-cols-2 gap-2.5 sm:gap-6 my-6 sm:my-8">
          <div class="bg-slate-50 p-3 sm:p-6 rounded-md border border-slate-200">
            <h3 class="font-heading font-bold text-slate-900 text-xs sm:text-base mb-1 sm:mb-2">Course Engineering</h3>
            <p class="text-[11px] sm:text-sm text-slate-600 leading-relaxed font-light line-clamp-4 sm:line-clamp-none">GPS route design, land access, environmental compliance, and trail marking.</p>
          </div>
          
          <div class="bg-slate-50 p-3 sm:p-6 rounded-md border border-slate-200">
            <h3 class="font-heading font-bold text-slate-900 text-xs sm:text-base mb-1 sm:mb-2">Safety Protocols</h3>
            <p class="text-[11px] sm:text-sm text-slate-600 leading-relaxed font-light line-clamp-4 sm:line-clamp-none">Wilderness first-response, VHF radio networks, and paramedic coordination.</p>
          </div>
          
          <div class="bg-slate-50 p-3 sm:p-6 rounded-md border border-slate-200">
            <h3 class="font-heading font-bold text-slate-900 text-xs sm:text-base mb-1 sm:mb-2">Aid Stations</h3>
            <p class="text-[11px] sm:text-sm text-slate-600 leading-relaxed font-light line-clamp-4 sm:line-clamp-none">Remote aid stations, ephemeral bivouacs, and customized sports nutrition.</p>
          </div>
          
          <div class="bg-slate-50 p-3 sm:p-6 rounded-md border border-slate-200">
            <h3 class="font-heading font-bold text-slate-900 text-xs sm:text-base mb-1 sm:mb-2">Registration & Desk</h3>
            <p class="text-[11px] sm:text-sm text-slate-600 leading-relaxed font-light line-clamp-4 sm:line-clamp-none">Online registration platforms, athlete check-in, and gear inspections.</p>
          </div>
        </div>

        <!-- Carousel -->
        <div class="pt-6 border-t border-slate-100">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
            <div>
              <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-1">Field Proof</span>
              <h3 class="text-xl sm:text-2xl font-heading font-bold text-slate-900">
                Our Event Achievements in Photos
              </h3>
              <p class="text-xs text-slate-500 mt-1">Extreme Triathlons, Adventure Raids, GBC 500 Gravel Bikepacking, and Summit Finishes.</p>
            </div>
            
            <!-- Controls -->
            <div class="flex items-center gap-2 flex-shrink-0">
              <button 
                id="carousel-prev-btn"
                type="button" 
                class="w-11 h-11 min-h-[44px] min-w-[44px] rounded-md bg-slate-100 hover:bg-brand-red hover:text-white border border-slate-300 flex items-center justify-center text-slate-700 transition-colors shadow-sm"
                aria-label="Previous photo"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              </button>
              <button 
                id="carousel-next-btn"
                type="button" 
                class="w-11 h-11 min-h-[44px] min-w-[44px] rounded-md bg-slate-100 hover:bg-brand-red hover:text-white border border-slate-300 flex items-center justify-center text-slate-700 transition-colors shadow-sm"
                aria-label="Next photo"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </button>
            </div>
          </div>

          <!-- Carousel Track -->
          <div 
            id="event-photo-carousel" 
            class="flex gap-4 overflow-x-auto pb-4 scroll-smooth snap-x snap-mandatory"
            style="scrollbar-width: thin;"
          >
            <div class="min-w-[280px] sm:min-w-[340px] flex-shrink-0 snap-start rounded-lg overflow-hidden bg-slate-900 border border-slate-200 shadow-sm group">
              <div class="h-64 overflow-hidden relative">
                <img src="/assets/51581607901_c23c63d19b_k.webp" alt="Canada Man extreme triathlon swim start" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            </div>

            <div class="min-w-[280px] sm:min-w-[340px] flex-shrink-0 snap-start rounded-lg overflow-hidden bg-slate-900 border border-slate-200 shadow-sm group">
              <div class="h-64 overflow-hidden relative">
                <img src="/assets/51582278409_86672a9a9f_k.webp" alt="Mountain biking on ridge during International Raid" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            </div>

            <div class="min-w-[280px] sm:min-w-[340px] flex-shrink-0 snap-start rounded-lg overflow-hidden bg-slate-900 border border-slate-200 shadow-sm group">
              <div class="h-64 overflow-hidden relative">
                <img src="/assets/2023-08-05_GBC500_mc_1498-scaled.webp" alt="GBC 500 gravel bikepacking on backcountry forest road" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            </div>

            <div class="min-w-[280px] sm:min-w-[340px] flex-shrink-0 snap-start rounded-lg overflow-hidden bg-slate-900 border border-slate-200 shadow-sm group">
              <div class="h-64 overflow-hidden relative">
                <img src="/assets/Course-a-pied-scaled.webp" alt="Runners in action during endurance challenge" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            </div>

            <div class="min-w-[280px] sm:min-w-[340px] flex-shrink-0 snap-start rounded-lg overflow-hidden bg-slate-900 border border-slate-200 shadow-sm group">
              <div class="h-64 overflow-hidden relative">
                <img src="/assets/53061653539_951fb49b59_k.webp" alt="Race setup and athlete transition zone" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            </div>

            <div class="min-w-[280px] sm:min-w-[340px] flex-shrink-0 snap-start rounded-lg overflow-hidden bg-slate-900 border border-slate-200 shadow-sm group">
              <div class="h-64 overflow-hidden relative">
                <img src="/assets/gravelbike-gbc500-1-scaled.webp" alt="Gravel cyclist climbing mountain road" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            </div>

            <div class="min-w-[280px] sm:min-w-[340px] flex-shrink-0 snap-start rounded-lg overflow-hidden bg-slate-900 border border-slate-200 shadow-sm group">
              <div class="h-64 overflow-hidden relative">
                <img src="/assets/51588664244_a5ca30eb5d_k-2.webp" alt="Trail runners racing through pristine wilderness at sunset" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            </div>

            <div class="min-w-[280px] sm:min-w-[340px] flex-shrink-0 snap-start rounded-lg overflow-hidden bg-slate-900 border border-slate-200 shadow-sm group">
              <div class="h-64 overflow-hidden relative">
                <img src="/assets/28514399477_3839a9ca93_o-scaled.webp" alt="Technical mountain biking in boreal backcountry" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            </div>

            <div class="min-w-[280px] sm:min-w-[340px] flex-shrink-0 snap-start rounded-lg overflow-hidden bg-slate-900 border border-slate-200 shadow-sm group">
              <div class="h-64 overflow-hidden relative">
                <img src="/assets/51582517360_5ace9e0494_k-2.webp" alt="Endurance trail runners pushing beyond limits" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            </div>

            <div class="min-w-[280px] sm:min-w-[340px] flex-shrink-0 snap-start rounded-lg overflow-hidden bg-slate-900 border border-slate-200 shadow-sm group">
              <div class="h-64 overflow-hidden relative">
                <img src="/assets/arws-junior-world-photo1.webp" alt="Youth adventure racers on the world championship course" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            </div>
          </div>
        </div>

        <script is:inline>
          const carousel = document.getElementById('event-photo-carousel');
          const prevBtn = document.getElementById('carousel-prev-btn');
          const nextBtn = document.getElementById('carousel-next-btn');
          if (carousel && prevBtn && nextBtn) {
            prevBtn.addEventListener('click', () => {
              carousel.scrollBy({ left: -360, behavior: 'smooth' });
            });
            nextBtn.addEventListener('click', () => {
              carousel.scrollBy({ left: 360, behavior: 'smooth' });
            });
          }
        </script>

        <!-- CTA Card -->
        <div class="bg-slate-100 rounded-md border border-slate-300/80 p-8 sm:p-10 text-center">
          <h3 class="text-xl sm:text-2xl font-heading font-bold text-slate-900 mb-2">Planning a Sporting Event or Corporate Challenge?</h3>
          <p class="text-sm text-slate-600 max-w-xl mx-auto mb-6">Connect with Daniel Poirier and Bastien Michau to assess technical feasibility and receive a quote tailored to your scale.</p>
          <a 
            href="/en/contact/" 
            class="w-full sm:w-auto px-8 py-3.5 min-h-[44px] rounded-md bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-xs uppercase tracking-wider transition-all inline-flex items-center justify-center shadow-sm"
          >
            Discuss Your Project
          </a>
        </div>

      </div>
    </div>
  </div>
</Layout>
