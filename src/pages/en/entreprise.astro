---
import Layout from '../../layouts/Layout.astro';

const team = [
  {
    name: 'Daniel Poirier',
    role: 'Co-Founder, Director of TV & Audiovisual Production',
    badge: 'Co-Founder & TV Director',
    badgeClass: 'bg-brand-cyan text-white',
    bio: 'Co-founder of Endurance Aventure in 1998. Passionate adventure racer and long-distance triathlete, Daniel directs sports documentary films and extreme cinematography in hostile environments for national and international broadcast.',
    image: '/assets/daniel-poirier-endurance-aventure.webp',
    fallback: '/assets/daniel-poirier-endurance-aventure.jpg',
    email: 'dpoirier@enduranceaventure.com',
    highlight: true,
  },
  {
    name: 'Jean-Thomas Boily',
    role: 'Co-Founder, Director of Operations & Logistics',
    badge: 'Co-Founder & Field Logistics',
    badgeClass: 'bg-slate-900 text-white',
    bio: 'Co-founder of the organization, Paralympic cross-country skier, and elite cyclist. Jean-Thomas orchestrates global logistics, course safety protocols, and field engineering for every competition.',
    image: '/assets/jean-thomas-boily.webp',
    fallback: '/assets/jean-thomas-boily.jpg',
    email: 'jtboily@enduranceaventure.com',
    highlight: true,
  },
  {
    name: 'Bastien Michau',
    role: 'Partner, Race Director & Course Designer',
    badge: 'Race Director & Partner',
    badgeClass: 'bg-brand-red text-white',
    bio: 'Caving and canyoning guide, expedition racer, and expert orienteer. Bastien designs and supervises the most demanding endurance routes, including Raid Témiscamingue and the inaugural Junior Adventure Racing World Championship (ARWS).',
    image: '/assets/bastien-michau.webp',
    fallback: '/assets/bastien-michau.jpg',
    email: 'bmichau@enduranceaventure.com',
    highlight: true,
  },
  {
    name: 'Marc Plante',
    role: 'Partner, Executive Producer & Distribution',
    badge: 'Executive Producer & Partner',
    badgeClass: 'bg-slate-800 text-white',
    bio: 'Partner since 2017. Passionate about team sports and hockey, Marc oversees executive production for documentary projects and builds international broadcast and distribution partnerships.',
    image: '/assets/marc-plante.webp',
    fallback: '/assets/marc-plante.jpg',
    email: 'mplante@enduranceaventure.com',
    highlight: false,
  },
  {
    name: 'Patricia Desgagné',
    role: 'Media Relations & International Athletes',
    badge: 'Media Relations & Welcome',
    badgeClass: 'bg-slate-700 text-white',
    bio: 'Anthropologist and polyglot, Patricia coordinates relations and hospitality for international delegations, expedition teams, and overseas journalists.',
    image: '/assets/patricia-desgagne.webp',
    fallback: '/assets/patricia-desgagne.jpg',
    email: 'pdesgagne@enduranceaventure.com',
    highlight: false,
  },
];
---

<Layout 
  title="Sports Engineering & Wilderness Expedition Experts Since 1998 | Endurance Aventure" 
  description="Founded in 1998 in Quebec by Jean-Thomas Boily and Daniel Poirier, joined by Bastien Michau and Marc Plante. Pioneers in endurance event management."
  image="/assets/bastien-michau.webp"
  lang="en"
>
  
  <!-- Immersive Header -->
  <header class="relative min-h-[50vh] sm:min-h-[58vh] flex items-center bg-slate-950 border-b border-slate-800 overflow-hidden">
    <img 
      src="/assets/51581835318_775ae15a4e_k.webp" 
      alt="Endurance Aventure field expeditions and history since 1998" 
      class="absolute inset-0 w-full h-full object-cover object-center opacity-95 brightness-95 contrast-105"
      onerror="this.src='/assets/28514399477_3839a9ca93_o-scaled.webp'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-black/20 to-black/20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/50 via-transparent to-transparent"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-16 sm:py-24">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-slate-900 border-l-2 border-brand-red text-slate-200 text-xs font-heading font-bold uppercase tracking-wider mb-5">
        <span>History & Leadership (Since 1998)</span>
      </div>
      <h1 class="text-3xl sm:text-6xl font-heading font-black uppercase text-white mb-6 drop-shadow-lg">
        The Company & The Team
      </h1>
      <p class="max-w-3xl text-base sm:text-lg text-slate-100 font-normal leading-relaxed drop-shadow-md mb-4">
        Founded in 1998 in Quebec, Endurance Aventure collaborates with host regions to design and produce international-caliber sporting events showcasing exceptional natural landscapes. Far more than mere competitions, these events act as powerful engines for tourism promotion, territorial branding, and local economic development, amplified by television productions broadcast worldwide.
      </p>
    </div>
  </header>

  <!-- Main Content -->
  <div class="bg-slate-50 py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      
      <!-- History and Origins -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-7 bg-white rounded-lg border border-slate-200 p-8 sm:p-10 shadow-sm space-y-6 text-slate-700 leading-relaxed text-sm sm:text-base">
          <h2 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900">
            Unlocking the Potential of the Great Outdoors
          </h2>
          <p>
            Founded in 1998 by <strong class="text-slate-900 font-semibold">Jean-Thomas Boily</strong> and <strong class="text-slate-900 font-semibold">Daniel Poirier</strong>, Endurance Aventure brings endurance athletes together around distinctive challenges, exploring awe-inspiring territories and inspiring communities. In 2017, <strong class="text-slate-900 font-semibold">Bastien Michau</strong> and <strong class="text-slate-900 font-semibold">Marc Plante</strong> joined the leadership team as partners, expanding its international footprint.
          </p>
          <p>
            Today, Endurance Aventure totals more than <strong class="text-slate-900 font-semibold">10,000 km of surveyed wilderness trails</strong>, dozens of hallmark events (GBC 500, ARWS Junior World Championship Témiscamingue, Raid International Gaspésie, Canada Man/Woman XTRI, Raid International China, Traversée internationale du Lac Memphrémagog), and mobilizes a network of <strong class="text-slate-900 font-semibold">150 field professionals</strong> (trail designers, wilderness medics, all-terrain cinematographers, logistics coordinators).
          </p>
          <p>
            Alongside athletic competitions, our audiovisual unit produces captivating adventure documentaries for national television networks and digital platforms, providing host regions with premier global tourist visibility.
          </p>
        </div>

        <div class="lg:col-span-5 bg-white rounded-lg border border-slate-200 p-8 shadow-sm space-y-6">
          <h3 class="text-lg font-heading font-bold text-slate-900 border-l-2 border-brand-red pl-3">
            Key Figures & Milestones
          </h3>
          <dl class="space-y-4 text-xs sm:text-sm">
            <div class="border-b border-slate-100 pb-3">
              <dt class="text-slate-500 font-medium">Founded</dt>
              <dd class="text-slate-900 font-bold text-base mt-0.5">1998 in Quebec (Over 25 years of continuous operations)</dd>
            </div>
            <div class="border-b border-slate-100 pb-3">
              <dt class="text-slate-500 font-medium">Courses designed & scouted</dt>
              <dd class="text-slate-900 font-bold text-base mt-0.5">+ 10,000 kilometers in raw nature</dd>
            </div>
            <div class="border-b border-slate-100 pb-3">
              <dt class="text-slate-500 font-medium">Executive leadership</dt>
              <dd class="text-slate-900 font-bold text-base mt-0.5">Daniel Poirier, Jean-Thomas Boily, Bastien Michau, Marc Plante</dd>
            </div>
            <div>
              <dt class="text-slate-500 font-medium">Operational headquarters</dt>
              <dd class="text-slate-900 font-bold text-base mt-0.5">Magog, Eastern Townships, Quebec, Canada</dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Management Team -->
      <div>
        <div class="mb-12">
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-1">Field Expertise</span>
          <h2 class="text-2xl sm:text-4xl font-heading font-black uppercase text-slate-900">
            The Leadership Team
          </h2>
          <p class="text-sm text-slate-600 mt-2">
            Endurance athletes, certified wilderness guides, and seasoned producers dedicated to your vision.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-5">
          {team.map((member) => (
            <div class={`rounded-lg bg-white border overflow-hidden flex flex-col justify-between transition-all duration-300 shadow-sm ${member.highlight ? 'border-slate-300 hover:border-brand-red hover:shadow-lg' : 'border-slate-200 hover:border-slate-300 hover:shadow-md'}`}>
              <div>
                <div class="h-48 sm:h-52 overflow-hidden bg-slate-200 relative">
                  <img 
                    src={member.image} 
                    alt={member.name} 
                    class="w-full h-full object-cover object-top transition-all duration-300 hover:scale-105"
                    onerror={`this.src='${member.fallback}'`}
                  />
                  <span class={`absolute top-2 right-2 px-2 py-0.5 rounded-sm ${member.badgeClass || 'bg-slate-900 text-white'} text-[10px] font-bold uppercase tracking-wider shadow-sm`}>
                    {member.badge}
                  </span>
                </div>
                <div class="p-4 sm:p-5">
                  <h3 class="text-base sm:text-lg font-heading font-bold text-slate-900 mb-1">
                    {member.name}
                  </h3>
                  <div class="text-[11px] font-bold text-brand-cyan mb-3 font-heading uppercase tracking-wider line-clamp-2">
                    {member.role}
                  </div>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    {member.bio}
                  </p>
                </div>
              </div>

              <div class="px-4 sm:px-5 pb-4 pt-1">
                <a 
                  href={`mailto:${member.email}`} 
                  class="text-[11px] font-semibold text-slate-500 hover:text-brand-red flex items-center gap-1.5 transition-colors truncate"
                  title={member.email}
                >
                  <svg class="w-3 h-3 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <span class="truncate">{member.email}</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Operational Pillars -->
      <div class="bg-white rounded-lg border border-slate-200 p-8 sm:p-12 shadow-sm">
        <div class="max-w-2xl mb-10">
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-1">Field Standards</span>
          <h3 class="text-2xl font-heading font-bold text-slate-900 mb-3">Our Operational Pillars</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            At Endurance Aventure, every challenge is built on proven logistical rigor and deep collaboration with host communities.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="p-6 rounded-md bg-slate-50 border border-slate-200">
            <div class="text-brand-red font-heading font-black text-xl mb-2">01. Wilderness Safety</div>
            <div class="text-xs text-slate-600 leading-relaxed">Emergency evacuation protocols, coordination with regional first responders, and satellite VHF communications.</div>
          </div>
          <div class="p-6 rounded-md bg-slate-50 border border-slate-200">
            <div class="text-brand-cyan font-heading font-black text-xl mb-2">02. Territorial Collaboration</div>
            <div class="text-xs text-slate-600 leading-relaxed">Official agreements with Sépaq, regional MRCs, and municipalities. Strict adherence to Leave No Trace principles.</div>
          </div>
          <div class="p-6 rounded-md bg-slate-50 border border-slate-200">
            <div class="text-slate-900 font-heading font-black text-xl mb-2">03. Youth Development</div>
            <div class="text-xs text-slate-600 leading-relaxed">Staging the Junior Adventure Racing World Championship (ARWS Youth) and nurturing next-generation endurance athletes.</div>
          </div>
          <div class="p-6 rounded-md bg-slate-50 border border-slate-200">
            <div class="text-brand-red font-heading font-black text-xl mb-2">04. Course Engineering</div>
            <div class="text-xs text-slate-600 leading-relaxed">+10,000 km scouted and validated by our race directors to provide balanced, safe, and breathtaking race courses.</div>
          </div>
        </div>
      </div>

      <!-- CTA Section -->
      <div class="rounded-2xl bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 border border-slate-800 p-8 sm:p-12 text-white shadow-xl relative overflow-hidden">
        <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-brand-red/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-8">
          <div class="max-w-2xl">
            <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest block mb-2 font-heading">
              Collaboration & Projects
            </span>
            <h3 class="text-2xl sm:text-3xl font-heading font-black uppercase text-white mb-3">
              Planning an Expedition, Event, or TV Production?
            </h3>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
              Put over 25 years of field expertise, wilderness logistics, and extreme cinematography at the service of your vision.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 flex-shrink-0 w-full lg:w-auto">
            <a 
              href="/en/contact/" 
              class="px-7 py-3.5 rounded-lg bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-xs uppercase tracking-wider transition-all shadow-md text-center flex items-center justify-center gap-2 min-h-[48px] w-full sm:w-auto"
            >
              <span>Connect with Our Team</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <a 
              href="/en/services/organisation-evenements/" 
              class="px-6 py-3.5 rounded-lg bg-slate-800/80 hover:bg-slate-800 text-slate-200 border border-slate-700 font-heading font-bold text-xs uppercase tracking-wider transition-all text-center min-h-[48px] flex items-center justify-center w-full sm:w-auto"
            >
              Explore Our Services
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>

</Layout>
