---
import Layout from '../../../layouts/Layout.astro';

const arwsSchema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": "ARWS Junior World Adventure Racing Championship 2027",
  "description": "The official Junior Adventure Racing World Championship (ARWS & IARA) hosted in Témiscamingue: 100 km, 4 days, boreal canoeing, MTB, trek, swimming, ropes and map & compass navigation for U18 and U25 youth categories.",
  "startDate": "2027-07-28",
  "endDate": "2027-07-31",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": {
    "@type": "Place",
    "name": "Témiscamingue (Abitibi-Témiscamingue)",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Témiscamingue",
      "addressRegion": "QC",
      "addressCountry": "CA"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": "Endurance Aventure & Adventure Racing World Series (ARWS)",
    "url": "https://www.arwsjuniorworld.com"
  }
};
---

<Layout 
  title="ARWS Junior World Championship 2027 | Témiscamingue | Endurance Aventure"
  description="From July 29 to August 1, 2027, Témiscamingue hosts the official ARWS & IARA Junior Adventure Racing World Championship. 100 km stage race for the world's elite U18 & U25 athletes."
  image="/assets/arws-junior-world-temiscamingue-2026-1.webp"
  jsonLd={arwsSchema}
  lang="en"
>

  <!-- IMMERSIVE HERO BANNER -->
  <section class="relative min-h-[85vh] sm:min-h-screen flex items-center justify-center bg-slate-950 overflow-hidden">
    <img 
      src="/assets/arws-junior-world-temiscamingue-2026-1.webp" 
      alt="Young athletes in action - ARWS Junior World Championship 2027" 
      class="absolute inset-0 w-full h-full object-cover opacity-90 brightness-100 contrast-105" 
      onerror="this.src='/assets/Raid-Temis-reperage4.webp'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-black/15 to-black/25"></div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center py-14 sm:py-20">
      
      <!-- Official Logo -->
      <div class="inline-flex items-center justify-center bg-white/95 backdrop-blur-md px-5 sm:px-7 py-2.5 sm:py-3.5 rounded-lg shadow-sm border border-white mb-5">
        <img 
          src="/assets/logo-championnat-monde-raid-temiscamingue.png" 
          alt="ARWS Junior World Championship Témiscamingue" 
          class="h-10 sm:h-14 w-auto object-contain"
        />
      </div>

      <div class="block mb-3">
        <span class="px-3 py-1 rounded-sm bg-brand-red text-white text-xs sm:text-sm font-bold uppercase tracking-wider inline-block">
          July 29 to August 1, 2027 • Témiscamingue, Quebec, Canada
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl md:text-5xl font-heading font-black uppercase text-white mb-4 tracking-tight drop-shadow-lg leading-tight">
        ARWS Junior World <br class="hidden sm:inline" />
        <span class="text-white">
          Championship
        </span>
      </h1>
      
      <p class="text-sm sm:text-base text-slate-200 font-light max-w-2xl mx-auto mb-8 leading-relaxed drop-shadow">
        The official global summit for next-generation adventure racers: <strong class="text-white font-semibold">100 km in stage race format</strong> across pristine boreal forests and vast Canadian Shield waterways. Teams of 2 in <strong class="text-brand-cyan font-semibold">U18 and U25</strong> divisions.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 max-w-2xl mx-auto">
        <a 
          href="https://www.arwsjuniorworld.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center justify-center px-5 py-2.5 min-h-[44px] rounded-lg bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-xs uppercase tracking-wider transition-all shadow-sm gap-2"
        >
          <span>Official Worlds Portal</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
        <a 
          href="#schedule" 
          class="inline-flex items-center justify-center px-5 py-2.5 min-h-[44px] rounded-lg bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/20 font-heading font-bold text-xs uppercase tracking-wider transition-all"
        >
          Discover Schedule
        </a>
        <a 
          href="/en/contact?type=general&subject=championnat-monde-junior-arws" 
          class="inline-flex items-center justify-center px-5 py-2.5 min-h-[44px] rounded-lg bg-slate-900/80 hover:bg-slate-900 text-slate-200 border border-slate-700 font-heading font-bold text-xs uppercase tracking-wider transition-all"
        >
          Contact Organization
        </a>
      </div>
    </div>
  </section>

  <!-- KEY METRICS BANNER -->
  <div class="bg-slate-900 border-b border-slate-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 text-center">
        <div class="p-3">
          <div class="text-3xl sm:text-4xl font-heading font-black text-brand-red">100 KM</div>
          <div class="text-xs uppercase text-slate-400 font-bold tracking-wider mt-1">Wilderness Expedition</div>
        </div>
        <div class="p-3">
          <div class="text-3xl sm:text-4xl font-heading font-black text-white">4 DAYS</div>
          <div class="text-xs uppercase text-slate-400 font-bold tracking-wider mt-1">Boreal Immersion</div>
        </div>
        <div class="p-3">
          <div class="text-3xl sm:text-4xl font-heading font-black text-brand-cyan">U18 & U25</div>
          <div class="text-xs uppercase text-slate-400 font-bold tracking-wider mt-1">2 Official Divisions</div>
        </div>
        <div class="p-3">
          <div class="text-3xl sm:text-4xl font-heading font-black text-white">DUO (x2)</div>
          <div class="text-xs uppercase text-slate-400 font-bold tracking-wider mt-1">Co-ed, Female, Male</div>
        </div>
        <div class="p-3">
          <div class="text-3xl sm:text-4xl font-heading font-black text-brand-red">0 GPS</div>
          <div class="text-xs uppercase text-slate-400 font-bold tracking-wider mt-1">Map & Compass Pure</div>
        </div>
      </div>
    </div>
  </div>

  <!-- OFFICIAL VIDEO TEASER SECTION -->
  <section class="bg-slate-950 py-12 sm:py-16 border-b border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-slate-900 border-l-2 border-brand-red text-slate-200 text-xs font-heading font-bold uppercase tracking-wider mb-4">
        <span>Official Teaser Trailer</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-heading font-black uppercase tracking-tight text-white mb-2">
        Official Teaser • ARWS Junior World Championship
      </h2>
      <p class="text-sm text-slate-400 max-w-2xl mx-auto mb-8 font-light">
        Immerse yourself in the intensity, raw boreal scenery, and total self-reliance challenge awaiting U18 and U25 teams.
      </p>

      <div class="relative w-full aspect-video rounded-lg overflow-hidden shadow-sm border border-slate-800 bg-black">
        <iframe 
          src="https://player.vimeo.com/video/1234973447?autoplay=1&loop=1&autopause=0&muted=1&background=0" 
          title="Official Teaser - ARWS Junior World Championship"
          class="w-full h-full border-0" 
          allow="autoplay; fullscreen; picture-in-picture" 
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <div class="bg-slate-50 py-20 space-y-24">
    
    <!-- OFFICIAL PRESENTATION -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-red-100 text-brand-red text-xs font-bold uppercase tracking-wider">
            <span>Historic Global Event</span>
          </div>
          <h2 class="text-3xl sm:text-5xl font-heading font-black uppercase text-slate-900 leading-tight">
            The World's Elite Youth Racers in the Boreal Wild
          </h2>
          <p class="text-base text-slate-700 leading-relaxed">
            For the second time in adventure racing history, the global circuit <strong class="text-slate-900 font-semibold">ARWS (Adventure Racing World Series)</strong> and the <strong class="text-slate-900 font-semibold">IARA (International Adventure Racing Association)</strong> join forces with <strong class="text-slate-900 font-semibold">Endurance Aventure</strong> to stage the official Junior Adventure Racing World Championship.
          </p>
          <p class="text-base text-slate-700 leading-relaxed">
            From <strong class="text-slate-900 font-semibold">July 29 to August 1, 2027</strong>, the best young adventure athletes on Earth will gather in Témiscamingue to compete across a 100-kilometer stage-race course with nightly bivouacs, carved through the Canadian Shield's ancient granite, roaring rivers, and immense boreal lakes.
          </p>
        </div>

        <div class="lg:col-span-5">
          <div class="relative rounded-lg overflow-hidden shadow-sm border border-slate-200 bg-slate-900 group">
            <img 
              src="/assets/arws-junior-world-temiscamingue-2026-4.webp" 
              alt="Young athletes in action at the ARWS Junior Adventure Race" 
              class="w-full h-80 sm:h-96 object-cover group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='/assets/Raid-Temis-reperage4.webp'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="px-2.5 py-1 rounded-sm bg-brand-cyan text-white text-[11px] font-bold uppercase tracking-wider mb-2 inline-block">
                Wilderness Territory & Boreal Lakes
              </span>
              <p class="text-sm font-semibold leading-snug">
                A world-class playground of dense forest, steep cliffs, and endless waterway corridors.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- OFFICIAL DISCIPLINES -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Endurance Multisport</span>
        <h2 class="text-3xl sm:text-4xl font-heading font-black uppercase text-slate-900">
          Disciplines on the Program
        </h2>
        <p class="text-sm text-slate-600 mt-2">
          Teams manage navigation, cohesion, and pace across 6 combined outdoor endurance disciplines.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Canoe & Portage -->
        <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between hover:border-slate-300 transition-all group">
          <div>
            <div class="h-48 overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/raid-temiscamingue-2025-1.webp" 
                alt="Expedition canoe section in boreal raid" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-3 left-3 px-2 py-0.5 rounded-sm bg-black/80 text-white text-[10px] font-bold uppercase tracking-wider">
                Water
              </span>
            </div>
            <div class="p-6">
              <h3 class="font-heading font-bold text-slate-900 text-xl mb-2">Boreal Canoe & Portages</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                Two-person tandem open canoeing on expansive lakes and winding boreal rivers. Demands intense paddling, forest portages carrying boats, and navigating moving water.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0 text-xs font-semibold text-blue-600 border-t border-slate-100 mt-2">
            Life vests and certified water safety gear mandatory
          </div>
        </div>

        <!-- Technical MTB -->
        <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between hover:border-slate-300 transition-all group">
          <div>
            <div class="h-48 overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/28514399477_3839a9ca93_o-scaled.webp" 
                alt="Mountain bike transition and singletrack" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-3 left-3 px-2 py-0.5 rounded-sm bg-black/80 text-white text-[10px] font-bold uppercase tracking-wider">
                MTB
              </span>
            </div>
            <div class="p-6">
              <h3 class="font-heading font-bold text-slate-900 text-xl mb-2">Mountain Biking (MTB)</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                Wild forestry double-tracks, loose gravel roads, rocky Canadian Shield singletracks, and punchy climbs testing mechanical durability and bike handling.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0 text-xs font-semibold text-brand-red border-t border-slate-100 mt-2">
            Total mechanical autonomy & helmets mandatory
          </div>
        </div>

        <!-- Trek & Bushwhack -->
        <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between hover:border-slate-300 transition-all group">
          <div>
            <div class="h-48 overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/arws-junior-world-photo1.webp" 
                alt="Off-trail foot progression in boreal forest" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-3 left-3 px-2 py-0.5 rounded-sm bg-black/80 text-white text-[10px] font-bold uppercase tracking-wider">
                Trek
              </span>
            </div>
            <div class="p-6">
              <h3 class="font-heading font-bold text-slate-900 text-xl mb-2">Boreal Trek & Bushwhacking</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                On-foot progression through dense taiga and rugged rocky ridges. Full off-trail bushwhacking, bog crossings, and steep granite scrambles.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0 text-xs font-semibold text-emerald-600 border-t border-slate-100 mt-2">
            Rugged trail shoes & physical resilience
          </div>
        </div>

        <!-- Map & Compass Navigation -->
        <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between hover:border-slate-300 transition-all group">
          <div>
            <div class="h-48 overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/raid-temiscamingue-2025-3.webp" 
                alt="Topographic map and compass navigation in the wild" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-3 left-3 px-2 py-0.5 rounded-sm bg-brand-red text-white text-[10px] font-bold uppercase tracking-wider">
                Strict Rule
              </span>
            </div>
            <div class="p-6">
              <h3 class="font-heading font-bold text-slate-900 text-xl mb-2">Map & Compass Navigation</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                Zero GPS, smartwatches, or digital devices with mapping allowed. Teams navigate solely using official topographic maps provided at start and magnetic compasses.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0 text-xs font-bold text-brand-red border-t border-slate-100 mt-2">
            Azimuth accuracy & terrain interpretation decide the race
          </div>
        </div>

        <!-- Open Water Swimming -->
        <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between hover:border-slate-300 transition-all group">
          <div>
            <div class="h-48 overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/arws-junior-world-temiscamingue-2026-3.webp" 
                alt="Open water swimming section in wilderness raid" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-3 left-3 px-2 py-0.5 rounded-sm bg-black/80 text-white text-[10px] font-bold uppercase tracking-wider">
                Aquatic
              </span>
            </div>
            <div class="p-6">
              <h3 class="font-heading font-bold text-slate-900 text-xl mb-2">Open Water Swims & Crossings</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                Open water swims crossing bays between islands and wild shorelines. Waterproof drybags required to protect mandatory survival gear and dry clothing.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0 text-xs font-semibold text-brand-cyan border-t border-slate-100 mt-2">
            Regulation buoyancy gear & waterproof packs
          </div>
        </div>

        <!-- Rope Work & Vertical Sections -->
        <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between hover:border-slate-300 transition-all group">
          <div>
            <div class="h-48 overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/raid-international-gaspesie-2016-mont-saint-joseph-slack-line.webp" 
                alt="Vertical ropes workshop and cliff rappel" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-3 left-3 px-2 py-0.5 rounded-sm bg-black/80 text-white text-[10px] font-bold uppercase tracking-wider">
                Ropes
              </span>
            </div>
            <div class="p-6">
              <h3 class="font-heading font-bold text-slate-900 text-xl mb-2">Ropes & Vertical Challenges</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                Cliff rappels, tyrolean traverses, and rope maneuvers rigged and supervised by Endurance Aventure's certified vertical safety specialists.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0 text-xs font-semibold text-amber-700 border-t border-slate-100 mt-2">
            Certified climbing harnesses and helmets
          </div>
        </div>

      </div>
    </div>

    <!-- COMPETITION FORMAT: U18 & U25 -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-900 rounded-lg p-8 sm:p-14 text-white shadow-sm border border-slate-800">
        
        <div class="max-w-3xl mb-12">
          <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest block mb-2">Structure & World Categories</span>
          <h2 class="text-3xl sm:text-5xl font-heading font-black uppercase text-white mb-4">
            Two Official World Divisions
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Each team consists of <strong class="text-white">2 athletes</strong> racing under their national federation or an international wildcard entry.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <!-- U18 Division -->
          <div class="p-8 rounded-lg bg-white/5 border border-white/10 backdrop-blur-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-3 py-1 rounded-sm bg-brand-cyan text-slate-950 font-black text-sm uppercase tracking-wider">
                  U18 Division
                </span>
                <span class="text-xs font-semibold text-slate-400">15 to 17 years old</span>
              </div>
              <h3 class="text-2xl font-heading font-black text-white mb-3">The International Junior Vanguard</h3>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
                Open to competitors aged 15 to 17. Close safety tracking via live satellite beacons with unassisted racing along the route.
              </p>
              <ul class="space-y-2 text-xs text-slate-300">
                <li class="flex items-center gap-2">
                  <span class="text-brand-cyan font-bold">✓</span>
                  <span>Co-ed Podium (1 Female + 1 Male)</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-brand-cyan font-bold">✓</span>
                  <span>Female Podium (2 Females)</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-brand-cyan font-bold">✓</span>
                  <span>Male Podium (2 Males)</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- U25 Division -->
          <div class="p-8 rounded-lg bg-white/5 border border-white/10 backdrop-blur-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-3 py-1 rounded-sm bg-brand-red text-white font-black text-sm uppercase tracking-wider">
                  U25 Division
                </span>
                <span class="text-xs font-semibold text-slate-400">18 to 25 years old</span>
              </div>
              <h3 class="text-2xl font-heading font-black text-white mb-3">Gateway to the World Series Elite</h3>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
                Open to racers aged 18 to 25. Complete autonomy and navigation rigors identical to premier elite ARWS stages.
              </p>
              <ul class="space-y-2 text-xs text-slate-300">
                <li class="flex items-center gap-2">
                  <span class="text-brand-red font-bold">✓</span>
                  <span>Co-ed Podium (1 Female + 1 Male)</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-brand-red font-bold">✓</span>
                  <span>Female Podium (2 Females)</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-brand-red font-bold">✓</span>
                  <span>Male Podium (2 Males)</span>
                </li>
              </ul>
            </div>
          </div>

        </div>

      </div>
    </div>

    <!-- 4-DAY SCHEDULE -->
    <div id="schedule" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest block mb-2">July 29 to August 1, 2027</span>
        <h2 class="text-3xl sm:text-4xl font-heading font-black uppercase text-slate-900">
          Estimated World Championship Schedule
        </h2>
        <p class="text-sm text-slate-600 mt-2">
          Four days of sporting intensity, cultural discovery, and global camaraderie in Témiscamingue.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Day 1 -->
        <div class="bg-white p-6 rounded-lg border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-brand-red mb-1">Thursday, July 29, 2027</div>
            <div class="text-xl font-heading font-black text-slate-900 mb-3">Welcome & Gear Check</div>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Arrival of international delegations in Ville-Marie and Témiscaming. Mandatory survival gear check and safety rope tests.
            </p>
            <ul class="space-y-1.5 text-xs text-slate-600">
              <li class="flex items-start gap-1.5">• <span>Check-in & medical verification</span></li>
              <li class="flex items-start gap-1.5">• <span>Captains' technical briefing</span></li>
