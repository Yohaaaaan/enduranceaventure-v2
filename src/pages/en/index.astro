---
import Layout from '../../layouts/Layout.astro';
import events from '../../data/events_en.json';
import services from '../../data/services_en.json';
import news from '../../data/news_en.json';

const featuredEvents = events.filter(e => e.featured);
const latestNews = news.slice(0, 3);

const serviceVisuals: Record<string, {
  tag: string;
  badgeClass: string;
  iconBg: string;
  borderHover: string;
  btnBorderHover: string;
  bulletColor: string;
  image: string;
  imageAlt: string;
  iconSvg: string;
}> = {
  'organisation-evenements': {
    tag: 'Logistics & Safety',
    badgeClass: 'bg-red-50 text-brand-red border-red-200/80',
    iconBg: 'bg-red-50 border-red-200 text-brand-red',
    borderHover: 'hover:border-brand-red/50',
    btnBorderHover: 'hover:border-brand-red hover:bg-brand-red hover:text-white',
    bulletColor: 'text-brand-red',
    image: '/assets/canadaman-2017-sommet-mont-megantic-ligne-arrivee.webp',
    imageAlt: 'Turnkey organization and all-terrain expedition logistics',
    iconSvg: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/><circle cx="12" cy="11.5" r="2.2" class="fill-brand-red/20" stroke="currentColor" stroke-width="1.5"/></svg>`
  },
  'production-tele': {
    tag: 'Extreme Filming & 4K',
    badgeClass: 'bg-cyan-50 text-brand-cyan border-cyan-200/80',
    iconBg: 'bg-cyan-50 border-cyan-200 text-brand-cyan',
    borderHover: 'hover:border-brand-cyan/50',
    btnBorderHover: 'hover:border-brand-cyan hover:bg-brand-cyan hover:text-white',
    bulletColor: 'text-brand-cyan',
    image: '/assets/JMMsony-September-13-2014_DSC1007.webp',
    imageAlt: 'Video cinematography and documentary production in remote areas',
    iconSvg: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/><circle cx="9" cy="13" r="2.2" class="fill-brand-cyan/20" stroke="currentColor" stroke-width="1.5"/><path stroke-linecap="round" stroke-width="1.8" d="M5 4h7"/></svg>`
  }
};
---

<Layout 
  title="Sporting Event Organization & Outdoor TV Production in Quebec | Endurance Aventure"
  description="Pioneers since 1998: turnkey endurance event management, wilderness logistics, corporate teambuilding, and 4K aerial drone TV cinematography in Quebec, Canada."
  lang="en"
>
  
  <!-- HERO SECTION CINEMATIC -->
  <section class="relative min-h-[88vh] sm:min-h-screen flex flex-col justify-center overflow-hidden bg-slate-950">
    <div class="absolute inset-0 z-0">
      <img 
        src="/assets/2023-08-05_GBC500_mc_1498-scaled.webp" 
        alt="GBC 500 Gravel Bike Endurance Aventure" 
        class="w-full h-full object-cover object-center opacity-90 brightness-95 contrast-105"
        onerror="this.src='/assets/2023-08-05_GBC500_mc_1498-scaled.jpg'"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-black/15 to-black/25"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/60 via-transparent to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16 flex-grow flex flex-col justify-center text-left">
      <div class="flex items-center gap-3 text-xs sm:text-sm font-heading font-bold uppercase tracking-widest text-slate-300 mb-4">
        <span class="px-2.5 py-1 bg-brand-red text-white rounded font-bold">Since 1998</span>
        <span>Outdoor Sporting Events & Television Production</span>
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-black uppercase tracking-tight text-white leading-tight max-w-4xl mb-6 break-words">
        Sporting Adventure <br class="hidden sm:inline" />
        <span class="text-brand-red">in the Wild.</span>
      </h1>

      <p class="max-w-2xl text-sm sm:text-lg md:text-xl text-slate-200 font-normal leading-relaxed mb-8">
        Endurance Aventure designs and coordinates world-class endurance races across Quebec's most untamed territories, and produces extreme television and digital documentaries for broadcast worldwide.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4 w-full sm:w-auto">
        <a 
          href="#evenements" 
          class="px-6 sm:px-8 py-3.5 sm:py-4 rounded-lg bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-xs sm:text-sm uppercase tracking-wider transition-colors shadow-lg text-center min-h-[48px] flex items-center justify-center"
        >
          2026/2027 Event Calendar
        </a>
        <a 
          href="/en/services/organisation-evenements/" 
          class="px-6 sm:px-8 py-3.5 sm:py-4 rounded-lg bg-slate-900/80 hover:bg-slate-900 text-slate-100 border border-slate-700 hover:border-slate-500 font-heading font-bold text-xs sm:text-sm uppercase tracking-wider transition-colors backdrop-blur-sm text-center min-h-[48px] flex items-center justify-center"
        >
          Corporate Services & Filming
        </a>
      </div>
    </div>
  </section>

  <!-- FEATURED EVENTS SECTION -->
  <section id="evenements" class="py-14 sm:py-20 lg:py-24 bg-slate-100/70 border-t border-slate-200 relative overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 sm:mb-16 gap-4 sm:gap-6">
        <div>
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Athletes & Enthusiasts</span>
          <h2 class="text-2xl sm:text-4xl md:text-5xl font-heading font-black uppercase tracking-tight text-slate-900 leading-tight">
            Our Featured Sports Events
          </h2>
        </div>
        <a href="/en/evenements/" class="text-brand-red hover:text-red-700 font-bold text-xs sm:text-sm uppercase tracking-wider flex items-center gap-1.5 transition-colors self-start sm:self-auto py-1">
          <span>View complete calendar</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

      <!-- Events Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredEvents.map((evt) => (
          <div class="group rounded-lg bg-white border border-slate-200/90 shadow-sm overflow-hidden flex flex-col transition-all duration-300 hover:border-slate-300 hover:shadow-lg hover:-translate-y-0.5">
            <!-- Image Frame -->
            <div class="relative h-64 overflow-hidden bg-slate-200">
              <img 
                src={evt.image} 
                alt={evt.title} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
              
              <span class="absolute top-4 left-4 px-2.5 py-1 rounded-sm text-xs font-bold uppercase tracking-wider bg-brand-red text-white shadow-sm">
                {evt.category}
              </span>

              {evt.logo && (
                <div class="absolute top-4 right-4 p-1.5 sm:p-2 rounded-md bg-white shadow-sm border border-slate-200/90 flex items-center gap-2 z-10">
                  <img 
                    src={evt.logo} 
                    alt={`Logo ${evt.title}`} 
                    class="h-7 sm:h-9 w-auto object-contain max-w-[100px]" 
                  />
                  {evt.secondaryLogo && (
                    <>
                      <div class="h-6 w-px bg-slate-200"></div>
                      <img 
                        src={evt.secondaryLogo} 
                        alt={`Partner ${evt.title}`} 
                        class="h-6 sm:h-7 w-auto object-contain max-w-[70px]" 
                      />
                    </>
                  )}
                </div>
              )}
              
              <span class="absolute bottom-4 left-4 px-2.5 py-1 rounded-sm text-xs font-semibold bg-slate-950/85 text-white backdrop-blur-sm border border-slate-800 flex items-center gap-1.5 shadow-sm">
                <svg class="w-3.5 h-3.5 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span>{evt.location}</span>
              </span>
            </div>

            <!-- Content -->
            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <h3 class="text-2xl font-heading font-bold text-slate-900 mb-2 group-hover:text-brand-red transition-colors">
                  {evt.title}
                </h3>
                <p class="text-sm text-slate-600 mb-6 line-clamp-3 leading-relaxed">
                  {evt.description}
                </p>

                <ul class="space-y-2 mb-6 text-xs text-slate-700">
                  {evt.highlights.slice(0, 3).map(h => (
                    <li class="flex items-center gap-2">
                      <svg class="w-4 h-4 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Button -->
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs text-slate-500 font-semibold">{evt.dates}</span>
                {evt.registrationLink && evt.registrationLink !== '#' ? (
                  <a 
                    href={evt.registrationLink} 
                    target={evt.registrationLink.startsWith('http') ? '_blank' : undefined}
                    rel={evt.registrationLink.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="px-4 py-2.5 rounded-md bg-brand-red hover:bg-brand-red-dark text-white text-xs font-heading font-bold uppercase tracking-wider transition-all shadow-sm inline-flex items-center gap-1.5"
                  >
                    <span>{evt.buttonText || (evt.registrationLink.startsWith('http') ? 'Visit Website' : 'Details')}</span>
                    {evt.registrationLink.startsWith('http') && (
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    )}
                  </a>
                ) : (
                  <span class="px-4 py-2.5 rounded-md bg-slate-100 text-slate-400 border border-slate-200 text-xs font-heading font-bold uppercase tracking-wider inline-flex items-center gap-1.5 cursor-not-allowed">
                    Coming Soon
                  </span>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 25 YEARS OF EXPEDITION & ENGINEERING -->
  <section class="py-20 bg-slate-150/70 border-t border-slate-200 relative overflow-hidden bg-gradient-to-b from-slate-100/90 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-white border border-slate-200 border-l-2 border-l-brand-red text-slate-800 text-xs font-heading font-bold uppercase tracking-wider shadow-sm">
            <span>Outdoor Pioneers in Quebec Since 1998</span>
          </div>
          <h2 class="text-3xl sm:text-5xl font-heading font-black uppercase tracking-tight text-slate-900 leading-tight">
            25 Years of Expedition & Sports Engineering
          </h2>
          <p class="text-base text-slate-700 leading-relaxed">
            Endurance Aventure collaborates closely with municipalities, regional counties, national parks, and international broadcasters to design, scout, and produce premier events that highlight the rugged beauty of Quebec.
          </p>
          <p class="text-sm text-slate-600 leading-relaxed">
            From cartographic GPS course design to wilderness emergency rescue coordination, our race directors and cinematographers build powerful catalysts for regional tourism and economic impact.
          </p>

          <div class="pt-2 flex flex-wrap gap-4">
            <a 
              href="/en/entreprise/" 
              class="px-7 py-3.5 rounded-md bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-xs uppercase tracking-wider transition-colors inline-flex items-center gap-2 shadow-sm"
            >
              <span>Our History & Team</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <a 
              href="/en/services/organisation-evenements/" 
              class="px-6 py-3.5 rounded-md bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 font-heading font-bold text-xs uppercase tracking-wider transition-colors inline-flex items-center gap-2 shadow-sm"
            >
              <span>Event Organization</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-6 space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-5 rounded-lg bg-white border border-slate-200 shadow-sm">
              <div class="text-3xl sm:text-4xl font-heading font-black text-brand-red mb-1">1998</div>
              <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Founded in Quebec</div>
              <div class="text-[11px] text-slate-600 mt-1">+25 years of pioneering races</div>
            </div>
            <div class="p-5 rounded-lg bg-white border border-slate-200 shadow-sm">
              <div class="text-3xl sm:text-4xl font-heading font-black text-brand-cyan mb-1">+10,000 km</div>
              <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Trail Routes Mapped</div>
              <div class="text-[11px] text-slate-600 mt-1">Scouted, validated, and secured in remote wilderness</div>
            </div>
            <div class="p-5 rounded-lg bg-white border border-slate-200 shadow-sm">
              <div class="text-3xl sm:text-4xl font-heading font-black text-slate-800 mb-1">30+</div>
              <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Partner Municipalities</div>
              <div class="text-[11px] text-slate-600 mt-1">Gaspésie, Témiscamingue, Eastern Townships</div>
            </div>
            <div class="p-5 rounded-lg bg-white border border-slate-200 shadow-sm">
              <div class="text-3xl sm:text-4xl font-heading font-black text-emerald-600 mb-1">National TV</div>
              <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Broadcast Distribution</div>
              <div class="text-[11px] text-slate-600 mt-1">Adventure documentaries & international series</div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="rounded-lg overflow-hidden bg-slate-100 border border-slate-200 h-44 relative group shadow-sm">
              <img 
                src="/assets/51581835318_775ae15a4e_k.webp" 
                alt="Wilderness route scouting in boreal backcountry" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent"></div>
              <span class="absolute bottom-2.5 left-3 text-white text-xs font-semibold">Wilderness trail scouting</span>
            </div>
            <div class="rounded-lg overflow-hidden bg-slate-100 border border-slate-200 h-44 relative group shadow-sm">
              <img 
                src="/assets/JMMsony-September-12-2014_DSC0167.webp" 
                alt="All-terrain expedition logistics and field command" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent"></div>
              <span class="absolute bottom-2.5 left-3 text-white text-xs font-semibold">Expedition field command</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CORPORATE & B2B SERVICES -->
  <section class="py-24 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-16">
        <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest block mb-2">B2B, Destinations & Corporations</span>
        <h2 class="text-3xl sm:text-5xl font-heading font-black uppercase tracking-tight text-slate-900 mb-4">
          Event Management & Media Production
        </h2>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          We bring over 25 years of all-terrain engineering and extreme broadcast film crews to elevate your corporate challenges, official sporting competitions, and television projects.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl">
        {services.map((srv) => {
          const meta = serviceVisuals[srv.id] || {
            tag: 'Pro Expertise',
            badgeClass: 'bg-slate-100 text-slate-700 border-slate-200',
            iconBg: 'bg-slate-100 border-slate-200 text-slate-700',
            borderHover: 'hover:border-slate-400',
            btnBorderHover: 'hover:border-slate-800 hover:bg-slate-800 hover:text-white',
            bulletColor: 'text-brand-cyan',
            image: '/assets/canadaman-2017-sommet-mont-megantic-ligne-arrivee.webp',
            imageAlt: srv.title,
            iconSvg: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
          };

          return (
            <div class={`rounded-lg bg-white border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between transition-all duration-300 ${meta.borderHover} hover:shadow-lg hover:-translate-y-0.5 group`}>
              <div>
                <div class="h-48 overflow-hidden bg-slate-100 relative">
                  <img 
                    src={meta.image} 
                    alt={meta.imageAlt} 
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-black/15 to-transparent"></div>
                  <span class={`absolute top-3 right-3 text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-sm border shadow-sm ${meta.badgeClass}`}>
                    {meta.tag}
                  </span>
                </div>

                <div class="p-6 sm:p-8">
                  <div class="flex items-center gap-3 mb-4">
                    <div class={`w-10 h-10 rounded-md border flex items-center justify-center font-bold shadow-sm flex-shrink-0 ${meta.iconBg}`} set:html={meta.iconSvg}>
                    </div>
                    <h3 class="text-xl font-heading font-bold text-slate-900">
                      {srv.title}
                    </h3>
                  </div>

                  <p class="text-sm text-slate-600 mb-6 leading-relaxed">
                    {srv.description}
                  </p>

                  <ul class="space-y-2.5 mb-8 text-xs text-slate-700">
                    {srv.features.map((f) => (
                      <li class="flex items-start gap-2.5">
                        <span class={`font-bold mt-0.5 ${meta.bulletColor}`}>•</span>
                        <span class="leading-relaxed">{f}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="px-6 sm:px-8 pb-6 sm:pb-8 pt-0">
                <a 
                  href={`/en/services/${srv.slug}/`} 
                  class={`w-full py-3 rounded-md border border-slate-300 text-slate-800 text-center text-xs font-bold uppercase tracking-wider transition-all shadow-sm flex items-center justify-center gap-1.5 ${meta.btnBorderHover}`}
                >
                  <span>Explore service details</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <!-- LEADERSHIP BANNER -->
      <div class="mt-16 rounded-xl bg-slate-50 border border-slate-200/90 p-8 sm:p-12 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <div class="lg:col-span-6 space-y-5">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-white border border-slate-200 text-slate-800 text-xs font-heading font-bold uppercase tracking-wider shadow-sm">
              <span class="w-2 h-2 rounded-full bg-brand-red"></span>
              <span>Field Leadership & Project Direction</span>
            </div>
            
            <h3 class="text-2xl sm:text-3xl font-heading font-black uppercase tracking-tight text-slate-900 leading-tight">
              Experienced Field Direction in the Backcountry
            </h3>
            
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
              Every mandate is directly overseen by its founding partners and race directors to ensure rigorous safety compliance, environmental respect, and real economic value.
            </p>

            <div class="pt-2 flex flex-col sm:flex-row sm:items-center gap-4">
              <a 
                href="/en/contact/?type=b2b" 
                class="px-7 py-3.5 rounded-md bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-xs uppercase tracking-wider transition-all shadow-sm inline-flex items-center justify-center gap-2"
              >
                <span>Request a Project Proposal</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>

              <a 
                href="/en/entreprise/" 
                class="text-xs font-heading font-bold uppercase tracking-wider text-slate-700 hover:text-brand-red transition-colors inline-flex items-center gap-1.5 self-center"
              >
                <span>Meet the team</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>

            <div class="pt-3 border-t border-slate-200 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-slate-600">
              <span class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                <span>Headquarters : <strong class="text-slate-800 font-semibold">(819) 342-5220</strong></span>
