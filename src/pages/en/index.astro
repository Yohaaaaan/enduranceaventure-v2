  </section>

  <!-- LATEST NEWS & FIELD STORIES -->
  <section class="py-24 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest block mb-2">Dispatches & Updates</span>
          <h2 class="text-3xl sm:text-5xl font-heading font-black uppercase tracking-tight text-slate-900">
            Latest News from the Field
          </h2>
          <p class="text-base text-slate-600 max-w-2xl mt-3 leading-relaxed">
            Follow our race announcements, official recap stories, and behind-the-scenes documentary updates.
          </p>
        </div>
        <a 
          href="/en/nouvelles/" 
          class="text-brand-red hover:text-red-700 font-bold text-xs uppercase tracking-wider flex items-center gap-1.5 transition-colors self-start md:self-end"
        >
          <span>All news updates</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {latestNews.map((n) => (
          <article class="rounded-lg bg-white border border-slate-200 overflow-hidden flex flex-col group hover:border-slate-300 hover:shadow-lg transition-all duration-300 shadow-sm">
            <div class="relative h-52 overflow-hidden bg-slate-900">
              <img 
                src={n.image} 
                alt={n.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                onerror="this.src='/assets/canadaman-2017-sommet-mont-megantic-ligne-arrivee.webp'"
              />
              <span class="absolute top-3 right-3 px-2 py-0.5 rounded-sm bg-black/80 text-[11px] font-semibold text-white backdrop-blur-sm border border-slate-800 flex items-center gap-1">
                <svg class="w-3 h-3 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <span>{n.date}</span>
              </span>
            </div>

            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-heading font-bold text-slate-900 mb-3 group-hover:text-brand-red transition-colors line-clamp-2">
                  <a href={`/en/nouvelles/${n.slug}`}>{n.title}</a>
                </h3>
                <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed mb-6">
                  {n.excerpt}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Endurance Aventure</span>
                <a href={`/en/nouvelles/${n.slug}`} class="text-xs font-bold uppercase tracking-wider text-brand-red hover:underline flex items-center gap-1.5">
                  <span>Read update</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-20 bg-slate-100 border-t border-slate-200 text-slate-900 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="rounded-lg bg-white border border-slate-200 p-8 sm:p-14 shadow-sm relative overflow-hidden flex flex-col lg:flex-row lg:items-center justify-between gap-8">
        <div class="max-w-2xl">
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2 font-heading">
            Collaboration, Destinations & Brands
          </span>
          <h2 class="text-3xl sm:text-4xl font-heading font-black uppercase tracking-tight text-slate-900 mb-4">
            Planning an Outdoor Challenge, Expedition or Film?
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Put 25 years of sports engineering, expedition logistics, and extreme broadcasting at the service of your vision. Speak directly with Daniel Poirier and Bastien Michau.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4 flex-shrink-0 w-full lg:w-auto">
          <a 
