            </div>

            <div class="p-5 rounded-lg bg-white border border-slate-200 shadow-sm flex flex-col justify-between hover:border-slate-300 transition-colors">
              <div>
                <div class="flex items-center gap-3.5 mb-3">
                  <img 
                    src="/assets/bastien-michau.webp" 
                    alt="Bastien Michau" 
                    class="w-14 h-14 rounded-md object-cover border border-slate-200 shadow-xs flex-shrink-0"
                    onerror="this.src='/assets/bastien-michau.jpg'"
                  />
                  <div>
                    <h4 class="text-slate-900 font-heading font-black text-base leading-tight">Bastien Michau</h4>
                    <span class="inline-block mt-0.5 px-2 py-0.5 rounded-xs text-[10px] font-bold uppercase tracking-wider bg-cyan-50 text-brand-cyan border border-cyan-100">
                      Technical & Safety Director
                    </span>
                  </div>
                </div>
                <p class="text-xs text-slate-600 leading-relaxed">
                  GPS route engineering, expedition logistics in boreal regions, and emergency protocol coordination.
                </p>
              </div>
            </div>
