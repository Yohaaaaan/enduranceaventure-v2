                <a href="mailto:info@enduranceaventure.com" class="hover:text-brand-red transition-colors">info@enduranceaventure.com</a>
              </span>
            </div>
          </div>

          <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-5 rounded-lg bg-white border border-slate-200 shadow-sm flex flex-col justify-between hover:border-slate-300 transition-colors">
              <div>
                <div class="flex items-center gap-3.5 mb-3">
                  <img 
                    src="/assets/daniel-poirier-endurance-aventure.webp" 
