          </a>
          <a 
            href="/en/services/organisation-evenements/" 
            class="px-7 py-4 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-800 border border-slate-300 font-heading font-bold text-xs uppercase tracking-wider transition-all text-center min-h-[48px] flex items-center justify-center w-full sm:w-auto"
          >
            Explore Services
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
