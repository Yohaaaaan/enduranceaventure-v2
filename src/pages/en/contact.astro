---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="B2B Quote Request & Event Organization | Endurance Aventure" 
  description="Contact Daniel Poirier and Bastien Michau for corporate event quotes, municipal feasibility studies, or 4K drone cinematography in Quebec."
  lang="en"
>
  
  <!-- Immersive Header with Authentic Quebec Landscape -->
  <header class="relative min-h-[48vh] sm:min-h-[55vh] flex items-center bg-slate-950 border-b border-slate-800 overflow-hidden">
    <img 
      src="/assets/Canada-Man-2018-Course-sentier.webp" 
      alt="Endurance adventure trail and Quebec territory - Endurance Aventure" 
      class="absolute inset-0 w-full h-full object-cover object-center opacity-90 brightness-95 contrast-105"
      onerror="this.src='/assets/51581835318_775ae15a4e_k.webp'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-black/20 to-black/20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/50 via-transparent to-transparent"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-16 sm:py-24 w-full">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-slate-900 border-l-2 border-brand-red text-slate-200 text-xs font-heading font-bold uppercase tracking-wider mb-5">
        <span>Secure Form & Direct Quote</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-heading font-black uppercase tracking-tight text-white mb-4 drop-shadow-lg">
        Contact & Quotes
      </h1>
      <p class="max-w-2xl text-base sm:text-lg text-slate-100 font-normal leading-relaxed drop-shadow-md">
        Planning a corporate challenge, a television production, or have questions about a race? Bastien Michau, Daniel Poirier, and the technical crew are ready to evaluate your project.
      </p>
    </div>
  </header>

  <!-- Main Content -->
  <div class="bg-slate-50 py-10 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12">
        
        <!-- Sidebar Contact Info -->
        <div class="lg:col-span-4 space-y-4 sm:space-y-6">
          <div class="bg-white p-5 sm:p-8 rounded-lg border border-slate-200 shadow-sm space-y-4 sm:space-y-6">
            <h2 class="text-lg sm:text-xl font-heading font-bold text-slate-900 border-l-2 border-brand-red pl-3">
              Direct Contact Details
            </h2>
            
            <div class="space-y-3 sm:space-y-4 text-xs sm:text-sm text-slate-700">
              <div>
                <div class="text-[10px] sm:text-xs text-slate-500 uppercase font-bold mb-0.5 sm:mb-1">Headquarters</div>
                <div class="text-slate-900 font-medium">Magog, Eastern Townships</div>
                <div class="text-slate-500">Quebec, Canada</div>
              </div>

              <div>
                <div class="text-[10px] sm:text-xs text-slate-500 uppercase font-bold mb-0.5 sm:mb-1">Telephone</div>
                <div class="space-y-1 text-xs sm:text-sm">
                  <div class="flex items-center justify-between">
                    <span class="text-slate-500">Magog Office:</span>
                    <a href="tel:8193425220" class="text-slate-900 font-bold hover:text-brand-red transition-colors">(819) 342-5220</a>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-slate-500">France Office:</span>
                    <a href="tel:+330783409102" class="text-slate-900 font-bold hover:text-brand-red transition-colors">+33 0783409102</a>
                  </div>
                </div>
              </div>

              <div>
                <div class="text-[10px] sm:text-xs text-slate-500 uppercase font-bold mb-0.5 sm:mb-1">Official Email</div>
                <a href="mailto:info@enduranceaventure.com" class="text-brand-cyan hover:underline font-semibold">
                  info@enduranceaventure.com
                </a>
              </div>

              <div class="pt-2 border-t border-slate-100">
                <div class="text-[10px] sm:text-xs text-slate-500 uppercase font-bold mb-0.5 sm:mb-1">Technical Direction</div>
                <div class="font-semibold text-slate-900">Bastien Michau</div>
                <div class="text-[11px] sm:text-xs text-slate-500">bmichau@enduranceaventure.com</div>
              </div>

              <div>
                <div class="text-[10px] sm:text-xs text-slate-500 uppercase font-bold mb-0.5 sm:mb-1">General Management</div>
                <div class="font-semibold text-slate-900">Daniel Poirier</div>
                <div class="text-[11px] sm:text-xs text-slate-500">dpoirier@enduranceaventure.com</div>
              </div>
            </div>
          </div>

          <!-- Commitments Card -->
          <div class="bg-white p-5 sm:p-8 rounded-lg border border-slate-200 shadow-sm space-y-3 sm:space-y-4">
            <h3 class="text-sm sm:text-base font-heading font-bold text-slate-900 border-l-2 border-brand-cyan pl-3">
              Standards & Safety
            </h3>
            <ul class="text-[11px] sm:text-xs text-slate-600 space-y-1.5 sm:space-y-2 leading-relaxed">
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 bg-brand-cyan mt-1 sm:mt-1.5 flex-shrink-0"></span>
                <span>In-depth technical feasibility review and personalized response.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 bg-brand-cyan mt-1 sm:mt-1.5 flex-shrink-0"></span>
                <span>Comprehensive wilderness commercial general liability insurance.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 bg-brand-cyan mt-1 sm:mt-1.5 flex-shrink-0"></span>
                <span>Strictly confidential data, zero spam guarantee.</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Form with B2B / Athletes Tabs -->
        <div class="lg:col-span-8">
          <div class="bg-white p-4 sm:p-10 rounded-lg border border-slate-200 shadow-sm relative">
            
            <!-- Tab Selector Segmented on Mobile -->
            <div class="grid grid-cols-2 sm:flex sm:flex-row border-b-0 sm:border-b border-slate-200 mb-6 sm:mb-8 pb-0 sm:pb-1 gap-1.5 sm:gap-2 bg-slate-100 sm:bg-transparent p-1 sm:p-0 rounded-md sm:rounded-none">
              <button 
                type="button" 
                id="tab-b2b-btn" 
                class="min-h-[44px] py-2 px-2.5 sm:px-4 font-heading font-bold text-[11px] sm:text-sm tracking-wider uppercase border-b-0 sm:border-b-2 border-brand-red text-brand-red bg-white sm:bg-transparent rounded-sm sm:rounded-none shadow-xs sm:shadow-none transition-all flex items-center justify-center sm:justify-start gap-1.5 sm:gap-2 text-center"
              >
                <svg class="hidden sm:inline-block w-3.5 h-3.5 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                <span>B2B Quotes</span>
              </button>
              <button 
                type="button" 
                id="tab-general-btn" 
                class="min-h-[44px] py-2 px-2.5 sm:px-4 font-heading font-semibold text-[11px] sm:text-sm tracking-wider uppercase border-b-0 sm:border-b-2 border-transparent text-slate-600 sm:text-slate-500 hover:text-slate-900 transition-all flex items-center justify-center sm:justify-start gap-1.5 sm:gap-2 text-center"
              >
                <svg class="hidden sm:inline-block w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                <span>Athletes</span>
              </button>
            </div>

            <!-- Success Alert -->
            <div id="form-success" class="hidden mb-6 p-6 rounded-md bg-emerald-50 border border-emerald-300 text-emerald-900 text-sm space-y-2">
              <div class="font-heading font-bold text-base flex items-center gap-2 text-emerald-800">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Your message has been successfully received!</span>
              </div>
              <p class="text-xs text-emerald-700 leading-relaxed">
                Thank you for contacting Endurance Aventure. Bastien Michau, Daniel Poirier, and our technical crew will review your inquiry and follow up promptly.
              </p>
            </div>

            <!-- Error Alert -->
            <div id="form-error" class="hidden mb-6 p-4 rounded-md bg-red-50 border border-red-300 text-brand-red text-xs font-semibold">
              An error occurred while sending your request. Please try again or reach out directly at info@enduranceaventure.com.
            </div>

            <form id="contact-form" class="space-y-6">
              <input type="hidden" id="form-type" name="type" value="b2b" />

              <!-- B2B Fields -->
              <div id="b2b-fields" class="space-y-6">
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                  <div>
                    <label for="org-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                      Organization / Company / Municipality Name *
                    </label>
                    <input 
                      type="text" 
                      id="org-name" 
                      name="organization" 
                      placeholder="e.g., City of Magog / Corporate Team"
                      class="w-full px-4 py-3 min-h-[44px] rounded-md bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-brand-red text-base sm:text-sm"
                    />
                  </div>

                  <div>
                    <label for="org-type" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                      Organization Type *
                    </label>
                    <select 
                      id="org-type" 
                      name="orgType"
                      class="w-full px-4 py-3 min-h-[44px] rounded-md bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:border-brand-red text-base sm:text-sm"
                    >
                      <option value="entreprise">Private Corporation / Business</option>
                      <option value="municipalite">City / Regional Municipality (MRC)</option>
                      <option value="obnl">Sports Association / Non-profit</option>
                      <option value="media">Media Broadcaster / TV Agency</option>
                      <option value="autre">Other Organization</option>
                    </select>
                  </div>
                </div>

                <div>
                  <label for="service-needed" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                    Primary Service Requested *
                  </label>
                  <select 
                    id="service-needed" 
                    name="service"
                    class="w-full px-4 py-3 min-h-[44px] rounded-md bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:border-brand-red text-base sm:text-sm"
                  >
                    <option value="organisation-evenements">Turnkey Sporting Event Management</option>
                    <option value="production-tele">TV & Video Production, 4K Cinema Drones</option>
                    <option value="ingenierie-securite">Course Engineering, Emergency & Safety Plans</option>
                    <option value="autre">Combined Project / Other</option>
                  </select>
                </div>

              </div>

              <!-- Shared Fields -->
              <div class="space-y-6 pt-2">
                <div>
                  <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                    Full Name *
                  </label>
                  <input 
                    type="text" 
                    id="contact-name" 
                    name="name" 
                    required 
                    placeholder="e.g., Jane Smith"
                    class="w-full px-4 py-3 min-h-[44px] rounded-md bg-white border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-brand-red text-base sm:text-sm"
                  />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                  <div>
                    <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                      Email Address *
                    </label>
                    <input 
                      type="email" 
                      id="contact-email" 
                      name="email" 
                      inputmode="email"
                      required 
                      placeholder="jane@company.com"
                      class="w-full px-4 py-3 min-h-[44px] rounded-md bg-white border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-brand-red text-base sm:text-sm"
                    />
                  </div>

                  <div>
                    <label for="contact-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                      Direct Phone Number
                    </label>
                    <input 
                      type="tel" 
                      id="contact-phone" 
                      name="phone" 
                      inputmode="tel"
                      placeholder="(450) 000-0000"
                      class="w-full px-4 py-3 min-h-[44px] rounded-md bg-white border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-brand-red text-base sm:text-sm"
                    />
                  </div>
                </div>
              </div>

              <!-- General Subject Field -->
              <div id="general-fields" class="hidden">
                <label for="contact-subject" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                  Topic of Your Inquiry *
                </label>
                <select 
                  id="contact-subject" 
                  name="subject"
                  class="w-full px-4 py-3 min-h-[44px] rounded-md bg-white border border-slate-300 text-slate-900 focus:outline-none focus:border-brand-red text-base sm:text-sm"
                >
                  <option value="gbc500">GBC 500 (Gravel Bikepacking Challenge)</option>
                  <option value="championnat-monde-junior-arws">ARWS Junior World Championship 2027 (Témiscamingue)</option>
                  <option value="raids">Adventure Raids (Gaspésie & Témiscamingue)</option>
                  <option value="benevolat">Volunteering at an event</option>
                  <option value="autre">Other General Question</option>
                </select>
              </div>

              <div>
                <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                  Details of Your Request or Project *
                </label>
                <textarea 
                  id="contact-message" 
                  name="message" 
                  rows="5" 
                  required 
                  placeholder="Describe your vision, goals, geographical specifics, or questions..."
                  class="w-full px-4 py-3 rounded-md bg-white border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-brand-red text-base sm:text-sm"
                ></textarea>
              </div>

              <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
                <span class="text-xs text-slate-500">* Fields marked with an asterisk are required.</span>
                <button 
                  type="submit" 
                  id="submit-btn"
                  class="w-full sm:w-auto px-8 py-3.5 rounded-md bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-xs uppercase tracking-wider transition-all shadow-sm"
                >
                  Submit Inquiry
                </button>
              </div>
            </form>

          </div>
        </div>

      </div>
    </div>
  </div>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const formType = document.getElementById('form-type');
    const b2bFields = document.getElementById('b2b-fields');
    const generalFields = document.getElementById('general-fields');
    const tabB2b = document.getElementById('tab-b2b-btn');
    const tabGen = document.getElementById('tab-general-btn');
    const successAlert = document.getElementById('form-success');
    const errorAlert = document.getElementById('form-error');
    const submitBtn = document.getElementById('submit-btn');

    function setTab(mode) {
      if (mode === 'general') {
        formType.value = 'general';
        b2bFields.classList.add('hidden');
        generalFields.classList.remove('hidden');
        tabGen.className = 'pb-3 px-4 font-heading font-bold text-sm tracking-wider uppercase border-b-2 border-brand-red text-brand-red transition-all';
        tabB2b.className = 'pb-3 px-4 font-heading font-semibold text-sm tracking-wider uppercase border-b-2 border-transparent text-slate-500 hover:text-slate-900 transition-all';
        submitBtn.innerText = 'Send My Question';
      } else {
        formType.value = 'b2b';
        b2bFields.classList.remove('hidden');
        generalFields.classList.add('hidden');
        tabB2b.className = 'pb-3 px-4 font-heading font-bold text-sm tracking-wider uppercase border-b-2 border-brand-red text-brand-red transition-all';
        tabGen.className = 'pb-3 px-4 font-heading font-semibold text-sm tracking-wider uppercase border-b-2 border-transparent text-slate-500 hover:text-slate-900 transition-all';
        submitBtn.innerText = 'Submit Quote Request';
      }
    }

    tabB2b?.addEventListener('click', () => setTab('b2b'));
    tabGen?.addEventListener('click', () => setTab('general'));

    const params = new URLSearchParams(window.location.search);
    if (params.get('type') === 'general' || params.has('subject')) {
      setTab('general');
      const subj = params.get('subject');
      const subjSelect = document.getElementById('contact-subject');
      if (subj && subjSelect) subjSelect.value = subj;
    } else {
      setTab('b2b');
      const srv = params.get('service');
      const srvSelect = document.getElementById('service-needed');
      if (srv && srvSelect) {
        for (let opt of srvSelect.options) {
          if (opt.value.includes(srv)) {
            srvSelect.value = opt.value;
            break;
          }
        }
      }
    }

    form?.addEventListener('submit', async function(e) {
      e.preventDefault();
      successAlert.classList.add('hidden');
      errorAlert.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.innerText = 'Sending...';

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const json = await res.json();
        if (json.success) {
          form.reset();
          successAlert.classList.remove('hidden');
          successAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          errorAlert.innerText = json.error || 'An error occurred while sending.';
          errorAlert.classList.remove('hidden');
        }
      } catch (err) {
        errorAlert.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerText = formType.value === 'b2b' ? 'Submit Quote Request' : 'Send My Question';
      }
    });
  </script>

</Layout>
