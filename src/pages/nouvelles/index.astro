---
import Layout from '../../layouts/Layout.astro';
import news from '../../data/news.json';
---

<Layout title="Actualités, Récits & Archives | Endurance Aventure" description="Découvrez les actualités, résumés de courses, vidéos et annonces d'Endurance Aventure.">
  
  <!-- Banner Sombre & Immersif avec Photo de Récit Épique -->
  <header class="relative min-h-[50vh] sm:min-h-[58vh] flex items-center bg-slate-950 border-b border-slate-800 overflow-hidden">
    <img 
      src="/assets/CAXTRI-2019-Extreme-Depart.webp" 
      alt="Départ d'épreuve et récits d'endurance extrême" 
      class="absolute inset-0 w-full h-full object-cover object-center opacity-90 brightness-95 contrast-105"
      onerror="this.src='/assets/Canada-Man-2018-Course-sentier.webp'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-black/20 to-black/20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/50 via-transparent to-transparent"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-16 sm:py-24 w-full">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-slate-900 border-l-2 border-brand-red text-slate-200 text-xs font-heading font-bold uppercase tracking-wider mb-5">
          <span>Récits de Course, Médias & Histoire</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-heading font-black uppercase tracking-tight text-white mb-4 drop-shadow-lg">
          Actualités & Récits
        </h1>
        <p class="max-w-2xl text-base sm:text-lg text-slate-100 font-normal leading-relaxed drop-shadow-md">
          Revivez les temps forts, les annonces officielles et les plus grands exploits d'Endurance Aventure à travers nos archives et articles.
        </p>
      </div>
    </div>
  </header>

  <!-- Contenu Principal sur Fond Clair -->
  <div class="bg-slate-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- News Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {news.map((n) => (
          <article class="rounded-lg bg-white border border-slate-200 overflow-hidden flex flex-col group hover:border-slate-300 hover:shadow-lg transition-all duration-300 shadow-sm">
            <div class="relative h-52 overflow-hidden bg-slate-200">
              <img 
                src={n.image} 
                alt={n.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                onerror="this.src='/assets/EnduranceAventure.jpg'"
              />
              <span class="absolute top-3 right-3 px-2 py-0.5 rounded-sm bg-black/80 text-[11px] font-semibold text-white backdrop-blur-sm border border-slate-800 flex items-center gap-1">
                <svg class="w-3 h-3 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <span>{n.date}</span>
              </span>
            </div>

            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <h2 class="text-lg font-heading font-bold text-slate-900 mb-3 group-hover:text-brand-red transition-colors line-clamp-2">
                  <a href={`/nouvelles/${n.slug}`}>{n.title}</a>
                </h2>
                <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed mb-6">
                  {n.excerpt}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Endurance Aventure</span>
                <a href={`/nouvelles/${n.slug}`} class="text-xs font-bold uppercase tracking-wider text-brand-red hover:underline flex items-center gap-1.5">
                  <span>Lire l'article</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

</Layout>
