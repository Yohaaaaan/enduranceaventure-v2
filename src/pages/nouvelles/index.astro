---
import Layout from '../../layouts/Layout.astro';
import news from '../../data/news.json';
---

<Layout title="Actualités, Récits & Archives | Endurance Aventure" description="Découvrez les actualités, résumés de courses, vidéos et annonces d'Endurance Aventure.">
  
  <!-- Banner Sombre & Immersif avec Photo de Récit Épique -->
  <header class="relative min-h-[50vh] sm:min-h-[58vh] flex items-center bg-slate-950 border-b border-slate-800 overflow-hidden">
    <img 
      src="/assets/CAXTRI-2019-Extreme-Depart.webp" 
      alt="Départ d'épreuve et récits d'endurance extrême" 
      class="absolute inset-0 w-full h-full object-cover object-center opacity-70 brightness-90 contrast-105"
      onerror="this.src='/assets/Canada-Man-2018-Course-sentier.webp'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-black/40"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-16 sm:py-24 w-full">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/90 backdrop-blur-md border border-slate-700 text-brand-red text-xs font-bold uppercase tracking-widest mb-5 shadow-lg">
            <span class="w-2 h-2 rounded-full bg-brand-red animate-pulse"></span>
            Récits de Course, Médias & Histoire
          </div>
          <h1 class="text-4xl sm:text-6xl font-heading font-black uppercase tracking-tight text-white mb-4 drop-shadow-md">
            Actualités & Récits
          </h1>
          <p class="max-w-2xl text-base sm:text-lg text-slate-200 font-light leading-relaxed drop-shadow">
            Revivez les temps forts, les annonces officielles et les plus grands exploits d'Endurance Aventure à travers nos archives et articles.
          </p>
        </div>

        <div class="bg-slate-900/90 backdrop-blur-md px-5 py-3 rounded-2xl border border-slate-700/80 text-xs text-slate-300 shadow-xl self-start md:self-end">
          <span class="font-bold text-white text-base block">{news.length}</span> récits & publications archivés
        </div>
      </div>
    </div>
  </header>

  <!-- Contenu Principal sur Fond Clair -->
  <div class="bg-slate-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- News Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {news.map((n) => (
          <article class="rounded-3xl bg-white border border-slate-200 overflow-hidden flex flex-col group hover:border-slate-300 hover:shadow-xl transition-all duration-300 shadow-sm">
            <div class="relative h-52 overflow-hidden bg-slate-200">
              <img 
                src={n.image} 
                alt={n.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                onerror="this.src='/assets/EnduranceAventure.jpg'"
              />
              <span class="absolute top-3 right-3 px-2.5 py-1 rounded bg-black/75 text-[11px] font-semibold text-white backdrop-blur-sm">
                📅 {n.date}
              </span>
            </div>

            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <h2 class="text-lg font-heading font-bold text-slate-900 mb-3 group-hover:text-brand-red transition-colors line-clamp-2">
                  <a href={`/nouvelles/${n.slug}`}>{n.title}</a>
                </h2>
                <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed mb-6">
                  {n.excerpt}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Endurance Aventure</span>
                <a href={`/nouvelles/${n.slug}`} class="text-xs font-bold uppercase tracking-wider text-brand-red hover:underline flex items-center gap-1">
                  Lire l'article →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

</Layout>
