---
import Layout from '../../layouts/Layout.astro';
import news from '../../data/news.json';

export async function getStaticPaths() {
  return news.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.excerpt,
  "datePublished": post.date,
  "author": {
    "@type": "Organization",
    "name": "Endurance Aventure"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Endurance Aventure",
    "logo": {
      "@type": "ImageObject",
      "url": "https://enduranceaventure.com/assets/endurance-aventure-logo-blanc.png"
    }
  },
  "image": post.image ? `https://enduranceaventure.com${post.image}` : undefined
};
---

<Layout 
  title={`${post.title} | Actualités | Endurance Aventure`} 
  description={post.excerpt} 
  image={post.image}
  jsonLd={blogSchema}
>
  
  <!-- Header Sombre Immersif avec Photo de l'Article -->
  <header class="relative min-h-[48vh] sm:min-h-[55vh] flex items-center bg-slate-950 border-b border-slate-800 overflow-hidden">
    <img 
      src={post.image || '/assets/CAXTRI-2019-Extreme-Depart.webp'} 
      alt={post.title} 
      class="absolute inset-0 w-full h-full object-cover object-center opacity-90 brightness-95 contrast-105"
      onerror="this.src='/assets/EnduranceAventure.jpg'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-black/20 to-black/20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/50 via-transparent to-transparent"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-16 sm:py-20 w-full">
      <a href="/nouvelles/" class="text-xs font-bold uppercase tracking-wider text-brand-red hover:underline mb-4 inline-flex items-center gap-1.5 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span>Retour aux actualités</span>
      </a>
      <div class="text-xs text-brand-cyan font-bold uppercase tracking-wider mb-3">
        Publié le {post.date}
      </div>
      <h1 class="text-3xl sm:text-5xl font-heading font-black text-white leading-tight mb-4 drop-shadow-lg">
        {post.title}
      </h1>
    </div>
  </header>

  <!-- Contenu Principal sur Fond Clair (Confort de lecture éditorial) -->
  <article class="py-16 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Featured Image -->
      {post.image && (
        <div class="rounded-lg overflow-hidden mb-12 shadow-sm border border-slate-200 bg-slate-200 max-h-[500px]">
          <img 
            src={post.image} 
            alt={post.title} 
            class="w-full h-full object-cover"
            onerror="this.style.display='none'"
          />
        </div>
      )}

      <!-- Post Content Rendered -->
      <div class="bg-white rounded-lg border border-slate-200 p-8 sm:p-12 shadow-sm">
        <div class="prose prose-slate prose-lg max-w-none text-slate-800 leading-relaxed space-y-6" set:html={post.content} />

        <!-- Bottom navigation -->
        <div class="mt-16 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a href="/nouvelles" class="w-full sm:w-auto text-center px-6 py-3 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold uppercase tracking-wider transition-all inline-flex items-center justify-center gap-1.5 border border-slate-200">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            <span>Toutes les actualités</span>
          </a>
          <a href="/contact" class="w-full sm:w-auto text-center px-6 py-3 rounded-md bg-brand-red text-white text-xs font-heading font-bold uppercase tracking-wider hover:bg-brand-red-dark transition-all shadow-sm">
            Nous contacter
          </a>
        </div>
      </div>

    </div>
  </article>

</Layout>
