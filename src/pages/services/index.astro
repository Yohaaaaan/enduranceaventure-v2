---
import Layout from '../../layouts/Layout.astro';
import services from '../../data/services.json';
---

<Layout 
  title="Services Corporatifs & Production Télé | Endurance Aventure"
  description="Organisation d'événements sportifs et d'entreprise sur mesure, production télévisuelle, drones et chronométrage."
>
  <div class="bg-brand-darker py-16 border-b border-brand-gray/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-brand-cyan text-sm font-bold uppercase tracking-widest block mb-2">Expertise Professionnelle</span>
      <h1 class="text-4xl sm:text-6xl font-heading font-black uppercase tracking-tight text-white mb-4">
        Nos Services Corporatifs
      </h1>
      <p class="max-w-2xl text-base sm:text-lg text-slate-300 font-light leading-relaxed">
        Plus de 20 ans d'expérience dans la conception de défis outdoor sur mesure, la gestion logistique complexe et la réalisation audiovisuelle extrême.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="space-y-16">
      {services.map((srv, idx) => (
        <div class={`flex flex-col lg:flex-row items-center gap-12 rounded-3xl bg-brand-dark border border-brand-gray p-8 sm:p-12 ${idx % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
          <div class="w-full lg:w-1/2 rounded-2xl overflow-hidden shadow-2xl h-80">
            <img src={srv.image} alt={srv.title} class="w-full h-full object-cover" />
          </div>

          <div class="w-full lg:w-1/2">
            <h2 class="text-2xl sm:text-3xl font-heading font-bold text-white mb-4">
              {srv.title}
            </h2>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-6">
              {srv.description}
            </p>

            <div class="space-y-2.5 mb-8">
              {srv.features.map(f => (
                <div class="flex items-start gap-3 text-xs sm:text-sm text-slate-300">
                  <span class="text-brand-cyan font-bold">✓</span>
                  <span>{f}</span>
                </div>
              ))}
            </div>

            <a 
              href="/contact" 
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-brand-cyan hover:bg-brand-cyan-light text-white font-heading font-bold text-xs uppercase tracking-wider transition-all shadow-lg shadow-brand-cyan/20"
            >
              Demander une estimation →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
