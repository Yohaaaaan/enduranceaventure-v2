---
import Layout from '../../layouts/Layout.astro';
import events from '../../data/events.json';
import pastEvents from '../../data/pastEvents.json';

const featuredEvents = events.filter(e => e.featured);
const totalPastEvents = pastEvents.length;
---

<Layout 
  title="Nos Événements & Rétrospective Historique | Endurance Aventure" 
  description="Découvrez les 3 événements phares d'Endurance Aventure (GBC 500, Championnat du Monde Junior ARWS, Triathlon XTRI) et l'archive complète de nos épreuves historiques."
>
  
  <!-- Banner Sombre & Immersif avec Photo d'Action Réelle -->
  <header class="relative min-h-[55vh] sm:min-h-[62vh] flex items-center bg-slate-950 border-b border-slate-800 overflow-hidden">
    <img 
      src="/assets/Raid-Temis-reperage4.webp" 
      alt="Événements et expéditions sportives Endurance Aventure" 
      class="absolute inset-0 w-full h-full object-cover object-center opacity-100 brightness-105 contrast-105" 
      onerror="this.src='/assets/51585599881_b5e2815724_o-scaled.webp'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-black/10 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/50 via-slate-950/20 to-transparent"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-16 sm:py-24">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-slate-900 border-l-2 border-brand-red text-slate-200 text-xs font-heading font-bold uppercase tracking-wider mb-5">
        <span>Calendrier & Archives Historiques Officielles</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-heading font-black uppercase tracking-tight text-white mb-6 drop-shadow-lg">
        Les Événements <br class="hidden sm:inline" />
        <span class="text-white drop-shadow">Endurance Aventure</span>
      </h1>

      <!-- Quick Nav Buttons -->
      <div class="flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4 pt-2">
        <a 
          href="#phares" 
          class="w-full sm:w-auto px-5 py-3 sm:py-2.5 min-h-[44px] rounded-md bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-xs uppercase tracking-wider transition-all shadow-sm flex items-center justify-center gap-2"
        >
          <span>3 Événements Phares</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        </a>
        <a 
          href="#archives" 
          class="w-full sm:w-auto px-5 py-3 sm:py-2.5 min-h-[44px] rounded-md bg-slate-900 hover:bg-slate-800 text-slate-200 hover:text-white border border-slate-700/80 font-heading font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 shadow-sm"
        >
          <span>Historique Complet ({totalPastEvents} Épreuves)</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        </a>
      </div>
    </div>
  </header>

  <!-- ========================================== -->
  <!-- SECTION 1 : LES 3 ÉVÉNEMENTS PHARES        -->
  <!-- ========================================== -->
  <section id="phares" class="bg-slate-100 py-16 sm:py-20 border-b border-slate-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-slate-300 pb-6">
        <div>
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-1">Sélection Majeure</span>
          <h2 class="text-3xl sm:text-4xl font-heading font-black uppercase tracking-tight text-slate-900">
            Nos 3 Événements Phares
          </h2>
          <p class="mt-2 text-sm sm:text-base text-slate-600 max-w-2xl">
            Les piliers actuels et légendaires de notre organisation : gravel bike en autonomie, championnats mondiaux de raid et triathlon extrême.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {featuredEvents.map((evt) => {
          const hasVideo = Boolean(evt.video);
          const hasImages = evt.images && evt.images.length > 0;
          const defaultTab = hasVideo ? 'video' : 'photos';

          return (
            <article 
              class="featured-event-card rounded-lg bg-white border border-slate-200 overflow-hidden flex flex-col group hover:border-slate-300 hover:shadow-lg transition-all duration-300 shadow-sm"
              id={evt.id}
            >
              <!-- Card Header Info -->
              <div class="p-6 sm:p-8 pb-4">
                <!-- Header : Titre & Logos officiels -->
                <div class="flex items-start justify-between gap-4 mb-3">
                  <div class="flex-grow">
                    <h3 class="text-2xl font-heading font-black text-slate-900 mb-1 group-hover:text-brand-red transition-colors">
                      {evt.title}
                    </h3>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                      {evt.subtitle}
                    </p>
                  </div>

                  <!-- Logos Partenaires / Épreuve -->
                  {evt.logo && (
                    <div class="flex items-center gap-2 p-1.5 px-3 rounded-md bg-slate-50 border border-slate-200 shadow-xs flex-shrink-0">
                      <img 
                        src={evt.logo} 
                        alt={`Logo officiel ${evt.title}`} 
                        class="h-8 sm:h-9 w-auto object-contain max-w-[110px]" 
                      />
                      {evt.secondaryLogo && (
                        <>
                          <div class="h-5 w-px bg-slate-200"></div>
                          <img 
                            src={evt.secondaryLogo} 
                            alt={`Logo partenaire ${evt.title}`} 
                            class="h-7 sm:h-8 w-auto object-contain max-w-[80px]" 
                          />
                        </>
                      )}
                    </div>
                  )}
                </div>

                <!-- Métadonnées typographiques propres : Date • Lieu • Distance/Format -->
                <div class="flex flex-wrap items-center gap-y-1.5 gap-x-3 text-xs text-slate-600 mb-5 pb-3 border-b border-slate-100 font-medium pt-1">
                  <span class="text-brand-red font-heading font-bold uppercase tracking-wider flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 flex-shrink-0 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    <span>{evt.dates}</span>
                  </span>
                  <span class="text-slate-300">•</span>
                  <span class="flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 flex-shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <span>{evt.location}</span>
                  </span>
                  <span class="text-slate-300">•</span>
                  <span class="flex items-center gap-1.5 text-slate-700 font-semibold">
                    <svg class="w-3.5 h-3.5 flex-shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    <span>{evt.distance}</span>
                  </span>
                </div>

                <!-- Showcase Média (Vidéo / Photos) Positionné en Haut pour Impact Visuel Immédiat -->
                <div class="mb-5">
                  {/* Media Switcher Tabs (if both video & images exist) */}
                  {hasVideo && hasImages && (
                    <div class="flex items-center gap-2 mb-3 border-b border-slate-200 pb-2">
                      <button 
                        type="button" 
                        class="media-tab-btn active px-3.5 py-2 min-h-[44px] rounded-sm text-xs font-heading font-bold uppercase tracking-wider bg-slate-900 text-white transition-colors flex items-center gap-1.5"
                        data-target="video"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <span>Vidéo Officielle</span>
                      </button>
                      <button 
                        type="button" 
                        class="media-tab-btn px-3.5 py-2 min-h-[44px] rounded-sm text-xs font-heading font-bold uppercase tracking-wider bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors flex items-center gap-1.5"
                        data-target="photos"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        <span>Photos ({evt.images.length})</span>
                      </button>
                    </div>
                  )}

                  <!-- Video Viewport -->
                  {hasVideo && (
                    <div class={`media-panel media-panel-video ${defaultTab === 'video' ? 'block' : 'hidden'} mb-4`}>
                      <div class="relative w-full aspect-video bg-black rounded-md overflow-hidden shadow-inner border border-slate-800">
                        <iframe 
                          src={evt.video} 
                          title={`Vidéo officielle : ${evt.title}`}
                          class="w-full h-full border-0" 
                          loading="lazy"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                          allowfullscreen
                        ></iframe>
                      </div>
                    </div>
                  )}

                  <!-- Photos Viewport -->
                  {hasImages && (
                    <div class={`media-panel media-panel-photos ${defaultTab === 'photos' ? 'block' : (hasVideo ? 'hidden' : 'block')} mb-4`}>
                      <div class="relative aspect-[16/10] bg-slate-900 rounded-md overflow-hidden shadow-inner border border-slate-200 mb-2 group">
                        <img 
                          src={evt.images[0]} 
                          alt={`${evt.title} - Photo 1`}
                          class="main-preview-img w-full h-full object-cover transition-opacity duration-200"
                          loading="lazy"
                        />
                        <span class="absolute bottom-2 right-2 px-2 py-0.5 rounded-sm bg-black/75 text-white text-[10px] font-mono font-medium backdrop-blur-sm pointer-events-none">
                          {evt.images.length} photos
                        </span>
                      </div>

                      <!-- Thumbnails row -->
                      {evt.images.length > 1 && (
                        <div class="flex gap-2 overflow-x-auto pb-1 pt-1 no-scrollbar">
                          {evt.images.map((img, idx) => (
                            <button 
                              type="button" 
                              class={`thumb-btn flex-shrink-0 w-14 h-10 sm:w-16 sm:h-11 rounded-sm overflow-hidden border-2 transition-all ${idx === 0 ? 'border-brand-red ring-1 ring-brand-red/40' : 'border-transparent opacity-75 hover:opacity-100 hover:border-slate-300'}`}
                              data-src={img}
                              data-alt={`${evt.title} - Photo ${idx + 1}`}
                              aria-label={`Afficher la photo ${idx + 1}`}
                            >
                              <img src={img} alt={`Miniature ${idx + 1}`} class="w-full h-full object-cover" loading="lazy" />
                            </button>
                          ))}
                        </div>
                      )}
                    </div>
                  )}
                </div>

                <p class="text-sm text-slate-600 mb-4 leading-relaxed">
                  {evt.description}
                </p>

                <!-- Spécifications / Highlights -->
                <div class="bg-slate-50 rounded-md p-4 mb-2 border border-slate-200">
                  <div class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 bg-brand-red flex-shrink-0"></span>
                    <span>Faits saillants & Spécifications</span>
                  </div>
                  <ul class="grid grid-cols-1 gap-2 text-xs text-slate-600">
                    {evt.highlights.map(h => (
                      <li class="flex items-start gap-2">
                        <span class="w-1.5 h-1.5 bg-brand-red mt-1.5 flex-shrink-0"></span>
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Action Card Footer -->
              <div class="px-6 sm:px-8 pb-6 pt-4 border-t border-slate-100 flex items-center justify-end mt-auto">
                {evt.registrationLink && evt.registrationLink !== '#' ? (
                  <a 
                    href={evt.registrationLink} 
                    target={evt.registrationLink.startsWith('http') ? '_blank' : undefined}
                    rel={evt.registrationLink.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="w-full sm:w-auto justify-center px-6 py-2.5 rounded-md bg-brand-red hover:bg-brand-red-dark text-white text-xs font-heading font-bold uppercase tracking-wider transition-all shadow-sm inline-flex items-center gap-2 group-hover:translate-x-0.5 duration-200"
                  >
                    <span>Visiter le site</span>
                    {evt.registrationLink.startsWith('http') ? (
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    ) : (
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    )}
                  </a>
                ) : (
                  <span class="w-full sm:w-auto justify-center px-6 py-2.5 rounded-md bg-slate-100 text-slate-400 border border-slate-200 text-xs font-heading font-bold uppercase tracking-wider inline-flex items-center gap-2 cursor-not-allowed">
                    À venir
                  </span>
                )}
              </div>

            </article>
          );
        })}
      </div>

    </div>
  </section>

  <!-- ========================================== -->
  <!-- SECTION 2 : HISTORIQUE COMPLET             -->
  <!-- ========================================== -->
  <section id="archives" class="bg-slate-50 py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="max-w-3xl mb-12 border-b border-slate-200 pb-6">
        <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-1">
          Rétrospective Intégrale
        </span>
        <h2 class="text-3xl sm:text-4xl font-heading font-black uppercase tracking-tight text-slate-900 mb-3">
          L'Historique Complet de Nos Événements
        </h2>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Toutes les épreuves, expéditions et championnats produits et coordonnés par l'équipe d'Endurance Aventure depuis 2008. Textes originaux intégraux, galeries photographiques et films officiels d’époque.
        </p>
      </div>

      <!-- Past Events Grid (Toutes les épreuves affichées directement sans tri) -->
      <div id="past-events-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {pastEvents.map((evt) => {
          const hasVideo = Boolean(evt.video);
          const hasImages = evt.images && evt.images.length > 0;
          const defaultTab = hasVideo ? 'video' : 'photos';

          return (
            <article 
              class="past-event-card bg-white rounded-lg border border-slate-200 overflow-hidden flex flex-col shadow-sm hover:shadow-md hover:border-slate-300 transition-all duration-200"
              data-year={evt.year}
              id={evt.id}
            >
              
              <!-- Card Header Info -->
              <div class="p-6 sm:p-7 pb-4">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                  <div class="flex items-center gap-2">
                    <span class="px-2.5 py-1 rounded-sm bg-slate-900 text-white font-mono font-bold text-xs tracking-wider">
                      {evt.year}
                    </span>
                    <span class="px-2.5 py-1 rounded-sm bg-red-50 text-brand-red border border-red-200 text-xs font-bold uppercase tracking-wider">
                      {evt.category}
                    </span>
                  </div>
                  <span class="text-xs text-slate-500 font-medium flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <span>{evt.location}</span>
                  </span>
                </div>

                <h3 class="text-xl sm:text-2xl font-heading font-black text-slate-900 mb-3 hover:text-brand-red transition-colors">
                  {evt.title}
                </h3>

                <p class="text-sm text-slate-600 leading-relaxed">
                  {evt.description}
                </p>
              </div>

              <!-- Media Tabs / Showcase Section -->
              <div class="px-6 sm:px-7 pb-6 flex-grow flex flex-col justify-end">
                
                {/* Media Switcher Tabs (if both video & images exist) */}
                {hasVideo && hasImages && (
                  <div class="flex items-center gap-2 mb-3 border-b border-slate-200 pb-2">
                    <button 
                      type="button" 
                      class="media-tab-btn active px-3.5 py-2 min-h-[44px] rounded-sm text-xs font-heading font-bold uppercase tracking-wider bg-slate-900 text-white transition-colors flex items-center gap-1.5"
                      data-target="video"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      <span>Vidéo Officielle</span>
                    </button>
                    <button 
                      type="button" 
                      class="media-tab-btn px-3.5 py-2 min-h-[44px] rounded-sm text-xs font-heading font-bold uppercase tracking-wider bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors flex items-center gap-1.5"
                      data-target="photos"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                      <span>Photos ({evt.images.length})</span>
                    </button>
                  </div>
                )}

                <!-- Video Viewport (Authentic Vimeo/YouTube embed) -->
                {hasVideo && (
                  <div class={`media-panel media-panel-video ${defaultTab === 'video' ? 'block' : 'hidden'} mb-4`}>
                    <div class="relative w-full aspect-video bg-black rounded-md overflow-hidden shadow-inner border border-slate-800">
                      <iframe 
                        src={evt.video} 
                        title={`Vidéo officielle : ${evt.title}`}
                        class="w-full h-full border-0" 
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                        allowfullscreen
                      ></iframe>
                    </div>
                  </div>
                )}

                <!-- Photos Viewport -->
                {hasImages && (
                  <div class={`media-panel media-panel-photos ${defaultTab === 'photos' ? 'block' : (hasVideo ? 'hidden' : 'block')} mb-4`}>
                    <!-- Main Image Preview -->
                    <div class="relative aspect-[16/10] bg-slate-900 rounded-md overflow-hidden shadow-inner border border-slate-200 mb-2 group">
                      <img 
                        src={evt.images[0]} 
                        alt={`${evt.title} - Photo 1`}
                        class="main-preview-img w-full h-full object-cover transition-opacity duration-200"
                        loading="lazy"
                      />
                      <span class="absolute bottom-2 right-2 px-2 py-0.5 rounded-sm bg-black/75 text-white text-[10px] font-mono font-medium backdrop-blur-sm pointer-events-none">
                        {evt.images.length} photos
                      </span>
                    </div>

                    <!-- Thumbnails row -->
                    {evt.images.length > 1 && (
                      <div class="flex gap-2 overflow-x-auto pb-1 pt-1 no-scrollbar">
                        {evt.images.map((img, idx) => (
                          <button 
                            type="button" 
                            class={`thumb-btn flex-shrink-0 w-14 h-10 sm:w-16 sm:h-11 rounded-sm overflow-hidden border-2 transition-all ${idx === 0 ? 'border-brand-red ring-1 ring-brand-red/40' : 'border-transparent opacity-75 hover:opacity-100 hover:border-slate-300'}`}
                            data-src={img}
                            data-alt={`${evt.title} - Photo ${idx + 1}`}
                            aria-label={`Afficher la photo ${idx + 1}`}
                          >
                            <img src={img} alt={`Miniature ${idx + 1}`} class="w-full h-full object-cover" loading="lazy" />
                          </button>
                        ))}
                      </div>
                    )}
                  </div>
                )}

                <!-- Card Footer with Dead Link for "En savoir plus" -->
                <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                  <span class="font-medium text-slate-400">
                    Archives officielles Endurance Aventure
                  </span>
                  
                  <!-- Lien mort demandé expressément par l'utilisateur -->
                  <a 
                    href="#" 
                    onclick="event.preventDefault(); return false;" 
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-700 font-heading font-bold uppercase tracking-wider text-[11px] border border-slate-200 transition-colors cursor-not-allowed"
                    title="Archive historique documentée – consultation sur place"
                  >
                    <span>En savoir plus</span>
                    <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                  </a>
                </div>

              </div>

            </article>
          );
        })}
      </div>

    </div>
  </section>

</Layout>

<!-- Client Side Script for Media Switchers and Photo Previews -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Interactive Thumbnail Switching for each card (featured & past events)
    document.querySelectorAll('.featured-event-card, .past-event-card').forEach(card => {
      const mainImg = card.querySelector('.main-preview-img');
      const thumbs = card.querySelectorAll('.thumb-btn');

      thumbs.forEach(thumb => {
        thumb.addEventListener('click', () => {
          const newSrc = thumb.getAttribute('data-src');
          const newAlt = thumb.getAttribute('data-alt');
          
          if (mainImg && newSrc) {
            mainImg.classList.add('opacity-40');
            setTimeout(() => {
              mainImg.src = newSrc;
              if (newAlt) mainImg.alt = newAlt;
              mainImg.classList.remove('opacity-40');
            }, 120);
          }

          thumbs.forEach(t => {
            t.classList.remove('border-brand-red', 'ring-1', 'ring-brand-red/40');
            t.classList.add('border-transparent', 'opacity-75');
          });
          thumb.classList.add('border-brand-red', 'ring-1', 'ring-brand-red/40');
          thumb.classList.remove('border-transparent', 'opacity-75');
        });
      });

      // 2. Media Tab Switcher (Video vs Photos)
      const tabBtns = card.querySelectorAll('.media-tab-btn');
      const videoPanel = card.querySelector('.media-panel-video');
      const photosPanel = card.querySelector('.media-panel-photos');

      tabBtns.forEach(tab => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-target');

          tabBtns.forEach(t => {
            t.classList.remove('bg-slate-900', 'text-white', 'active');
            t.classList.add('bg-slate-100', 'text-slate-700', 'hover:bg-slate-200');
          });
          tab.classList.add('bg-slate-900', 'text-white', 'active');
          tab.classList.remove('bg-slate-100', 'text-slate-700', 'hover:bg-slate-200');

          if (target === 'video') {
            if (videoPanel) videoPanel.classList.remove('hidden');
            if (photosPanel) photosPanel.classList.add('hidden');
          } else {
            if (photosPanel) photosPanel.classList.remove('hidden');
            if (videoPanel) videoPanel.classList.add('hidden');
          }
        });
      });
    });
  });
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
