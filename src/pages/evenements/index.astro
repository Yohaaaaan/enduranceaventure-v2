---
import Layout from '../../layouts/Layout.astro';
import events from '../../data/events.json';
---

<Layout title="Nos Événements Sportifs | Endurance Aventure" description="Découvrez les courses et défis sportifs d'Endurance Aventure : GBC 500, Trail des Neiges, Raids Multisports.">
  
  <!-- Banner Sombre & Immersif -->
  <div class="bg-slate-950 py-16 sm:py-20 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Calendrier & Défis 2026/2027</span>
      <h1 class="text-4xl sm:text-6xl font-heading font-black uppercase tracking-tight text-white mb-4">
        Nos Événements Sportifs
      </h1>
      <p class="max-w-2xl text-base sm:text-lg text-slate-300 font-light leading-relaxed">
        Des épreuves d'endurance authentiques, encadrées avec rigueur et tracées au cœur des paysages les plus spectaculaires du Québec.
      </p>
    </div>
  </div>

  <!-- Contenu Principal sur Fond Clair -->
  <div class="bg-slate-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        {events.map((evt) => (
          <div class="rounded-3xl bg-white border border-slate-200 overflow-hidden flex flex-col group hover:border-slate-300 hover:shadow-xl transition-all duration-300 shadow-sm">
            <div class="relative h-72 overflow-hidden bg-slate-200">
              <img 
                src={evt.image} 
                alt={evt.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <span class="absolute top-4 left-4 px-3 py-1 rounded bg-brand-red text-white text-xs font-bold uppercase tracking-wider shadow-md">
                {evt.category}
              </span>

              <!-- Badge Logos Officiels sur fond blanc immaculé (Argon 18 & GBC 500 etc.) -->
              {evt.logo && (
                <div class="absolute top-4 right-4 p-2 sm:p-2.5 rounded-2xl bg-white shadow-xl border border-slate-200/90 flex items-center gap-2.5 z-10">
                  <img 
                    src={evt.logo} 
                    alt={`Logo ${evt.title}`} 
                    class="h-10 sm:h-12 w-auto object-contain max-w-[120px]" 
                  />
                  {evt.secondaryLogo && (
                    <>
                      <div class="h-8 w-px bg-slate-200"></div>
                      <img 
                        src={evt.secondaryLogo} 
                        alt="Partenaire Titre Argon 18" 
                        class="h-7 sm:h-9 w-auto object-contain max-w-[90px]" 
                      />
                    </>
                  )}
                </div>
              )}

              <span class="absolute bottom-4 left-4 px-3 py-1 rounded bg-slate-950/80 text-white text-xs font-semibold backdrop-blur-md">
                📍 {evt.location}
              </span>
            </div>

            <div class="p-8 flex-grow flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs text-brand-cyan font-bold uppercase tracking-wider mb-2">
                  <span>{evt.dates}</span>
                  <span class="px-2 py-0.5 rounded bg-cyan-50 border border-cyan-200">{evt.distance}</span>
                </div>
                <h2 class="text-2xl font-heading font-bold text-slate-900 mb-3 group-hover:text-brand-red transition-colors">
                  {evt.title}
                </h2>
                <p class="text-sm text-slate-600 mb-6 leading-relaxed">
                  {evt.description}
                </p>

                <div class="bg-slate-50 rounded-2xl p-4 mb-6 border border-slate-200">
                  <div class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Spécifications du parcours :</div>
                  <ul class="space-y-1.5 text-xs text-slate-600">
                    {evt.highlights.map(h => (
                      <li class="flex items-center gap-2">
                        <span class="text-brand-red font-bold">✓</span>
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="flex items-center justify-between gap-4 pt-4 border-t border-slate-100">
                <span class="text-xs font-semibold px-3 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                  {evt.status}
                </span>
                <a 
                  href={evt.slug.startsWith('raid-') ? '/evenements/raids/' : `/evenements/${evt.slug}/`} 
                  class="px-5 py-2.5 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white text-xs font-heading font-bold uppercase tracking-wider transition-all shadow-md shadow-brand-red/20"
                >
                  Accéder à l'épreuve →
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

</Layout>
