---
import Layout from '../../layouts/Layout.astro';

const gbcSchema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": "Gravel Bikepacking Challenge 500 (GBC 500)",
  "description": "L'épreuve reine de vélo de gravelle et de bikepacking au Québec : 500 km, 250 km ou 100 km en autonomie à travers les Cantons-de-l'Est.",
  "startDate": "2026-08-01",
  "endDate": "2026-08-05",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": {
    "@type": "Place",
    "name": "Parc national du Mont-Mégantic",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Notre-Dame-des-Bois",
      "addressRegion": "QC",
      "addressCountry": "CA"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": "Endurance Aventure",
    "url": "https://enduranceaventure.com"
  }
};
---

<Layout 
  title="GBC 500 | Gravel Bikepacking Challenge | Endurance Aventure"
  description="L'épreuve reine de vélo de gravelle et de bikepacking au Québec. 500 km, 250 km ou 100 km à travers les Cantons-de-l'Est et le Mont Mégantic."
  image="/assets/2023-08-05_GBC500_mc_1498-scaled.webp"
  jsonLd={gbcSchema}
>

  <!-- BANNER HERO GBC500 SOMBRE (Action & Immersion) -->
  <section class="relative min-h-[65vh] flex items-center justify-center bg-slate-950 overflow-hidden">
    <img 
      src="/assets/2023-08-05_GBC500_mc_1498-scaled.webp" 
      alt="GBC 500 Gravel Bike" 
      class="absolute inset-0 w-full h-full object-cover opacity-35 scale-105"
      onerror="this.src='/assets/2023-08-05_GBC500_mc_1498-scaled.jpg'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-transparent"></div>
    
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-20">
      <img 
        src="/assets/logo-GBC500-ARGON18.png" 
        alt="Logo GBC 500 Argon 18" 
        class="h-20 sm:h-28 w-auto mx-auto mb-6 object-contain drop-shadow-xl"
      />
      <h1 class="text-4xl sm:text-6xl font-heading font-black uppercase tracking-tight text-white mb-4">
        Gravel Bikepacking Challenge 500
      </h1>
      <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto font-light leading-relaxed mb-8">
        500 kilomètres d'autonomie, de poussière, de dénivelé et de liberté absolue sur les plus belles routes non pavées des Cantons-de-l'Est.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a 
          href="/contact?type=general&subject=gbc500" 
          class="px-8 py-4 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-sm uppercase tracking-wider transition-all shadow-xl shadow-brand-red/30"
        >
          S'inscrire à l'Édition 2026
        </a>
        <a 
          href="#gpx" 
          class="px-8 py-4 rounded-xl bg-slate-900/80 border border-slate-700 hover:border-slate-500 text-slate-200 text-sm font-bold uppercase tracking-wider transition-all backdrop-blur-sm"
        >
          Traces GPX & Cartes
        </a>
        <a 
          href="#reglements" 
          class="px-8 py-4 rounded-xl bg-slate-900/80 border border-slate-700 hover:border-slate-500 text-slate-200 text-sm font-bold uppercase tracking-wider transition-all backdrop-blur-sm"
        >
          Guide & Règlements
        </a>
      </div>
    </div>
  </section>

  <!-- CONTENU PRINCIPAL SUR FOND CLAIR (Lecture et étude de parcours optimales) -->
  <div class="bg-slate-50 py-20 space-y-24">
    
    <!-- Distances & Formats -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Formats Officiels</span>
        <h2 class="text-3xl sm:text-4xl font-heading font-black uppercase text-slate-900">
          3 Défis Adaptés à Vos Objectifs
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Format 500 km -->
        <div class="rounded-3xl bg-white border-2 border-brand-red p-8 sm:p-10 flex flex-col justify-between relative shadow-xl">
          <span class="absolute -top-3.5 right-6 px-3.5 py-1 rounded-full bg-brand-red text-white text-[11px] font-bold uppercase tracking-wider shadow">
            L'Épreuve Reine
          </span>
          <div>
            <div class="text-4xl font-heading font-black text-brand-red mb-1">500 KM</div>
            <div class="text-xs uppercase tracking-wider text-slate-500 font-semibold mb-4">Autonomie complète ou par étapes</div>
            <p class="text-sm text-slate-600 leading-relaxed mb-6">
              Le tour complet des Cantons-de-l'Est et de la Réserve internationale de ciel étoilé du Mont Mégantic. Plus de 6 000 m de dénivelé positif cumulé.
            </p>
            <ul class="space-y-2.5 text-xs text-slate-700 mb-8 border-t border-slate-100 pt-4">
              <li class="flex items-center gap-2"><span class="text-brand-red font-bold">✓</span> Suivi GPS en direct par balise satellite</li>
              <li class="flex items-center gap-2"><span class="text-brand-red font-bold">✓</span> Points de ravitaillement et bivouacs officiels</li>
              <li class="flex items-center gap-2"><span class="text-brand-red font-bold">✓</span> Finisher Patch & T-shirt exclusif Argon 18</li>
            </ul>
          </div>
          <a href="/contact?type=general&subject=gbc500" class="w-full py-3.5 rounded-xl bg-brand-red text-white font-heading font-bold text-center text-xs uppercase tracking-wider hover:bg-brand-red-dark transition-all shadow-md">
            S'inscrire au 500 km
          </a>
        </div>

        <!-- Format 250 km -->
        <div class="rounded-3xl bg-white border border-slate-200 p-8 sm:p-10 flex flex-col justify-between shadow-sm hover:shadow-lg transition-all">
          <div>
            <div class="text-4xl font-heading font-black text-slate-900 mb-1">250 KM</div>
            <div class="text-xs uppercase tracking-wider text-slate-500 font-semibold mb-4">Le Semi-Bikepacking Express</div>
            <p class="text-sm text-slate-600 leading-relaxed mb-6">
              Une immersion dense de 2 jours avec nuitée en bivouac pour découvrir l'esprit du gravel bikepacking sur un tracé spectaculaire.
            </p>
            <ul class="space-y-2.5 text-xs text-slate-700 mb-8 border-t border-slate-100 pt-4">
              <li class="flex items-center gap-2"><span class="text-brand-cyan font-bold">✓</span> Idéal pour une première expérience bikepacking</li>
              <li class="flex items-center gap-2"><span class="text-brand-cyan font-bold">✓</span> Trace GPX certifiée fournie</li>
              <li class="flex items-center gap-2"><span class="text-brand-cyan font-bold">✓</span> Repas d'arrivée festif & douche</li>
            </ul>
          </div>
          <a href="/contact?type=general&subject=gbc500" class="w-full py-3.5 rounded-xl bg-slate-900 text-white font-heading font-bold text-center text-xs uppercase tracking-wider hover:bg-brand-red transition-all shadow-md">
            S'inscrire au 250 km
          </a>
        </div>

        <!-- Format 100 km -->
        <div class="rounded-3xl bg-white border border-slate-200 p-8 sm:p-10 flex flex-col justify-between shadow-sm hover:shadow-lg transition-all">
          <div>
            <div class="text-4xl font-heading font-black text-brand-cyan mb-1">100 KM</div>
            <div class="text-xs uppercase tracking-wider text-slate-500 font-semibold mb-4">Gravel Day Challenge</div>
            <p class="text-sm text-slate-600 leading-relaxed mb-6">
              Une journée pure gravelle sur les chemins de rang pittoresques sans charge de bivouac. Accessible et rythmé.
            </p>
            <ul class="space-y-2.5 text-xs text-slate-700 mb-8 border-t border-slate-100 pt-4">
              <li class="flex items-center gap-2"><span class="text-slate-900 font-bold">✓</span> Ravitaillements liquides et solides</li>
              <li class="flex items-center gap-2"><span class="text-slate-900 font-bold">✓</span> Assistance mécanique au départ</li>
              <li class="flex items-center gap-2"><span class="text-slate-900 font-bold">✓</span> Médaille commémorative Finisher</li>
            </ul>
          </div>
          <a href="/contact?type=general&subject=gbc500" class="w-full py-3.5 rounded-xl bg-slate-900 text-white font-heading font-bold text-center text-xs uppercase tracking-wider hover:bg-brand-red transition-all shadow-md">
            S'inscrire au 100 km
          </a>
        </div>

      </div>

    </section>

    <!-- SECTION MATÉRIEL OBLIGATOIRE & SÉCURITÉ (Ancrée dans la réalité du terrain) -->
    <section id="reglements" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm">
        <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Sécurité & Autonomie</span>
        <h3 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900 mb-6">
          Équipement Obligatoire des Athlètes
        </h3>
        <p class="text-sm text-slate-600 mb-8 leading-relaxed">
          Le GBC 500 traverse des secteurs forestiers isolés. Pour garantir votre sécurité, un contrôle technique du matériel est effectué avant le départ.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm text-slate-700">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="font-bold text-slate-900">Éclairage & Visibilité</div>
            <div>• Feu avant puissant (minimum 500 lumens) avec autonomie pour la nuit.</div>
            <div>• Feu arrière rouge clignotant + gilet ou bandes réfléchissantes.</div>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="font-bold text-slate-900">Navigation & Communication</div>
            <div>• Compteur GPS ou montre avec la trace GPX officielle chargée.</div>
            <div>• Téléphone cellulaire chargé dans un étui étanche + batterie externe (power bank).</div>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="font-bold text-slate-900">Survie & Premiers Soins</div>
            <div>• Couverture isothermique de survie et sifflet sans bille.</div>
            <div>• Trousse de premiers soins de base et réserve d'eau minimale de 1,5 L.</div>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="font-bold text-slate-900">Mécanique & Dépannage</div>
            <div>• 2 chambres à air adaptées (ou mèches tubeless) + pompe ou cartouches CO2.</div>
            <div>• Outil multifonction avec dérive-chaîne et maillon rapide (quick-link).</div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION TRACES GPX & CARTOGRAPHIE (Indispensable pour la préparation des coureurs) -->
    <section id="gpx" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm">
        <div class="mb-8">
          <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest block mb-2">Navigation & Tracés</span>
          <h3 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900">
            Cartographie & Fichiers GPX Officiels
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 max-w-2xl leading-relaxed">
            Les tracés officiels sont reconnus et validés sur le terrain. Chargez directement les fichiers .GPX sur votre compteur GPS (Garmin, Wahoo, Hammerhead).
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-bold uppercase text-brand-red mb-1">Boucle Intégrale</div>
              <div class="text-xl font-heading font-black text-slate-900 mb-2">Trace GPX 500 KM</div>
              <div class="text-xs text-slate-600 space-y-1.5 mb-6">
                <div>• Dénivelé : +6 150 m D+</div>
                <div>• Terrain : 78% Gravelle / 22% Rang</div>
                <div>• POI bivouacs et ravitaillements inclus</div>
              </div>
            </div>
            <a 
              href="/contact?type=general&subject=gbc500" 
              class="w-full py-2.5 rounded-lg bg-slate-900 hover:bg-brand-red text-white text-xs font-heading font-bold uppercase tracking-wider text-center transition-colors shadow-sm"
            >
              Demander le tracé 500k
            </a>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-bold uppercase text-slate-600 mb-1">Semi-Bikepacking</div>
              <div class="text-xl font-heading font-black text-slate-900 mb-2">Trace GPX 250 KM</div>
              <div class="text-xs text-slate-600 space-y-1.5 mb-6">
                <div>• Dénivelé : +3 200 m D+</div>
                <div>• Terrain : 82% Gravelle / 18% Rang</div>
                <div>• Étape bivouac mi-parcours identifiée</div>
              </div>
            </div>
            <a 
              href="/contact?type=general&subject=gbc500" 
              class="w-full py-2.5 rounded-lg bg-slate-900 hover:bg-brand-red text-white text-xs font-heading font-bold uppercase tracking-wider text-center transition-colors shadow-sm"
            >
              Demander le tracé 250k
            </a>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-bold uppercase text-brand-cyan mb-1">Gravel Day</div>
              <div class="text-xl font-heading font-black text-slate-900 mb-2">Trace GPX 100 KM</div>
              <div class="text-xs text-slate-600 space-y-1.5 mb-6">
                <div>• Dénivelé : +1 450 m D+</div>
                <div>• Terrain : 85% Gravelle roulante</div>
                <div>• Ravitaillements km 45 et km 75</div>
              </div>
            </div>
            <a 
              href="/contact?type=general&subject=gbc500" 
              class="w-full py-2.5 rounded-lg bg-slate-900 hover:bg-brand-red text-white text-xs font-heading font-bold uppercase tracking-wider text-center transition-colors shadow-sm"
            >
              Demander le tracé 100k
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- BANDEAU SUIVI GPS HARMONISÉ -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-slate-100 text-slate-900 p-8 sm:p-12 border border-slate-300/80 shadow-sm flex flex-col md:flex-row items-center justify-between gap-8">
        <div>
          <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest block mb-2">Pendant la Course</span>
          <h3 class="text-2xl font-heading font-black uppercase text-slate-900 mb-2">Suivi GPS Satellite en Direct</h3>
          <p class="text-xs sm:text-sm text-slate-600 max-w-lg leading-relaxed">
            Suivez la progression des cyclistes en temps réel sur la carte interactive satellite avec pointages automatiques à chaque relais officiel.
          </p>
        </div>
        <a 
          href="/contact/" 
          class="px-8 py-4 rounded-xl bg-brand-cyan hover:bg-cyan-600 text-white font-heading font-bold text-xs uppercase tracking-wider transition-all flex-shrink-0 shadow-md shadow-brand-cyan/20"
        >
          Accéder à la Carte Satellite →
        </a>
      </div>
    </section>

  </div>

</Layout>
