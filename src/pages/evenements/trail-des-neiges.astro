---
import Layout from '../../layouts/Layout.astro';

const trailSchema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": "Trail des Neiges Mont-Orford",
  "description": "La classique hivernale de course en sentier enneigé au Mont-Orford : épreuves 5 km, 10 km et 15 km nocturne.",
  "startDate": "2027-02-06",
  "endDate": "2027-02-06",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": {
    "@type": "Place",
    "name": "Parc national du Mont-Orford",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Orford",
      "addressRegion": "QC",
      "addressCountry": "CA"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": "Endurance Aventure",
    "url": "https://enduranceaventure.com"
  }
};
---

<Layout 
  title="Trail des Neiges | Mont-Orford | Endurance Aventure"
  description="La classique hivernale de course en sentier enneigé au Mont-Orford. Épreuves 5 km, 10 km et 15 km nocturne."
  image="/assets/51581835318_775ae15a4e_k.webp"
  jsonLd={trailSchema}
>

  <!-- BANNER HERO SOMBRE (Ambiance hivernale nocturne) -->
  <section class="relative min-h-[85vh] sm:min-h-screen flex items-center justify-center bg-slate-950 overflow-hidden">
    <img 
      src="/assets/51581835318_775ae15a4e_k.webp" 
      alt="Trail des Neiges Mont-Orford" 
      class="absolute inset-0 w-full h-full object-cover opacity-80 brightness-90 contrast-105"
      onerror="this.src='/assets/51581835318_775ae15a4e_k.jpg'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-black/20 to-black/30"></div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center py-24 sm:py-32">
      <span class="px-3.5 py-1.5 rounded-full bg-brand-cyan text-white text-xs font-bold uppercase tracking-wider mb-4 inline-block shadow">
        Février 2027 • Mont-Orford, Québec
      </span>
      <h1 class="text-4xl sm:text-7xl font-heading font-black uppercase text-white mb-6 tracking-tight drop-shadow-md">
        Trail des Neiges
      </h1>
      <p class="text-lg sm:text-xl text-slate-200 font-light max-w-2xl mx-auto mb-10 leading-relaxed drop-shadow">
        Une expérience magique et intense à la lueur des lampes frontales sur les sentiers enneigés du Parc national du Mont-Orford.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="#formats" class="px-8 py-4 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-sm uppercase tracking-wider transition-all shadow-xl shadow-brand-red/30">
          Découvrir les Formats
        </a>
        <a href="/contact?type=general&subject=trail-des-neiges" class="px-8 py-4 rounded-xl bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/20 font-heading font-bold text-sm uppercase tracking-wider transition-all">
          Être Notifié de l'Ouverture
        </a>
      </div>
    </div>
  </section>

  <!-- CONTENU PRINCIPAL SUR FOND CLAIR -->
  <div class="bg-slate-50 py-20 space-y-20">
    <div id="formats" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest block mb-2">3 Épreuves au Choix</span>
        <h2 class="text-3xl sm:text-4xl font-heading font-black uppercase text-slate-900">
          Les Formats de Course
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="text-3xl font-heading font-black text-brand-red mb-1">5 KM</div>
            <div class="text-xs uppercase text-slate-500 font-bold mb-4">Découverte Hivernale • +150 m</div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
              Sentiers damés et sécurisés, parfait pour les coureurs débutants sur neige ou les marcheurs rapides désireux de vivre l'ambiance nocturne.
            </p>
          </div>
          <div class="text-xs text-slate-500 border-t border-slate-100 pt-4">
            Ravitaillement chaud à l'arrivée
          </div>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="text-3xl font-heading font-black text-slate-900 mb-1">10 KM</div>
            <div class="text-xs uppercase text-slate-500 font-bold mb-4">Le Défi Classique • +380 m</div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
              Montées soutenues et portions techniques en sous-bois. Un équilibre parfait entre relances rapides et gestion de l'effort dans la poudreuse damée.
            </p>
          </div>
          <div class="text-xs text-slate-500 border-t border-slate-100 pt-4">
            Ravitaillement chaud et médaille de finition
          </div>
        </div>

        <div class="bg-white p-8 rounded-3xl border-2 border-brand-cyan shadow-md flex flex-col justify-between">
          <div>
            <div class="text-3xl font-heading font-black text-brand-cyan mb-1">15 KM</div>
            <div class="text-xs uppercase text-slate-500 font-bold mb-4">Nocturne Expert • +620 m</div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
              Le parcours reine des crêtes du Mont-Orford à la frontale. Sentiers étroits, montées raides et descentes vives exigeant une bonne maîtrise technique.
            </p>
          </div>
          <div class="text-xs text-slate-500 border-t border-slate-100 pt-4 font-semibold text-brand-cyan">
            Lampe frontale 300+ lumens obligatoire
          </div>
        </div>
      </div>

      <!-- SECTION MATÉRIEL OBLIGATOIRE & SÉCURITÉ HIVERNALE (Visuelle & Ancrée dans le Grand Froid) -->
      <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm mb-16">
        
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 mb-10 pb-8 border-b border-slate-100">
          <div class="max-w-2xl">
            <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Sécurité & Grand Froid</span>
            <h3 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 mb-3">
              Équipement Obligatoire & Recommandations Hivernales
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Les conditions hivernales au Mont-Orford peuvent être intenses (neige damée, plaques de glace vive et températures sous -15°C). Un contrôle matériel peut être effectué au départ du 10 km et 15 km nocturne.
            </p>
          </div>

          <!-- Illustration Athlète Hivernal -->
          <div class="w-full lg:w-72 flex-shrink-0 rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-slate-100 group">
            <img 
              src="/assets/TDN-2018-Trail-des-Neiges-Coureuse1.webp" 
              alt="Coureuse équipée pour le froid au Trail des Neiges" 
              class="w-full h-44 object-cover group-hover:scale-105 transition-transform duration-300"
              onerror="this.src='/assets/51581835318_775ae15a4e_k.webp'"
            />
            <div class="p-2.5 bg-slate-900 text-white text-[10px] text-center font-semibold">
              Tenue Grand Froid & Crampons de Glace
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm text-slate-700">
          
          <!-- 1. Éclairage -->
          <div class="p-6 rounded-2xl bg-slate-50/90 border border-slate-200 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-red-100 text-brand-red flex items-center justify-center font-bold">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                </div>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-red-100 text-brand-red border border-red-200">
                  Obligatoire 15k Nocturne
                </span>
              </div>
              <h4 class="font-heading font-bold text-slate-900 text-base mb-3">Éclairage & Visibilité</h4>
              <ul class="space-y-2 text-xs text-slate-600 leading-relaxed">
                <li class="flex items-start gap-2">
                  <span class="text-brand-red font-bold flex-shrink-0">•</span>
                  <span><strong>Lampe frontale puissante</strong> : Puissance minimale de 300 lumens réels.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-red font-bold flex-shrink-0">•</span>
                  <span><strong>Batterie de rechange</strong> : Conservée dans une poche intérieure proche du corps pour contrer le froid.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-red font-bold flex-shrink-0">•</span>
                  <span><strong>Feu rouge arrière</strong> : Recommandé pour la visibilité lors des croisements de parcours.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- 2. Chaussant & Adhérence -->
          <div class="p-6 rounded-2xl bg-slate-50/90 border border-slate-200 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-cyan-100 text-brand-cyan flex items-center justify-center font-bold">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-cyan-100 text-brand-cyan border border-cyan-200">
                  Adhérence sur Glace
                </span>
              </div>
              <h4 class="font-heading font-bold text-slate-900 text-base mb-3">Chaussant & Crampons</h4>
              <ul class="space-y-2 text-xs text-slate-600 leading-relaxed">
                <li class="flex items-start gap-2">
                  <span class="text-brand-cyan font-bold flex-shrink-0">•</span>
                  <span><strong>Micro-crampons de trail</strong> : Chaînes et pointes acier adaptées aux sentiers damés et glacés.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-cyan font-bold flex-shrink-0">•</span>
                  <span><strong>Guêtres basses de neige</strong> : Indispensables pour bloquer les infiltrations d'eau glacée.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-cyan font-bold flex-shrink-0">•</span>
                  <span><strong>Raquettes légères</strong> : Autorisées et recommandées en cas de tempête de neige fraîche.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- 3. Hydratation Isotherme -->
          <div class="p-6 rounded-2xl bg-slate-50/90 border border-slate-200 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                </div>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-700 border border-emerald-200">
                  Anti-Gel Garanti
                </span>
              </div>
              <h4 class="font-heading font-bold text-slate-900 text-base mb-3">Hydratation & Nutrition</h4>
              <ul class="space-y-2 text-xs text-slate-600 leading-relaxed">
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-bold flex-shrink-0">•</span>
                  <span><strong>Réserve d'eau 500 ml minimum</strong> : Bouteille ou flasque isotherme (les tuyaux de dos gèlent en 20 min).</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-bold flex-shrink-0">•</span>
                  <span><strong>Nutrition énergétique chaude</strong> : Ravitaillement avec bouillon chaud et thé sucré à mi-parcours.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-bold flex-shrink-0">•</span>
                  <span><strong>Gels près du corps</strong> : Gardez vos gels dans vos poches de première couche pour éviter qu'ils ne durcissent.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- 4. Textile Technique -->
          <div class="p-6 rounded-2xl bg-slate-50/90 border border-slate-200 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
                </div>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-200">
                  Système Multicouche
                </span>
              </div>
              <h4 class="font-heading font-bold text-slate-900 text-base mb-3">Textile & Sécurité</h4>
              <ul class="space-y-2 text-xs text-slate-600 leading-relaxed">
                <li class="flex items-start gap-2">
                  <span class="text-amber-600 font-bold flex-shrink-0">•</span>
                  <span><strong>Veste coupe-vent technique</strong> : Membrane déperlante et respirante pour les crêtes ventilées.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-amber-600 font-bold flex-shrink-0">•</span>
                  <span><strong>Extrémités protégées</strong> : Tuque thermique, gants chauds et cache-cou obligatoire.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-amber-600 font-bold flex-shrink-0">•</span>
                  <span><strong>Couverture de survie & sifflet</strong> : Dans le sac de course pour toute assistance en zone de montagne.</span>
                </li>
              </ul>
            </div>
          </div>

        </div>
      </div>

      <!-- SECTION GALERIE PHOTOS HIVERNALE (Plein les yeux : Ambiance magique du Mont-Orford) -->
      <div class="mb-16">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest block mb-2">Ambiance Unique</span>
          <h3 class="text-2xl sm:text-4xl font-heading font-black uppercase text-slate-900">
            La Magie du Trail des Neiges en Images
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2">
            Frontales dans la pénombre, poudreuse immaculée et chaleur des feux de camp à l'arrivée.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          <div class="group rounded-2xl overflow-hidden bg-slate-200 shadow-md relative h-72">
            <img 
              src="/assets/TDN-2018-Trail-des-Neiges-D%C3%A9part1.webp" 
              alt="Départ nocturne sous la neige" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='/assets/51581835318_775ae15a4e_k.webp'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-3 text-white text-xs font-bold">Départ nocturne féerique</span>
          </div>

          <div class="group rounded-2xl overflow-hidden bg-slate-200 shadow-md relative h-72">
            <img 
              src="/assets/TDN-2018-Trail-des-Neige-Mont-Orford-Boot-Pack2.webp" 
              alt="Ascension boot pack dans la neige" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='/assets/51581835318_775ae15a4e_k.webp'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-3 text-white text-xs font-bold">Boot-pack sur les sommets</span>
          </div>

          <div class="group rounded-2xl overflow-hidden bg-slate-200 shadow-md relative h-72">
            <img 
              src="/assets/TDN-2018-Trail-des-Neiges-Coureuse1.webp" 
              alt="Coureuse de trail sur neige damée" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='/assets/51581835318_775ae15a4e_k.webp'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-3 text-white text-xs font-bold">Intensité dans les sentiers du parc</span>
          </div>

          <div class="group rounded-2xl overflow-hidden bg-slate-200 shadow-md relative h-72">
            <img 
              src="/assets/TDN-2018-Trail-des-Neiges-Mont-Orford-Arriv%C3%A9e1.webp" 
              alt="Arrivée festive au Mont-Orford" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='/assets/51581835318_775ae15a4e_k.webp'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-3 text-white text-xs font-bold">Arrivée chaleureuse & feu de joie</span>
          </div>
        </div>
      </div>

      <!-- Renseignements pratiques -->
      <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div>
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Informations de Course</span>
          <h3 class="text-2xl font-heading font-bold text-slate-900 mb-4">Logistique & Accueil</h3>
          <ul class="space-y-3 text-xs sm:text-sm text-slate-600 leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-brand-red font-bold">•</span>
              <span><strong>Lieu de rassemblement</strong> : Centre de services Le Cerisier, Parc national du Mont-Orford.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-brand-red font-bold">•</span>
              <span><strong>Remise des dossards</strong> : Enregistrement et trousse du participant le matin de la course au chalet d'accueil.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-brand-red font-bold">•</span>
              <span><strong>Après-course chaleureux</strong> : Soupe réconfortante, breuvages chauds et ambiance conviviale au refuge d'arrivée.</span>
            </li>
          </ul>
        </div>
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 text-center">
          <div class="text-base font-heading font-bold text-slate-900 mb-2">Partenaires officiels du Trail des Neiges</div>
          <p class="text-xs text-slate-500 mb-6">En collaboration avec la Sépaq et les intervenants plein air des Cantons-de-l'Est.</p>
          <a href="/contact/?subject=trail-des-neiges" class="inline-block px-6 py-3 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white text-xs font-heading font-bold uppercase tracking-wider transition-colors shadow-md shadow-brand-red/20">
            Contacter l'organisation
          </a>
        </div>
      </div>

    </div>
  </div>

</Layout>
