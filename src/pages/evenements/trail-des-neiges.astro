---
import Layout from '../../layouts/Layout.astro';

const trailSchema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": "Trail des Neiges Mont-Orford",
  "description": "La classique hivernale de course en sentier enneigé au Mont-Orford : épreuves 5 km, 10 km et 15 km nocturne.",
  "startDate": "2027-02-06",
  "endDate": "2027-02-06",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": {
    "@type": "Place",
    "name": "Parc national du Mont-Orford",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Orford",
      "addressRegion": "QC",
      "addressCountry": "CA"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": "Endurance Aventure",
    "url": "https://enduranceaventure.com"
  }
};
---

<Layout 
  title="Trail des Neiges | Mont-Orford | Endurance Aventure"
  description="La classique hivernale de course en sentier enneigé au Mont-Orford. Épreuves 5 km, 10 km et 15 km nocturne."
  image="/assets/51581835318_775ae15a4e_k.webp"
  jsonLd={trailSchema}
>

  <!-- BANNER HERO SOMBRE (Ambiance hivernale nocturne) -->
  <section class="relative min-h-[55vh] flex items-center justify-center bg-slate-950 overflow-hidden">
    <img 
      src="/assets/51581835318_775ae15a4e_k.webp" 
      alt="Trail des Neiges Mont-Orford" 
      class="absolute inset-0 w-full h-full object-cover opacity-40 brightness-75 contrast-110"
      onerror="this.src='/assets/51581835318_775ae15a4e_k.jpg'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-transparent"></div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center py-20">
      <span class="px-3.5 py-1 rounded bg-brand-cyan text-white text-xs font-bold uppercase tracking-wider mb-4 inline-block shadow">
        Février 2027 • Mont-Orford, Québec
      </span>
      <h1 class="text-4xl sm:text-6xl font-heading font-black uppercase text-white mb-4">
        Trail des Neiges
      </h1>
      <p class="text-lg text-slate-300 font-light max-w-2xl mx-auto mb-8 leading-relaxed">
        Une expérience magique et intense à la lueur des lampes frontales sur les sentiers enneigés du Parc national du Mont-Orford.
      </p>
      <a href="/contact?type=general&subject=trail-des-neiges" class="px-8 py-4 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-sm uppercase tracking-wider transition-all shadow-xl shadow-brand-red/30">
        Être Notifié de l'Ouverture des Dossards
      </a>
    </div>
  </section>

  <!-- CONTENU PRINCIPAL SUR FOND CLAIR -->
  <div class="bg-slate-50 py-20 space-y-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest block mb-2">3 Épreuves au Choix</span>
        <h2 class="text-3xl sm:text-4xl font-heading font-black uppercase text-slate-900">
          Les Formats de Course
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="text-3xl font-heading font-black text-brand-red mb-1">5 KM</div>
            <div class="text-xs uppercase text-slate-500 font-bold mb-4">Découverte Hivernale • +150 m</div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
              Sentiers damés et sécurisés, parfait pour les coureurs débutants sur neige ou les marcheurs rapides désireux de vivre l'ambiance nocturne.
            </p>
          </div>
          <div class="text-xs text-slate-500 border-t border-slate-100 pt-4">
            Ravitaillement chaud à l'arrivée
          </div>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="text-3xl font-heading font-black text-slate-900 mb-1">10 KM</div>
            <div class="text-xs uppercase text-slate-500 font-bold mb-4">Le Défi Classique • +380 m</div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
              Montées soutenues et portions techniques en sous-bois. Un équilibre parfait entre relances rapides et gestion de l'effort dans la poudreuse damée.
            </p>
          </div>
          <div class="text-xs text-slate-500 border-t border-slate-100 pt-4">
            Chronométrage à puce officiel
          </div>
        </div>

        <div class="bg-white p-8 rounded-3xl border-2 border-brand-cyan shadow-md flex flex-col justify-between">
          <div>
            <div class="text-3xl font-heading font-black text-brand-cyan mb-1">15 KM</div>
            <div class="text-xs uppercase text-slate-500 font-bold mb-4">Nocturne Expert • +620 m</div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
              Le parcours reine des crêtes du Mont-Orford à la frontale. Sentiers étroits, montées raides et descentes vives exigeant une bonne maîtrise technique.
            </p>
          </div>
          <div class="text-xs text-slate-500 border-t border-slate-100 pt-4 font-semibold text-brand-cyan">
            Lampe frontale 300+ lumens obligatoire
          </div>
        </div>
      </div>

      <!-- SECTION MATÉRIEL OBLIGATOIRE & SÉCURITÉ HIVERNALE -->
      <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm mb-16">
        <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Sécurité & Grand Froid</span>
        <h3 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900 mb-4">
          Équipement Obligatoire & Recommandations Hivernales
        </h3>
        <p class="text-sm text-slate-600 mb-8 leading-relaxed">
          Les conditions hivernales au Mont-Orford peuvent être intenses (neige damée, plaques de glace vive et températures sous -15°C). Un contrôle matériel peut être effectué au départ du 10 km et 15 km.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm text-slate-700">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="font-bold text-slate-900 flex items-center gap-2">
              <span class="text-brand-red">🔦</span> Éclairage & Visibilité (15 km nocturne)
            </div>
            <div>• Lampe frontale obligatoire (puissance minimale de 300 lumens).</div>
            <div>• Piles ou batterie de rechange conservées dans une poche intérieure au chaud.</div>
            <div>• Feu clignotant rouge à l'arrière recommandé pour la visibilité sur les sections partagées.</div>
          </div>

          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="font-bold text-slate-900 flex items-center gap-2">
              <span class="text-brand-red">👟</span> Chaussant & Adhérence sur Glace
            </div>
            <div>• Crampons d'appoint de trail (micro-spikes à chaînes) ou chaussures à clous carbure.</div>
            <div>• Guêtres basses conseillées pour empêcher la neige d'entrer dans les chaussures.</div>
            <div>• Raquettes autorisées et recommandées en cas de tempête de neige fraîche.</div>
          </div>

          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="font-bold text-slate-900 flex items-center gap-2">
              <span class="text-brand-red">💧</span> Hydratation Isotherme & Nutrition
            </div>
            <div>• Réserve d'eau minimale de 500 ml avec manchon isotherme (le tuyau de poche à eau gèle rapidement).</div>
            <div>• Gels énergétiques ou barres conservés près du corps pour éviter leur durcissement au froid.</div>
          </div>

          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="font-bold text-slate-900 flex items-center gap-2">
              <span class="text-brand-red">🧥</span> Textile & Premiers Secours
            </div>
            <div>• Système multicouche respirant avec veste coupe-vent technique imper-respirante.</div>
            <div>• Tuque ou bandeau thermique, gants chauds et tour de cou obligatoire.</div>
            <div>• Couverture isothermique de survie et sifflet sans bille obligatoires dans votre sac.</div>
          </div>
        </div>
      </div>

      <!-- Renseignements pratiques -->
      <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div>
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Informations de Course</span>
          <h3 class="text-2xl font-heading font-bold text-slate-900 mb-4">Logistique & Accueil</h3>
          <ul class="space-y-3 text-xs sm:text-sm text-slate-600 leading-relaxed">
            <li class="flex items-start gap-2">
              <span class="text-brand-red font-bold">•</span>
              <span><strong>Lieu de rassemblement</strong> : Centre de services Le Cerisier, Parc national du Mont-Orford.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-brand-red font-bold">•</span>
              <span><strong>Chronométrage officiel</strong> : Puce RFID remise avec votre dossard le matin de la course.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-brand-red font-bold">•</span>
              <span><strong>Après-course chaleureux</strong> : Soupe réconfortante, breuvages chauds et ambiance conviviale au refuge d'arrivée.</span>
            </li>
          </ul>
        </div>
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 text-center">
          <div class="text-base font-heading font-bold text-slate-900 mb-2">Partenaires officiels du Trail des Neiges</div>
          <p class="text-xs text-slate-500 mb-6">En collaboration avec la Sépaq et les intervenants plein air des Cantons-de-l'Est.</p>
          <a href="/contact/?subject=trail-des-neiges" class="inline-block px-6 py-3 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white text-xs font-heading font-bold uppercase tracking-wider transition-colors shadow-md shadow-brand-red/20">
            Contacter l'organisation
          </a>
        </div>
      </div>

    </div>
  </div>

</Layout>
