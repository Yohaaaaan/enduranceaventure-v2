---
import Layout from '../../layouts/Layout.astro';

const arwsSchema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": "Championnat du Monde Junior de Raid Aventure ARWS 2027 (ARWS Junior World Championship)",
  "description": "Le Championnat du Monde Junior officiel de raid aventure (ARWS & IARA) accueilli au Témiscamingue : 100 km, 4 jours, canot, VTT, trek, nage, cordes et orientation carte & boussole pour les catégories U18 et U25.",
  "startDate": "2027-07-28",
  "endDate": "2027-07-31",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": {
    "@type": "Place",
    "name": "Témiscamingue (Abitibi-Témiscamingue)",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Témiscamingue",
      "addressRegion": "QC",
      "addressCountry": "CA"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": "Endurance Aventure & Adventure Racing World Series (ARWS)",
    "url": "https://www.arwsjuniorworld.com"
  }
};
---

<Layout 
  title="Championnat du Monde Junior de Raid Aventure ARWS 2027 | Témiscamingue | Endurance Aventure"
  description="Du 29 juillet au 1er août 2027, le Témiscamingue accueille pour la deuxième fois le Championnat du Monde Junior de Raid Aventure officiel ARWS & IARA. 100 km par étapes pour l'élite mondiale U18 & U25."
  image="/assets/arws-junior-world-temiscamingue-2026-1.webp"
  jsonLd={arwsSchema}
>

  <!-- BANNER HERO IMMERSIF (Photo avec jeunes athlètes, logos officiels sur badges immaculés) -->
  <section class="relative min-h-[85vh] sm:min-h-screen flex items-center justify-center bg-slate-950 overflow-hidden">
    <img 
      src="/assets/arws-junior-world-temiscamingue-2026-1.webp" 
      alt="Jeunes athlètes en action - Championnat du Monde Junior ARWS 2027" 
      class="absolute inset-0 w-full h-full object-cover opacity-90 brightness-100 contrast-105" 
      onerror="this.src='/assets/Raid-Temis-reperage4.webp'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-black/15 to-black/25"></div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center py-14 sm:py-20">
      
      <!-- Logo Officiel Unique : Championnat du Monde Raid Aventure Témiscamingue -->
      <div class="inline-flex items-center justify-center bg-white px-5 sm:px-7 py-2.5 sm:py-3.5 rounded-lg shadow-sm border border-slate-200 mb-5">
        <img 
          src="/assets/logo-championnat-monde-raid-temiscamingue.png" 
          alt="Championnat du Monde Raid Aventure Témiscamingue ARWS" 
          class="h-10 sm:h-14 w-auto object-contain"
        />
      </div>

      <div class="block mb-3">
        <span class="px-3 py-1 rounded-sm bg-brand-red text-white text-xs sm:text-sm font-bold uppercase tracking-wider inline-block">
          29 juillet au 1er août 2027 • Témiscamingue, Québec, Canada
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl md:text-5xl font-heading font-black uppercase text-white mb-4 tracking-tight leading-tight">
        Championnat du Monde Junior <br class="hidden sm:inline" />
        <span class="text-brand-red">de Raid Aventure ARWS</span>
      </h1>
      
      <p class="text-sm sm:text-base text-slate-200 font-light max-w-2xl mx-auto mb-8 leading-relaxed">
        Le rendez-vous planétaire officiel de la relève de la course d'aventure : <strong class="text-white font-semibold">100 km par étapes</strong> au cœur des forêts et des immenses lacs boréaux du Témiscamingue. Équipes de 2 dans les catégories <strong class="text-brand-cyan-light font-semibold">U18 et U25</strong>.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-xl mx-auto">
        <a 
          href="https://www.arwsjuniorworld.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 min-h-[44px] rounded-lg bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-xs uppercase tracking-wider transition-all shadow-sm gap-2 text-center"
        >
          <span>Portail Officiel des Mondiaux</span>
          <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
        <a 
          href="#programme" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-3 min-h-[44px] rounded-lg bg-slate-900/90 hover:bg-slate-800 text-white border border-slate-700 font-heading font-bold text-xs uppercase tracking-wider transition-all text-center"
        >
          Découvrir le Programme
        </a>
        <a 
          href="/contact?type=general&subject=championnat-monde-junior-arws" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-3 min-h-[44px] rounded-lg bg-slate-900/70 hover:bg-slate-900 text-slate-200 border border-slate-700 font-heading font-bold text-xs uppercase tracking-wider transition-all text-center"
        >
          Contacter l'Organisation
        </a>
      </div>
    </div>
  </section>

  <!-- BANDEAU DES CHIFFRES CLÉS DE L'ÉPREUVE (Sans le nombre de pays) -->
  <div class="bg-slate-900 border-b border-slate-800 py-6 sm:py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-6 text-center">
        <div class="p-3 bg-white/5 rounded-md lg:bg-transparent">
          <div class="text-2xl sm:text-4xl font-heading font-black text-brand-red">100 KM</div>
          <div class="text-[10px] sm:text-xs uppercase text-slate-400 font-bold tracking-wider mt-1">Expédition Sauvage</div>
        </div>
        <div class="p-3 bg-white/5 rounded-md lg:bg-transparent">
          <div class="text-2xl sm:text-4xl font-heading font-black text-white">4 JOURS</div>
          <div class="text-[10px] sm:text-xs uppercase text-slate-400 font-bold tracking-wider mt-1">Immersion Boréale</div>
        </div>
        <div class="p-3 bg-white/5 rounded-md lg:bg-transparent">
          <div class="text-2xl sm:text-4xl font-heading font-black text-brand-cyan">U18 & U25</div>
          <div class="text-[10px] sm:text-xs uppercase text-slate-400 font-bold tracking-wider mt-1">2 Catégories Officielles</div>
        </div>
        <div class="p-3 bg-white/5 rounded-md lg:bg-transparent">
          <div class="text-2xl sm:text-4xl font-heading font-black text-white">DUO (x2)</div>
          <div class="text-[10px] sm:text-xs uppercase text-slate-400 font-bold tracking-wider mt-1">Mixte, Fille, Garçon</div>
        </div>
        <div class="p-3 bg-white/5 rounded-md lg:bg-transparent col-span-2 md:col-span-1">
          <div class="text-2xl sm:text-4xl font-heading font-black text-brand-red">0 GPS</div>
          <div class="text-[10px] sm:text-xs uppercase text-slate-400 font-bold tracking-wider mt-1">Carte & Boussole Pure</div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION TEASER VIDÉO OFFICIEL (Lecteur immersif en boucle) -->
  <section class="bg-slate-950 py-12 sm:py-16 border-b border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-slate-900 border-l-2 border-brand-red text-slate-200 text-xs font-heading font-bold uppercase tracking-wider mb-4">
        <span>Bande-Annonce Officielle</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-heading font-black uppercase tracking-tight text-white mb-2">
        Teaser Officiel • Championnat du Monde Junior ARWS
      </h2>
      <p class="text-sm text-slate-400 max-w-2xl mx-auto mb-8 font-light">
        Plongez au cœur de l'intensité, des paysages boréaux et du défi d'autonomie totale qui attendent les équipes U18 et U25.
      </p>

      <div class="relative w-full aspect-video rounded-lg overflow-hidden shadow-md border border-slate-800 bg-black">
        <iframe 
          src="https://player.vimeo.com/video/1234973447?autoplay=1&loop=1&autopause=0&muted=1&background=0" 
          title="Teaser Officiel - Championnat du Monde Junior ARWS"
          class="w-full h-full border-0" 
          allow="autoplay; fullscreen; picture-in-picture" 
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- CONTENU PRINCIPAL SUR FOND CLAIR -->
  <div class="bg-slate-50 py-10 sm:py-20 space-y-12 sm:space-y-20">
    
    <!-- PRÉSENTATION OFFICIELLE : LE CHAMPIONNAT DU MONDE JUNIOR ARWS -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-red-100 text-brand-red text-xs font-bold uppercase tracking-wider">
            <span>Événement Historique Mondial</span>
          </div>
          <h2 class="text-3xl sm:text-5xl font-heading font-black uppercase text-slate-900 leading-tight">
            L'Élite Mondiale de la Relève au Cœur de la Boréalie
          </h2>
          <p class="text-base text-slate-700 leading-relaxed">
            Pour la deuxième fois de l'histoire du raid aventure, la série mondiale <strong class="text-slate-900 font-semibold">ARWS (Adventure Racing World Series)</strong> et l'<strong class="text-slate-900 font-semibold">IARA (International Adventure Racing Association)</strong> s'associent à l'expertise d'<strong class="text-slate-900 font-semibold">Endurance Aventure</strong> pour célébrer le Championnat du Monde Junior officiel.
          </p>
          <p class="text-base text-slate-700 leading-relaxed">
            Du <strong class="text-slate-900 font-semibold">29 juillet au 1er août 2027</strong>, les meilleurs jeunes raideurs de la planète convergeront vers le Témiscamingue pour se mesurer sur un parcours de 100 kilomètres en format course par étapes (stage race avec pause nocturne entre les deux journées de compétition), taillé dans les roches anciennes du Bouclier Canadien, les rivières sauvages et les immenses lacs boréaux du territoire témiscamien.
          </p>
        </div>

        <div class="lg:col-span-5">
          <div class="relative rounded-lg overflow-hidden shadow-md border border-slate-200 bg-slate-900 group">
            <img 
              src="/assets/arws-junior-world-temiscamingue-2026-4.webp" 
              alt="Jeunes athlètes en action sur le Raid Aventure Junior ARWS" 
              class="w-full h-80 sm:h-96 object-cover group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='/assets/Raid-Temis-reperage4.webp'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="px-2.5 py-1 rounded-sm bg-brand-cyan text-white text-[11px] font-bold uppercase tracking-wider mb-2 inline-block">
                Territoire Sauvage & Grands Lacs Boréaux
              </span>
              <p class="text-sm font-semibold leading-snug">
                Un terrain de jeu boréal unique au monde, entre forêts denses, falaises escarpées et corridors aquatiques infinis.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- LES DISCIPLINES OFFICIELLES (Avec photos réelles de terrain à la place des icônes) -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Multisport d'Endurance</span>
        <h2 class="text-3xl sm:text-4xl font-heading font-black uppercase text-slate-900">
          Les Disciplines au Programme
        </h2>
        <p class="text-sm text-slate-600 mt-2">
          L'équipe gère son orientation, sa cohésion et sa vitesse de progression à travers 6 épreuves combinées.
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-6">
        
        <!-- Canot & Portage (Avec vraie photo d'action) -->
        <div class="discipline-card bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between hover:border-slate-300 transition-all group">
          <div>
            <div class="aspect-[4/3] sm:h-44 sm:aspect-auto overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/raid-temiscamingue-2025-1.webp" 
                alt="Section canot d'expédition en raid boréal" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded-xs bg-black/80 text-white text-[9px] sm:text-[10px] font-bold uppercase tracking-wider">
                Nautique
              </span>
            </div>
            <div class="p-2.5 sm:p-5">
              <h3 class="font-heading font-bold text-slate-900 text-xs sm:text-lg mb-1 sm:mb-2 line-clamp-1 sm:line-clamp-none">Canot Boréal & Portages</h3>
              <p class="discipline-desc text-[11px] sm:text-xs text-slate-600 leading-relaxed mb-2 sm:mb-3 line-clamp-3 sm:line-clamp-none font-light">
                Navigation en canot biplace sur les immenses lacs boréaux témiscamiens et rivières sinueuses. Portages de canots en sous-bois et rapides.
              </p>
              <button type="button" class="expand-btn sm:hidden text-[10px] font-bold text-brand-red flex items-center gap-1 mb-2">
                <span>Lire la suite</span>
              </button>
            </div>
          </div>
          <div class="p-2.5 pt-0 sm:p-5 sm:pt-0 text-[10px] sm:text-xs font-semibold text-blue-600 border-t border-slate-100 mt-1 line-clamp-1">
            Gilets & matériel homologué
          </div>
        </div>

        <!-- VTT Technique (Avec vraie photo d'action) -->
        <div class="discipline-card bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between hover:border-slate-300 transition-all group">
          <div>
            <div class="aspect-[4/3] sm:h-44 sm:aspect-auto overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/28514399477_3839a9ca93_o-scaled.webp" 
                alt="Transition vélo de montagne et singletrack" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded-xs bg-black/80 text-white text-[9px] sm:text-[10px] font-bold uppercase tracking-wider">
                VTT
              </span>
            </div>
            <div class="p-2.5 sm:p-5">
              <h3 class="font-heading font-bold text-slate-900 text-xs sm:text-lg mb-1 sm:mb-2 line-clamp-1 sm:line-clamp-none">Vélo de Montagne (VTT)</h3>
              <p class="discipline-desc text-[11px] sm:text-xs text-slate-600 leading-relaxed mb-2 sm:mb-3 line-clamp-3 sm:line-clamp-none font-light">
                Pistes forestières, gravelle meuble, singletracks rocheux et montées abruptes du Bouclier Canadien testant la motricité des duos.
              </p>
              <button type="button" class="expand-btn sm:hidden text-[10px] font-bold text-brand-red flex items-center gap-1 mb-2">
                <span>Lire la suite</span>
              </button>
            </div>
          </div>
          <div class="p-2.5 pt-0 sm:p-5 sm:pt-0 text-[10px] sm:text-xs font-semibold text-brand-red border-t border-slate-100 mt-1 line-clamp-1">
            Autonomie mécanique totale
          </div>
        </div>

        <!-- Trek & Bushwhack (Avec vraie photo d'action) -->
        <div class="discipline-card bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between hover:border-slate-300 transition-all group">
          <div>
            <div class="aspect-[4/3] sm:h-44 sm:aspect-auto overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/arws-junior-world-photo1.webp" 
                alt="Progression pédestre hors-piste en forêt boréale" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded-xs bg-black/80 text-white text-[9px] sm:text-[10px] font-bold uppercase tracking-wider">
                Trek
              </span>
            </div>
            <div class="p-2.5 sm:p-5">
              <h3 class="font-heading font-bold text-slate-900 text-xs sm:text-lg mb-1 sm:mb-2 line-clamp-1 sm:line-clamp-none">Trek Boréal & Hors-Piste</h3>
              <p class="discipline-desc text-[11px] sm:text-xs text-slate-600 leading-relaxed mb-2 sm:mb-3 line-clamp-3 sm:line-clamp-none font-light">
                Progression pédestre à travers la taïga. Sections hors-piste intégrales ("bushwhacking"), franchissements de marais et crêtes.
              </p>
              <button type="button" class="expand-btn sm:hidden text-[10px] font-bold text-brand-red flex items-center gap-1 mb-2">
                <span>Lire la suite</span>
              </button>
            </div>
          </div>
          <div class="p-2.5 pt-0 sm:p-5 sm:pt-0 text-[10px] sm:text-xs font-semibold text-emerald-600 border-t border-slate-100 mt-1 line-clamp-1">
            Chaussures tout-terrain
          </div>
        </div>

        <!-- Orientation Carte & Boussole (Avec vraie photo d'action) -->
        <div class="discipline-card bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between hover:border-slate-300 transition-all group">
          <div>
            <div class="aspect-[4/3] sm:h-44 sm:aspect-auto overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/raid-temiscamingue-2025-3.webp" 
                alt="Orientation carte topographique et boussole sur le terrain" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded-xs bg-brand-red text-white text-[9px] sm:text-[10px] font-bold uppercase tracking-wider">
                Règle Absolue
              </span>
            </div>
            <div class="p-2.5 sm:p-5">
              <h3 class="font-heading font-bold text-slate-900 text-xs sm:text-lg mb-1 sm:mb-2 line-clamp-1 sm:line-clamp-none">Orientation & Boussole</h3>
              <p class="discipline-desc text-[11px] sm:text-xs text-slate-600 leading-relaxed mb-2 sm:mb-3 line-clamp-3 sm:line-clamp-none font-light">
                Aucun GPS ni téléphone autorisé. Navigation exclusive aux cartes topographiques officielles fournies et boussoles magnétiques.
              </p>
              <button type="button" class="expand-btn sm:hidden text-[10px] font-bold text-brand-red flex items-center gap-1 mb-2">
                <span>Lire la suite</span>
              </button>
            </div>
          </div>
          <div class="p-2.5 pt-0 sm:p-5 sm:pt-0 text-[10px] sm:text-xs font-bold text-brand-red border-t border-slate-100 mt-1 line-clamp-1">
            0 GPS • Carte & azimut
          </div>
        </div>

        <!-- Nage en Eau Libre (Avec vraie photo d'action) -->
        <div class="discipline-card bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between hover:border-slate-300 transition-all group">
          <div>
            <div class="aspect-[4/3] sm:h-44 sm:aspect-auto overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/arws-junior-world-temiscamingue-2026-3.webp" 
                alt="Section de nage et franchissement aquatique en milieu sauvage" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded-xs bg-black/80 text-white text-[9px] sm:text-[10px] font-bold uppercase tracking-wider">
                Aquatique
              </span>
            </div>
            <div class="p-2.5 sm:p-5">
              <h3 class="font-heading font-bold text-slate-900 text-xs sm:text-lg mb-1 sm:mb-2 line-clamp-1 sm:line-clamp-none">Nage & Franchissements</h3>
              <p class="discipline-desc text-[11px] sm:text-xs text-slate-600 leading-relaxed mb-2 sm:mb-3 line-clamp-3 sm:line-clamp-none font-light">
                Sections de traversée à la nage entre îlots et berges sauvages. Sacs étanches obligatoires pour le matériel de survie.
              </p>
              <button type="button" class="expand-btn sm:hidden text-[10px] font-bold text-brand-red flex items-center gap-1 mb-2">
                <span>Lire la suite</span>
              </button>
            </div>
          </div>
          <div class="p-2.5 pt-0 sm:p-5 sm:pt-0 text-[10px] sm:text-xs font-semibold text-brand-cyan border-t border-slate-100 mt-1 line-clamp-1">
            Sacs étanches certifiés
          </div>
        </div>

        <!-- Ateliers Verticaux de Cordes (Avec vraie photo d'action) -->
        <div class="discipline-card bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between hover:border-slate-300 transition-all group">
          <div>
            <div class="aspect-[4/3] sm:h-44 sm:aspect-auto overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/raid-international-gaspesie-2016-mont-saint-joseph-slack-line.webp" 
                alt="Ateliers verticaux de cordes et rappel sur falaise" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded-xs bg-black/80 text-white text-[9px] sm:text-[10px] font-bold uppercase tracking-wider">
                Cordes
              </span>
            </div>
            <div class="p-2.5 sm:p-5">
              <h3 class="font-heading font-bold text-slate-900 text-xs sm:text-lg mb-1 sm:mb-2 line-clamp-1 sm:line-clamp-none">Ateliers de Cordes</h3>
              <p class="discipline-desc text-[11px] sm:text-xs text-slate-600 leading-relaxed mb-2 sm:mb-3 line-clamp-3 sm:line-clamp-none font-light">
                Rappels en falaise et tyroliennes installés et supervisés par les spécialistes de sécurité verticale d'Endurance Aventure.
              </p>
              <button type="button" class="expand-btn sm:hidden text-[10px] font-bold text-brand-red flex items-center gap-1 mb-2">
                <span>Lire la suite</span>
              </button>
            </div>
          </div>
          <div class="p-2.5 pt-0 sm:p-5 sm:pt-0 text-[10px] sm:text-xs font-semibold text-amber-700 border-t border-slate-100 mt-1 line-clamp-1">
            Harnais & casques certifiés
          </div>
        </div>

      </div>
    </div>

