<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.discipline-card').forEach(card => {
      const btn = card.querySelector('.expand-btn');
      const desc = card.querySelector('.discipline-desc');
      if (btn && desc) {
        btn.addEventListener('click', () => {
          const isExpanded = desc.classList.contains('line-clamp-none');
          if (isExpanded) {
            desc.classList.remove('line-clamp-none');
            desc.classList.add('line-clamp-3');
            btn.querySelector('span').textContent = 'Lire la suite';
          } else {
            desc.classList.remove('line-clamp-3');
            desc.classList.add('line-clamp-none');
            btn.querySelector('span').textContent = 'Réduire';
          }
        });
      }
    });
  });
</script>
