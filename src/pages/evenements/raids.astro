---
import Layout from '../../layouts/Layout.astro';

const raidSchema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": "Raids Aventure Multisports (Gaspésie & Témiscamingue)",
  "description": "Les Raids Internationaux d'Endurance Aventure : kayak de mer, trek, VTT et orientation dans les espaces sauvages du Québec.",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": {
    "@type": "Place",
    "name": "Péninsule Gaspésienne & Témiscamingue",
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "QC",
      "addressCountry": "CA"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": "Endurance Aventure",
    "url": "https://enduranceaventure.com"
  }
};
---

<Layout 
  title="Raids Aventure Multisports | Gaspésie & Témiscamingue | Endurance Aventure"
  description="Les Raids Internationaux d'Endurance Aventure : kayak de mer, trek, VTT et orientation dans les espaces les plus sauvages du Québec."
  image="/assets/51582278409_86672a9a9f_k.webp"
  jsonLd={raidSchema}
>
  <section class="relative min-h-[50vh] flex items-center justify-center bg-brand-darker overflow-hidden">
    <img 
      src="/assets/51582278409_86672a9a9f_k.webp" 
      alt="Raid Aventure Gaspésie" 
      class="absolute inset-0 w-full h-full object-cover opacity-40"
      onerror="this.src='/assets/51582278409_86672a9a9f_k.jpg'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-brand-dark/70 to-transparent"></div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center py-20">
      <span class="px-3 py-1 rounded bg-brand-red text-white text-xs font-bold uppercase tracking-wider mb-4 inline-block">
        Expéditions Multisports
      </span>
      <h1 class="text-4xl sm:text-6xl font-heading font-black uppercase text-white mb-4">
        Raids Aventure
      </h1>
      <p class="text-lg text-slate-300 font-light max-w-2xl mx-auto mb-8">
        L'épreuve par excellence du travail d'équipe, de la stratégie et de la navigation en milieu hostile.
      </p>
      <a href="/contact" class="px-8 py-4 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-sm uppercase tracking-wider transition-all shadow-xl">
        Informations Prochaine Édition
      </a>
    </div>
  </section>

  <section class="py-20 bg-brand-dark">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        
        <div class="bg-brand-darker rounded-2xl border border-brand-gray p-8">
          <h2 class="text-2xl font-heading font-bold text-white mb-2">Raid International Gaspésie</h2>
          <div class="text-xs text-brand-cyan font-bold uppercase tracking-wider mb-4">Péninsule Gaspésienne</div>
          <p class="text-sm text-slate-300 leading-relaxed mb-6">
            Une aventure mythique de 4 jours reliant l'océan aux sommets des Chic-Chocs. Épreuves de kayak de mer, VTT technique, rappel sur falaises et orientation nocturne.
          </p>
          <ul class="space-y-2 text-xs text-slate-400">
            <li>• Équipes mixtes ou non de 2 à 4 coureurs</li>
            <li>• Bivouacs sauvages sur les grèves</li>
            <li>• Diffusion télévisuelle nationale</li>
          </ul>
        </div>

        <div class="bg-brand-darker rounded-2xl border border-brand-gray p-8">
          <h2 class="text-2xl font-heading font-bold text-white mb-2">Raid Témiscamingue</h2>
          <div class="text-xs text-brand-red font-bold uppercase tracking-wider mb-4">Forêt Boréale</div>
          <p class="text-sm text-slate-300 leading-relaxed mb-6">
            L'immersion totale au cœur du réseau hydrographique et forestier de l'Abitibi-Témiscamingue. Un défi de navigation pure en canoë et orientation forestière.
          </p>
          <ul class="space-y-2 text-xs text-slate-400">
            <li>• Traversée de lacs sauvages et portages</li>
            <li>• Épreuve 100% sans assistance mécanique motorisée</li>
            <li>• Esprit de camaraderie et autonomie</li>
          </ul>
        </div>

      </div>
    </div>
  </section>
</Layout>
