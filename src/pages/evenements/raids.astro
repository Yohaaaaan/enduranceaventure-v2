---
import Layout from '../../layouts/Layout.astro';

const raidSchema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": "Raids Aventure Multisports (Gaspésie & Témiscamingue)",
  "description": "Les Raids Internationaux d'Endurance Aventure : kayak de mer, trek, VTT et orientation dans les espaces sauvages du Québec.",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": {
    "@type": "Place",
    "name": "Péninsule Gaspésienne & Témiscamingue",
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "QC",
      "addressCountry": "CA"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": "Endurance Aventure",
    "url": "https://enduranceaventure.com"
  }
};
---

<Layout 
  title="Raids Aventure Multisports | Gaspésie & Témiscamingue | Endurance Aventure"
  description="Les Raids Internationaux d'Endurance Aventure : kayak de mer, trek, VTT et orientation dans les espaces les plus sauvages du Québec."
  image="/assets/51582278409_86672a9a9f_k.webp"
  jsonLd={raidSchema}
>

  <!-- BANNER HERO SOMBRE (Action extrême & Navigation) -->
  <section class="relative min-h-[85vh] sm:min-h-screen flex items-center justify-center bg-slate-950 overflow-hidden">
    <img 
      src="/assets/51582278409_86672a9a9f_k.webp" 
      alt="Raid Aventure Gaspésie" 
      class="absolute inset-0 w-full h-full object-cover opacity-80 brightness-90 contrast-105"
      onerror="this.src='/assets/51582278409_86672a9a9f_k.jpg'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-black/20 to-black/30"></div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center py-24 sm:py-32">
      <span class="px-3.5 py-1.5 rounded-full bg-brand-red text-white text-xs font-bold uppercase tracking-wider mb-4 inline-block shadow">
        Expéditions & Championnats Mondiaux
      </span>
      <h1 class="text-4xl sm:text-7xl font-heading font-black uppercase text-white mb-6 tracking-tight drop-shadow-md">
        Raids Aventure Multisports
      </h1>
      <p class="text-lg sm:text-xl text-slate-200 font-light max-w-2xl mx-auto mb-10 leading-relaxed drop-shadow">
        L'épreuve par excellence du travail d'équipe, de l'orientation à la boussole et de la persévérance en milieu sauvage.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="#raids-details" class="px-8 py-4 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-sm uppercase tracking-wider transition-all shadow-xl shadow-brand-red/30">
          Découvrir les Raids
        </a>
        <a href="/contact?type=general&subject=raids" class="px-8 py-4 rounded-xl bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/20 font-heading font-bold text-sm uppercase tracking-wider transition-all">
          Informations Prochaines Épreuves
        </a>
      </div>
    </div>
  </section>

  <!-- CONTENU PRINCIPAL SUR FOND CLAIR -->
  <div class="bg-slate-50 py-20 space-y-20">
    <div id="raids-details" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        
        <!-- Raid International Gaspésie -->
        <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-10 shadow-sm flex flex-col justify-between hover:shadow-lg transition-all">
          <div>
            <div class="text-xs text-brand-cyan font-bold uppercase tracking-wider mb-2">Péninsule Gaspésienne • 4 Jours</div>
            <h2 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900 mb-4">Raid International Gaspésie</h2>
            <p class="text-sm text-slate-600 leading-relaxed mb-6">
              Une aventure mythique reliant la baie des Chaleurs, les falaises du littoral et les crêtes escarpées des monts Chic-Chocs. Épreuves combinées de kayak de mer, VTT technique, trek de montagne, cordes et rappel.
            </p>
            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 mb-8 border-t border-slate-100 pt-4">
              <li class="flex items-center gap-2"><span class="text-brand-cyan font-bold">✓</span> Équipes de 2 à 4 coureurs (mixtes ou non)</li>
              <li class="flex items-center gap-2"><span class="text-brand-cyan font-bold">✓</span> Bivouacs sur les grèves du Saint-Laurent</li>
              <li class="flex items-center gap-2"><span class="text-brand-cyan font-bold">✓</span> Tournage documentaire pour diffusion télévisuelle</li>
            </ul>
          </div>
          <a href="/contact?type=general&subject=raids" class="w-full py-3.5 rounded-xl bg-brand-cyan hover:bg-cyan-600 text-white font-heading font-bold text-center text-xs uppercase tracking-wider transition-colors shadow-md shadow-brand-cyan/20">
            En savoir plus sur la Gaspésie
          </a>
        </div>

        <!-- Raid Témiscamingue & Championnat ARWS -->
        <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-10 shadow-sm flex flex-col justify-between hover:shadow-lg transition-all">
          <div>
            <div class="text-xs text-brand-red font-bold uppercase tracking-wider mb-2">Forêt Boréale & Circuit Mondial ARWS</div>
            <h2 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900 mb-4">Raid Témiscamingue</h2>
            <p class="text-sm text-slate-600 leading-relaxed mb-6">
              Dessiné sous la direction de <strong class="text-slate-900 font-semibold">Bastien Michau</strong>, le Raid Témiscamingue accueille le circuit officiel de la Série Mondiale (Adventure Racing World Series) et le Championnat du monde junior. Navigation pure en canot, portages forestiers et orientation carte & boussole sans GPS.
            </p>
            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 mb-8 border-t border-slate-100 pt-4">
              <li class="flex items-center gap-2"><span class="text-brand-red font-bold">✓</span> Épreuve officielle ARWS (Coupe du Monde & Juniors)</li>
              <li class="flex items-center gap-2"><span class="text-brand-red font-bold">✓</span> Traversées lacustres sauvages et rapides contrôlés</li>
              <li class="flex items-center gap-2"><span class="text-brand-red font-bold">✓</span> Dépassement, solidarité et immersion totale</li>
            </ul>
          </div>
          <a href="/contact?type=general&subject=raids" class="w-full py-3.5 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-center text-xs uppercase tracking-wider transition-colors shadow-md shadow-brand-red/20">
            En savoir plus sur le Témiscamingue
          </a>
        </div>

      </div>

      <!-- SECTION MATÉRIEL OBLIGATOIRE EN RAID MULTISPORTS (Visuelle & Normes Mondiales ARWS) -->
      <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm space-y-8">
        
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 pb-8 border-b border-slate-100">
          <div class="max-w-2xl">
            <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Sécurité & Autonomie d'Équipe</span>
            <h3 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 mb-3">
              Équipement Obligatoire par Équipe
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Les raids aventure se déroulent en autonomie complète dans des territoires sauvages. Le matériel obligatoire est contrôlé rigoureusement avant le départ et lors de contrôles inopinés aux points de transition.
            </p>
          </div>

          <!-- Illustration Équipe Canot / Navigation -->
          <div class="w-full lg:w-72 flex-shrink-0 rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-slate-100 group">
            <img 
              src="/assets/Raid-International-Gasp%C3%A9sie-2017-RIG-Wladimir-Togumi-Canoe-Rivi%C3%A8re-Nouvelle.webp" 
              alt="Équipe de raid en canot avec gilets VFI et matériel" 
              class="w-full h-44 object-cover group-hover:scale-105 transition-transform duration-300"
              onerror="this.src='/assets/51582278409_86672a9a9f_k.webp'"
            />
            <div class="p-2.5 bg-slate-900 text-white text-[10px] text-center font-semibold">
              Sections Nautiques & Gilets Homologués
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm text-slate-700">
          
          <!-- 1. Orientation -->
          <div class="p-6 rounded-2xl bg-slate-50/90 border border-slate-200 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-cyan-100 text-brand-cyan flex items-center justify-center font-bold">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2a10 10 0 100 20 10 10 0 000-20zm1 4.2V8a1 1 0 11-2 0V6.2A8 8 0 004.2 13H6a1 1 0 110 2H4.2A8 8 0 0011 21.8V20a1 1 0 112 0v1.8a8 8 0 006.8-6.8H18a1 1 0 110-2h1.8A8 8 0 0013 6.2zM14.5 9.5L10 14l1.5-4.5L14.5 9.5z"/></svg>
                </div>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-cyan-100 text-brand-cyan border border-cyan-200">
                  Orientation Pure Sans GPS
                </span>
              </div>
              <h4 class="font-heading font-bold text-slate-900 text-base mb-3">Orientation & Navigation</h4>
              <ul class="space-y-2 text-xs text-slate-600 leading-relaxed">
                <li class="flex items-start gap-2">
                  <span class="text-brand-cyan font-bold flex-shrink-0">•</span>
                  <span><strong>1 boussole de précision par coureur</strong> (à plaquette ou à pouce).</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-cyan font-bold flex-shrink-0">•</span>
                  <span><strong>1 porte-carte étanche grand format</strong> (cartes topographiques 1:20 000 fournies).</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-cyan font-bold flex-shrink-0">•</span>
                  <span><strong>Balise GPS satellite / SOS d'urgence</strong> fournie par l'organisation (allumée en continu).</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-cyan font-bold flex-shrink-0">•</span>
                  <span><strong>Téléphone de secours scellé</strong> : Utilisable uniquement en cas de détresse majeure.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- 2. VTT -->
          <div class="p-6 rounded-2xl bg-slate-50/90 border border-slate-200 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-red-100 text-brand-red flex items-center justify-center font-bold">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-red-100 text-brand-red border border-red-200">
                  Sections VTT Exigeantes
                </span>
              </div>
              <h4 class="font-heading font-bold text-slate-900 text-base mb-3">Vélo Tout-Terrain</h4>
              <ul class="space-y-2 text-xs text-slate-600 leading-relaxed">
                <li class="flex items-start gap-2">
                  <span class="text-brand-red font-bold flex-shrink-0">•</span>
                  <span><strong>VTT révisé et en parfait état</strong> avec pneus tout-terrain crantés.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-red font-bold flex-shrink-0">•</span>
                  <span><strong>Casque rigide CE/CPSC</strong> ajusté et attaché en permanence lors des transitions vélo.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-red font-bold flex-shrink-0">•</span>
                  <span><strong>Éclairage avant 400 lumens minimum</strong> + feu arrière rouge pour les étapes nocturnes.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-red font-bold flex-shrink-0">•</span>
                  <span><strong>Kit atelier d'équipe</strong> : Pompe, dérive-chaîne, chambres, mèches et maillons rapides.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- 3. Nautique -->
          <div class="p-6 rounded-2xl bg-slate-50/90 border border-slate-200 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center font-bold">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
                </div>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-blue-100 text-blue-700 border border-blue-200">
                  Sécurité Nautique
                </span>
              </div>
              <h4 class="font-heading font-bold text-slate-900 text-base mb-3">Équipement Nautique (Canot & Kayak)</h4>
              <ul class="space-y-2 text-xs text-slate-600 leading-relaxed">
                <li class="flex items-start gap-2">
                  <span class="text-blue-500 font-bold flex-shrink-0">•</span>
                  <span><strong>Gilet VFI homologué Transports Canada</strong> porté et serré en permanence sur l'eau.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-blue-500 font-bold flex-shrink-0">•</span>
                  <span><strong>Sifflet sans bille fixé au gilet</strong> de chaque équipier.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-blue-500 font-bold flex-shrink-0">•</span>
                  <span><strong>Sac étanche étanche 20 L</strong> pour les vêtements chauds et la nourriture en rivière.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-blue-500 font-bold flex-shrink-0">•</span>
                  <span><strong>Pagaies de rechange et écope</strong> embarquées dans chaque embarcation.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- 4. Premiers Secours -->
          <div class="p-6 rounded-2xl bg-slate-50/90 border border-slate-200 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-700 border border-emerald-200">
                  Trousse Médicale Obligatoire
                </span>
              </div>
              <h4 class="font-heading font-bold text-slate-900 text-base mb-3">Trousse de Premiers Soins</h4>
              <ul class="space-y-2 text-xs text-slate-600 leading-relaxed">
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-bold flex-shrink-0">•</span>
                  <span><strong>1 couverture thermique par athlète</strong> (minimum 1,40 m x 2,00 m).</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-bold flex-shrink-0">•</span>
                  <span><strong>Bandes de contention élastique</strong> (Tensoplast / Coban) pour entorses articulaires.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-bold flex-shrink-0">•</span>
                  <span><strong>Compresses stériles, antiseptique et pansements ampoules</strong> (Compeed).</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-bold flex-shrink-0">•</span>
                  <span><strong>Couteau avec lame 6 cm et briquet étanche</strong> pour la sécurité en bivouac sauvage.</span>
                </li>
              </ul>
            </div>
          </div>

        </div>
      </div>

      <!-- SECTION GALERIE PHOTOS RAIDS (Plein les yeux : 25 ans d'expéditions extrêmes) -->
      <div>
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Immersion Expédition</span>
          <h3 class="text-2xl sm:text-4xl font-heading font-black uppercase text-slate-900">
            L'Aventure Multisport en Terres Sauvages
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2">
            Descentes d'eaux vives, sentiers côtiers, falaises escarpées et forêts sans fin.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          <div class="group rounded-2xl overflow-hidden bg-slate-200 shadow-md relative h-72">
            <img 
              src="/assets/Raid-International-Gasp%C3%A9sie-2017-RIG-Wladimir-Togumi-Canoe-Rivi%C3%A8re-Nouvelle.webp" 
              alt="Descente en canot sur la rivière Nouvelle" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='/assets/51582278409_86672a9a9f_k.webp'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-3 text-white text-xs font-bold">Rapides en canot • Rivière Nouvelle</span>
          </div>

          <div class="group rounded-2xl overflow-hidden bg-slate-200 shadow-md relative h-72">
            <img 
              src="/assets/raid-international-gaspesie-2016-mont-saint-joseph-slack-line.webp" 
              alt="Slackline vertigineuse au Mont Saint-Joseph" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='/assets/51582278409_86672a9a9f_k.webp'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-3 text-white text-xs font-bold">Slackline & vertige • Baie des Chaleurs</span>
          </div>

          <div class="group rounded-2xl overflow-hidden bg-slate-200 shadow-md relative h-72">
            <img 
              src="/assets/RIG-2018-Prologue-v%C3%A9lo-calvette.webp" 
              alt="Prologue VTT sur le littoral gaspésien" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='/assets/51582278409_86672a9a9f_k.webp'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-3 text-white text-xs font-bold">VTT technique le long du fleuve</span>
          </div>

          <div class="group rounded-2xl overflow-hidden bg-slate-200 shadow-md relative h-72">
            <img 
              src="/assets/Raid-Temis-reperage4.webp" 
              alt="Repérage cartographique au Témiscamingue" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='/assets/51582278409_86672a9a9f_k.webp'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-3 text-white text-xs font-bold">Immersion boréale au Témiscamingue</span>
          </div>
        </div>
      </div>

    </div>
  </div>

</Layout>
