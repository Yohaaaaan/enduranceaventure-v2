---
import Layout from '../../layouts/Layout.astro';

const raidSchema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": "Raids Aventure Multisports (Gaspésie & Témiscamingue)",
  "description": "Les Raids Internationaux d'Endurance Aventure : kayak de mer, trek, VTT et orientation dans les espaces sauvages du Québec.",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": {
    "@type": "Place",
    "name": "Péninsule Gaspésienne & Témiscamingue",
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "QC",
      "addressCountry": "CA"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": "Endurance Aventure",
    "url": "https://enduranceaventure.com"
  }
};
---

<Layout 
  title="Raids Aventure Multisports | Gaspésie & Témiscamingue | Endurance Aventure"
  description="Les Raids Internationaux d'Endurance Aventure : kayak de mer, trek, VTT et orientation dans les espaces les plus sauvages du Québec."
  image="/assets/51582278409_86672a9a9f_k.webp"
  jsonLd={raidSchema}
>

  <!-- BANNER HERO SOMBRE (Action extrême & Navigation) -->
  <section class="relative min-h-[55vh] flex items-center justify-center bg-slate-950 overflow-hidden">
    <img 
      src="/assets/51582278409_86672a9a9f_k.webp" 
      alt="Raid Aventure Gaspésie" 
      class="absolute inset-0 w-full h-full object-cover opacity-40 brightness-75 contrast-110"
      onerror="this.src='/assets/51582278409_86672a9a9f_k.jpg'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-transparent"></div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center py-20">
      <span class="px-3.5 py-1 rounded bg-brand-red text-white text-xs font-bold uppercase tracking-wider mb-4 inline-block shadow">
        Expéditions & Championnats Mondiaux
      </span>
      <h1 class="text-4xl sm:text-6xl font-heading font-black uppercase text-white mb-4">
        Raids Aventure Multisports
      </h1>
      <p class="text-lg text-slate-300 font-light max-w-2xl mx-auto mb-8 leading-relaxed">
        L'épreuve par excellence du travail d'équipe, de l'orientation à la boussole et de la persévérance en milieu sauvage.
      </p>
      <a href="/contact?type=general&subject=raids" class="px-8 py-4 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-sm uppercase tracking-wider transition-all shadow-xl shadow-brand-red/30">
        Informations Prochaines Épreuves
      </a>
    </div>
  </section>

  <!-- CONTENU PRINCIPAL SUR FOND CLAIR -->
  <div class="bg-slate-50 py-20 space-y-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        
        <!-- Raid International Gaspésie -->
        <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-10 shadow-sm flex flex-col justify-between hover:shadow-lg transition-all">
          <div>
            <div class="text-xs text-brand-cyan font-bold uppercase tracking-wider mb-2">Péninsule Gaspésienne • 4 Jours</div>
            <h2 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900 mb-4">Raid International Gaspésie</h2>
            <p class="text-sm text-slate-600 leading-relaxed mb-6">
              Une aventure mythique reliant la baie des Chaleurs, les falaises du littoral et les crêtes escarpées des monts Chic-Chocs. Épreuves combinées de kayak de mer, VTT technique, trek de montagne, cordes et rappel.
            </p>
            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 mb-8 border-t border-slate-100 pt-4">
              <li class="flex items-center gap-2"><span class="text-brand-cyan font-bold">✓</span> Équipes de 2 à 4 coureurs (mixtes ou non)</li>
              <li class="flex items-center gap-2"><span class="text-brand-cyan font-bold">✓</span> Bivouacs sur les grèves du Saint-Laurent</li>
              <li class="flex items-center gap-2"><span class="text-brand-cyan font-bold">✓</span> Tournage documentaire pour diffusion télévisuelle</li>
            </ul>
          </div>
          <a href="/contact?type=general&subject=raids" class="w-full py-3.5 rounded-xl bg-brand-cyan hover:bg-cyan-600 text-white font-heading font-bold text-center text-xs uppercase tracking-wider transition-colors shadow-md shadow-brand-cyan/20">
            En savoir plus sur la Gaspésie
          </a>
        </div>

        <!-- Raid Témiscamingue & Championnat ARWS -->
        <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-10 shadow-sm flex flex-col justify-between hover:shadow-lg transition-all">
          <div>
            <div class="text-xs text-brand-red font-bold uppercase tracking-wider mb-2">Forêt Boréale & Circuit Mondial ARWS</div>
            <h2 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900 mb-4">Raid Témiscamingue</h2>
            <p class="text-sm text-slate-600 leading-relaxed mb-6">
              Dessiné sous la direction de <strong class="text-slate-900 font-semibold">Bastien Michau</strong>, le Raid Témiscamingue accueille le circuit officiel de la Série Mondiale (Adventure Racing World Series) et le Championnat du monde junior. Navigation pure en canot, portages forestiers et orientation carte & boussole sans GPS.
            </p>
            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 mb-8 border-t border-slate-100 pt-4">
              <li class="flex items-center gap-2"><span class="text-brand-red font-bold">✓</span> Épreuve officielle ARWS (Coupe du Monde & Juniors)</li>
              <li class="flex items-center gap-2"><span class="text-brand-red font-bold">✓</span> Traversées lacustres sauvages et rapides contrôlés</li>
              <li class="flex items-center gap-2"><span class="text-brand-red font-bold">✓</span> Dépassement, solidarité et immersion totale</li>
            </ul>
          </div>
          <a href="/contact?type=general&subject=raids" class="w-full py-3.5 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white font-heading font-bold text-center text-xs uppercase tracking-wider transition-colors shadow-md shadow-brand-red/20">
            En savoir plus sur le Témiscamingue
          </a>
        </div>

      </div>

      <!-- SECTION MATÉRIEL OBLIGATOIRE EN RAID MULTISPORTS -->
      <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm space-y-6">
        <div>
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest block mb-2">Sécurité & Autonomie d'Équipe</span>
          <h3 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900 mb-4">
            Équipement Obligatoire par Équipe
          </h3>
          <p class="text-sm text-slate-600 leading-relaxed mb-6">
            Les raids aventure se déroulent en autonomie complète dans des territoires sauvages. Le matériel obligatoire est contrôlé rigoureusement avant le départ et lors de contrôles inopinés en course.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm text-slate-700">
          
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="font-bold text-slate-900 flex items-center gap-2">
              <span class="text-brand-cyan">🧭</span> Orientation & Navigation
            </div>
            <div>• 1 boussole de précision par coureur (boussole à plaquette ou à pouce).</div>
            <div>• 1 porte-carte étanche grand format (cartes topographiques fournies par l'organisation).</div>
            <div>• Balise de géolocalisation GPS/SOS fournie par Endurance Aventure (à conserver allumée).</div>
            <div>• Téléphone d'urgence éteint sous scellé étanche.</div>
          </div>

          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="font-bold text-slate-900 flex items-center gap-2">
              <span class="text-brand-red">🚴</span> Vélo Tout-Terrain (Sections VTT)
            </div>
            <div>• VTT en parfait état de fonctionnement (pneus tout-terrain obligatoires).</div>
            <div>• Casque rigide aux normes CE/CPSC ajusté et attaché en permanence.</div>
            <div>• Éclairage avant puissant (minimum 400 lumens) et feu rouge arrière pour les sections de nuit.</div>
            <div>• Kit de réparation complet par équipe (pompe, mèches/chambres, dérive-chaîne, patte de dérailleur).</div>
          </div>

          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="font-bold text-slate-900 flex items-center gap-2">
              <span class="text-brand-cyan">🛶</span> Équipement Nautique (Canot & Kayak)
            </div>
            <div>• Gilet de flottaison individuel (VFI) homologué Transports Canada porté en permanence sur l'eau.</div>
            <div>• 1 sifflet sans bille attaché à chaque gilet de flottaison.</div>
            <div>• Sac étanche pour protéger les vêtements de rechange et la nourriture lors des rapides.</div>
          </div>

          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="font-bold text-slate-900 flex items-center gap-2">
              <span class="text-brand-red">🩹</span> Trousse de Premiers Soins d'Équipe
            </div>
            <div>• 1 couverture de survie aluminisée par coéquipier (minimum 1,40 m x 2 m).</div>
            <div>• Bandes élastiques de contention (type Tensoplast / Coban) pour entorses.</div>
            <div>• Compresses stériles, pansements hydrocolloïdes pour ampoules et désinfectant.</div>
            <div>• Couteau avec lame d'au moins 6 cm et briquet étanche.</div>
          </div>

        </div>
      </div>

    </div>
  </div>

</Layout>
